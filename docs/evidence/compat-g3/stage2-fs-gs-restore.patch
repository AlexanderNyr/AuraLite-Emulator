diff --git a/boot/bios/stage2/disk.inc b/boot/bios/stage2/disk.inc
index 0211b6d..2b9f5f2 100644
--- a/boot/bios/stage2/disk.inc
+++ b/boot/bios/stage2/disk.inc
@@ -67,12 +67,19 @@ disk_read_lba:
 .ok:
     pop  es
     pop  ds
+    ; INT 13h may return through a 32-bit BIOS thunk that reloads the
+    ; hidden FS/GS caches with 64 KiB real-mode limits.  Restore the
+    ; unreal-mode flat caches before returning to fat_load/elf_load.
+    ; Keep the caller's full register frame live until the flat-cache
+    ; helper returns; popad below restores disk_read_lba's GPR contract.
+    call go_unreal
     popad
     clc
     ret
 .fail:
     pop  es
     pop  ds
+    call go_unreal                      ; restore flat FS/GS on all exits
     popad
     stc
     ret
