index 851114a..61e9a37 100644
--- a/boot/bios/stage2/unreal.inc
+++ b/boot/bios/stage2/unreal.inc
@@ -30,7 +30,7 @@
 ; are masked across the CR0 toggle and the caller's IF is restored.
 go_unreal:
     pushf
