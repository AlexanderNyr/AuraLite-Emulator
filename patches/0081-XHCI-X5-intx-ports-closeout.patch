 static xhci_t g_xhci;
 
+/* X5: the INTx pin.  Asserted while interrupter 0 has an unmasked
+ * pending event (IMAN.IP & IMAN.IE & USBCMD.INTE) -- level-driven, on
+ * change only (the AHCI S5 convention; pic_set_irq fans out to the
+ * I/O APIC board wire). */
+static void xhci_intx_update(xhci_t *x) {
+    int lvl = (x->iman_ip && x->iman_ie && (x->usbcmd & CMD_INTE)) ? 1 : 0;
+    if (lvl != x->intx_level) {
+        x->intx_level = lvl;
+        if (x->m) pic_set_irq(x->m, XHCI_IRQ, lvl);
+    }
+}
+
+static int ev_post(xhci_t *x, uint64_t param, uint32_t status, uint32_t control);
+
+/* X5: the stick sits on root port 1 (the uhci_port_attached rule). */
+static int port_attached(xhci_t *x, int p) {
+    return p == 0 && x->m && x->m->disk_len > 0;
+}
+
 /* ---- host-controller reset: every software-visible register to its
  * power-on value (XHCI_PLAN X1; the guest's init step 2 waits on the
  * HCRST bit self-clearing and on CNR clearing, both immediate here). */
@@ -105,6 +133,7 @@ static void xhci_hw_reset(xhci_t *x) {
     machine_t *m = x->m;
     uint32_t base = x->base;
     int probe = x->bar_probe;
+    if (x->intx_level && m) pic_set_irq(m, XHCI_IRQ, 0);
     memset(x, 0, sizeof *x);
     x->m = m;
     x->base = base;
@@ -138,8 +167,14 @@ static uint32_t op_read(xhci_t *x, uint32_t off) {
     if (off >= OP_PORT_BASE && off < OP_PORT_BASE + XHCI_MAX_PORTS * OP_PORT_STRIDE) {
         int p = (int)((off - OP_PORT_BASE) / OP_PORT_STRIDE);
         uint32_t sub = (off - OP_PORT_BASE) % OP_PORT_STRIDE;
-        if (sub == 0)   /* PORTSC: PPC=0 -> power always on; no devices in X1 */
-            return P_PP | x->port_change[p] | x->port_wake[p];
+        if (sub == 0) {   /* PORTSC: PPC=0 -> power always on */
+            uint32_t v = P_PP | x->port_change[p] | x->port_wake[p];
+            if (port_attached(x, p)) {
+                v |= P_CCS | P_SPEED_HS;        /* USB2 stick, EHCI parity */
+                if (x->port_ped[p]) v |= P_PED;
+            }
+            return v;
+        }
         return 0;       /* PORTPMSC / PORTLI / reserved */
     }
     return 0;
@@ -147,10 +182,25 @@ static uint32_t op_read(xhci_t *x, uint32_t off) {
 
 static void op_write(xhci_t *x, uint32_t off, uint32_t val) {
     switch (off) {
-    case OP_USBCMD:
+    case OP_USBCMD: {
         if (val & CMD_HCRST) { xhci_hw_reset(x); return; }
+        int was_run = (x->usbcmd & CMD_RUN) != 0;
         x->usbcmd = val & (CMD_RUN | CMD_INTE | CMD_HSEE);
+        if (!was_run && (x->usbcmd & CMD_RUN)) {
+            /* X5: silicon reports connected ports once the controller
+             * runs -- CSC + a Port Status Change event per attached
+             * port (the guest's hotplug handler peeks the ring head
+             * for type 34; its boot scan reads CCS directly). */
+            for (int p = 0; p < XHCI_MAX_PORTS; p++) {
+                if (!port_attached(x, p)) continue;
+                x->port_change[p] |= P_CSC;
+                ev_post(x, ((uint64_t)(uint32_t)(p + 1) << 24),
+                        1u << 24, 34u << 10);
+            }
+        }
+        xhci_intx_update(x);
         return;
+    }
     case OP_USBSTS:  return;                    /* HSE/EINT never latch in X1 */
     case OP_DNCTRL:  x->dnctrl = val; return;
     case OP_CRCR:
@@ -177,6 +227,17 @@ static void op_write(xhci_t *x, uint32_t off, uint32_t val) {
         if (sub == 0) {   /* PORTSC: RW1C change bits + wake enables */
             x->port_change[p] &= ~(val & P_CHANGE);
             x->port_wake[p] = val & P_WAKE;
+            /* X5: Port Reset / Warm Reset complete synchronously, like
+             * everything else in this engine: PR never reads back set
+             * (the guest's wait exits at once), the port enables, and
+             * the completion latches + posts its Port Status Change. */
+            if (port_attached(x, p) && (val & (P_PR | P_WPR))) {
+                x->port_ped[p] = 1;
+                x->port_change[p] |= (val & P_PR) ? P_PRC : P_WRC;
+                if (x->usbcmd & CMD_RUN)
+                    ev_post(x, ((uint64_t)(uint32_t)(p + 1) << 24),
+                            1u << 24, 34u << 10);
+            }
         }
         return;
     }
@@ -202,6 +263,7 @@ static void rt_write(xhci_t *x, uint32_t off, uint32_t val) {
     case RT_IMAN:
         if (val & IMAN_IP) x->iman_ip = 0;              /* RW1C */
         x->iman_ie = (val & IMAN_IE) != 0;
+        xhci_intx_update(x);
         return;
     case RT_IMOD:    x->imod = val; return;
     case RT_ERSTSZ:  x->erstsz = val & 0xFFFFu; return;
@@ -216,6 +278,7 @@ static void rt_write(xhci_t *x, uint32_t off, uint32_t val) {
         x->erdp = (x->erdp & 0xFFFFFFFF00000000ull) | (val & ~0xFu);
         if (val & 0x8u) x->iman_ip = 0;                 /* EHB write-1-clear */
         ev_consume_update(x);
+        xhci_intx_update(x);
         return;
     case RT_ERDP + 4:
         x->erdp = (x->erdp & 0xFFFFFFFFull) | ((uint64_t)val << 32);
@@ -297,6 +360,7 @@ static int ev_post(xhci_t *x, uint64_t param, uint32_t status, uint32_t control)
     g_wr32(x, at + 12, control | cycle);
     x->ev_prod++;
     x->iman_ip = 1;
+    xhci_intx_update(x);
     return 0;
 }
 
diff --git a/tests/test_xhci.c b/tests/test_xhci.c
index 1f0f2ea..8967a67 100644
--- a/tests/test_xhci.c
+++ b/tests/test_xhci.c
@@ -773,6 +773,106 @@ static void v_interrupt_idle(void) {
     if (fails == f0) printf("ok interrupt: armed TRB NAKs forever without a source, no fake reports\n");
 }
 
+/* ================= X5: interrupter pin + ports ======================== */
+#define IRQ10_LEVEL ((M.pic.slave.lines >> 2) & 1u)   /* IRQ10 = slave line 2 */
+
+/* ---- v_ports_live: presence, PSC events, RW1C, reset->enabled --------- */
+static void v_ports_live(void) {
+    int f0 = fails;
+    for (int i = 0; i < (int)sizeof img; i++) img[i] = 0x42;
+    M.disk = img; M.disk_len = sizeof img;
+    hc_reset_program(32);
+    uint32_t ev[4];
+    uint32_t ps = rd32(PORT(0));
+    EXPECT(ps & (1u << 0), "port 1 CCS with a disk attached");
+    EXPECT(((ps >> 10) & 0xFu) == 3, "port 1 speed High-Speed (got %u)", (ps >> 10) & 0xFu);
+    EXPECT(!(ps & (1u << 1)), "port 1 not enabled before reset");
+    EXPECT(ps & (1u << 17), "CSC latched as the controller runs");
+    EXPECT(ps & (1u << 9), "PP stays up (PPC=0)");
+    EXPECT(rd32(OP(0x04)) & (1u << 4), "USBSTS.PCD mirrors the latch");
+    EXPECT(IRQ10_LEVEL == 1, "INTx asserted: PSC pending with IE+INTE");
+    EXPECT(!(rd32(PORT(1)) & 1u) && !(rd32(PORT(3)) & 1u), "ports 2 and 4 empty");
+    /* the Port Status Change event heads the ring (the guest peeks it) */
+    next_event(ev);
+    EXPECT(EV_TYPE(ev) == 34, "event type 34 Port Status Change (got %u)", EV_TYPE(ev));
+    EXPECT((ev[0] >> 24) == 1, "PSC names port 1 (got %u)", ev[0] >> 24);
+    EXPECT(EV_CC(ev) == 1, "PSC completion code Success");
+    EXPECT(IRQ10_LEVEL == 0, "consume + EHB ack drops INTx");
+    /* the RW1C clear vector deferred since X1 (nothing could latch) */
+    wr32(PORT(0), (1u << 9) | (1u << 17));
+    EXPECT(!(rd32(PORT(0)) & (1u << 17)), "CSC clears on write-1");
+    EXPECT(!(rd32(OP(0x04)) & (1u << 4)), "PCD clears with the last latch");
+    /* port reset completes synchronously: PR gone, PED + PRC + PSC */
+    ps = rd32(PORT(0));
+    wr32(PORT(0), (ps & (1u << 9)) | (1u << 4));
+    ps = rd32(PORT(0));
+    EXPECT(!(ps & (1u << 4)), "PR reads back clear");
+    EXPECT(ps & (1u << 1), "PED set after reset");
+    EXPECT(ps & (1u << 21), "PRC latched");
+    EXPECT(IRQ10_LEVEL == 1, "INTx re-asserts on the reset PSC");
+    next_event(ev);
+    EXPECT(EV_TYPE(ev) == 34 && (ev[0] >> 24) == 1, "reset posts a second PSC");
+    wr32(PORT(0), (1u << 9) | (1u << 21));
+    EXPECT(!(rd32(PORT(0)) & (1u << 21)), "PRC clears on write-1");
+    /* end to end: enumeration above the enabled port */
+    g_slot = do_address(ev);
+    EXPECT(EV_CC(ev) == 1, "slot addresses on the enabled port");
+    GET_DESC(g_slot, 1, 0, 18, ev);
+    EXPECT(EV_CC(ev) == 1 && rd8(DATABUF + 8) == 0x25, "descriptors answer over the port");
+    M.disk = NULL; M.disk_len = 0;
+    hc_reset_program(32);
+    EXPECT(!(rd32(PORT(0)) & 1u), "medium gone + reset: CCS clears");
+    if (fails == f0) printf("ok ports: CCS/HS/CSC@RUN, RW1C clears, PR->PED+PRC, PSC x2, INTx cycle\n");
+}
+
+/* ---- v_irq_masking: IE / INTE gates and the two ack paths -------------- */
+static void v_irq_masking(void) {
+    int f0 = fails;
+    M.disk = img; M.disk_len = sizeof img;
+    hc_reset_program(32);
+    uint32_t ev[4];
+    EXPECT(IRQ10_LEVEL == 1, "PSC pending after RUN");
+    wr32(RT(0x20), (1u << 1));                    /* IE=1, IP bit 0: no ack */
+    EXPECT(IRQ10_LEVEL == 1, "IMAN write without the IP bit does not ack");
+    wr32(RT(0x20), 0);                            /* IE=0 */
+    EXPECT(IRQ10_LEVEL == 0 && (rd32(RT(0x20)) & 1u),
+           "IE=0 masks the pin while IP stays latched");
+    wr32(RT(0x20), (1u << 1) | 1u);               /* the guest handler's ack */
+    EXPECT(!(rd32(RT(0x20)) & 1u) && IRQ10_LEVEL == 0, "RW1C ack clears IP");
+    next_event(ev);
+    EXPECT(EV_TYPE(ev) == 34, "drained the pending PSC afterwards");
+    wr32(OP(0x00), 1u);                           /* RUN without INTE */
+    ram_wr32(CMDRING + 12, TRB_CMD(23) | 1u);
+    wr32(DB0, 0);
+    EXPECT(rd32(RT(0x20)) & 1u, "No Op completed and latched IP");
+    EXPECT(IRQ10_LEVEL == 0, "INTE=0 keeps the pin down");
+    wr32(OP(0x00), 4u | 1u);
+    EXPECT(IRQ10_LEVEL == 1, "INTE=1 re-asserts for the latched IP");
+    next_event(ev);
+    EXPECT(EV_TYPE(ev) == 33 && IRQ10_LEVEL == 0, "EHB ack settles the pin");
+    M.disk = NULL; M.disk_len = 0;
+    if (fails == f0) printf("ok irq masking: IE+INTE gates, IMAN RW1C and ERDP-EHB acks\n");
+}
