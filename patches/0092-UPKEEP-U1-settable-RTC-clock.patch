+/* U1: entering SET clears UIE (MC146818A datasheet behaviour). */
+static void test_set_clears_uie(void) {
+    fx_t f; fx_init(&f);
+    cmos_w(&f, 0x0B, 0x12);
+    assert(cmos(&f, 0x0B) == 0x12);
+    cmos_w(&f, 0x0B, 0x92);
+    assert(cmos(&f, 0x0B) == 0x82);
+    cmos_w(&f, 0x0B, 0x02);
+    printf("ok: set_clears_uie\n");
+}
