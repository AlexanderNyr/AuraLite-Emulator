+    int64_t  base_sec;      /* U1: Unix seconds the tick count rides on;
+                             * 1767225600 (2026-01-01 UTC) at init, moved
+                             * only by a committed SET-mode date write  */
     uint64_t accum;         /* sub-divisor instruction residue          */
     uint64_t last_instr;
