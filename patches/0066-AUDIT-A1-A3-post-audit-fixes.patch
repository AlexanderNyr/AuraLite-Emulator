@@ -7,6 +7,24 @@ patch has its own immediate parent; entries name measured defects and gates.
 
 ## [Unreleased]
 
+### Fixed — patch 0066 (post-audit A1–A3: debugger clarity, alias warning, TAP port)
+
+- **A1 debugger linear address.**  `$rip` is the raw IP while `$lin` is
+  `cs.base + rip`; in real mode they differ (reset vector: 0xfff0 vs
+  0xfffffff0) and `x/i $rip` read RAM instead of the ROM, showing zeros.
+  `regs` now prints the linear address next to the raw one, `help`
+  documents the pair, and `test_dbg.c` pins the arithmetic and both `x/i`
+  forms.
+- **A2 ROM-alias/RAM overlap warning.**  `mem_init` now documents that the
+  0xE0000-0xFFFFF alias lives INSIDE `m->ram` (flash copy is `m->rom`),
+  the fact that `perf_tlb_plain_table()` depends on, so future RAM-only
+  caches keep excluding the window.
+- **A3 TAP port family overridable.**  The net harnesses hard-bind the
+  ground-rule endpoint (UDP 127.0.0.1:8080/8081/8082); `AURALITE_TAP_PORT`
+  now moves the whole family (n1 gains the D11 port-free pre-flight it
+  lacked).  Defaults unchanged -- every recorded receipt is byte-identical
+  (measured: n1/n2/n3 ALL PASS on 8080 and on a moved port).
+
 ### Added — patch 0065 (COMPAT G6, 4-vCPU BIOS SMP bring-up and guest SMP test suite)
 
 - **Multi-AP BIOS SMP bring-up (`--lpc=ich9 --smp=4`, up to `EM_MAX_VCPU = 8`).**
diff --git a/src/dbg.c b/src/dbg.c
index 5212441..0413855 100644
--- a/src/dbg.c
+++ b/src/dbg.c
@@ -905,6 +905,14 @@ static void cmd_regs(machine_t *m, FILE *o, int v) {
         fprintf(o, "%-3s 0x%016llx%s", gpr64n[i], (unsigned long long)c->gpr[i], (i % 4 == 3) ? "\n" : "  ");
     fprintf(o, "rip 0x%016llx  rflags 0x%016llx ", (unsigned long long)c->rip, (unsigned long long)c->rflags);
     print_flags(o, c->rflags);
+    /* A1: print the LINEAR address next to the raw RIP.  In real mode the
+     * two differ by the CS base (0xFFFF0000 for the reset vector), so
+     * "x/i $rip" reads RAM instead of the ROM at the reset vector and shows
+     * zeros -- measured, and the reason the disassembly looked empty.  The
+     * linear form is what every other address in the debugger means, so
+     * show it right where the user is already looking. */
+    fprintf(o, "\nlin 0x%016llx  (cs.base + rip; $lin in expressions, "
+               "x/i with no address uses it)", (unsigned long long)(c->seg[SEG_CS].base + c->rip));
     fprintf(o, "\ncs %04x ss %04x ds %04x es %04x fs %04x gs %04x  mode %s cpl %d vcpu %d\n",
             c->seg[SEG_CS].sel, c->seg[SEG_SS].sel, c->seg[SEG_DS].sel, c->seg[SEG_ES].sel,
             c->seg[SEG_FS].sel, c->seg[SEG_GS].sel, cpu_mode_name(c), c->seg[SEG_CS].sel & 3, v);
@@ -1114,7 +1122,11 @@ static const char *const help_text =
     "modify:      set $REG = EXPR   poke ADDR VALUE [SIZE]   (RAM only)\n"
     "snapshots:   savevm FILE   loadvm FILE   (one vCPU; taken between instructions)\n"
     "             vcpu N\n"
-    "ADDR/EXPR:   numbers, $reg, symbols (--symbols/--kernel ELF), + - * ( ), *ADDR (8-byte load)\n";
+    "ADDR/EXPR:   numbers, $reg, symbols (--symbols/--kernel ELF), + - * ( ), *ADDR (8-byte load)\n"
+    "             $rip = the raw instruction pointer; $lin = its LINEAR address\n"
+    "             (cs.base + rip).  In real mode they differ (reset vector:\n"
+    "             $rip=0xfff0, $lin=0xfffffff0), so `x/i` with NO address uses\n"
+    "             $lin, while `x/i $rip` reads the raw IP -- use $lin there.\n";
 
 static char *trim(char *s) {
     while (*s == ' ' || *s == '\t') s++;
diff --git a/src/mem.c b/src/mem.c
index 7fd11be..a6771ee 100644
--- a/src/mem.c
+++ b/src/mem.c
@@ -33,8 +33,16 @@ void mem_init(machine_t *m, const uint8_t *rom_image, size_t rom_len) {
     /* The low decode is ROM until PAM enables reads from this RAM-backed
      * shadow. Seed it from the right-aligned flash image so enabling PAM
      * does not expose uninitialized data before SeaBIOS copies its writable
-     * code/data sections. The flash buffer itself remains immutable. */
-    memcpy(m->ram + ROM_ALIAS_LOW_BASE, m->rom, ROM_SIZE);
+     * code/data sections. The flash buffer itself remains immutable.
+     *
+     * WARNING (the one spatial surprise on this machine): the alias window
+     * 0x000E0000..0x00100000 lives INSIDE `m->ram`, not in `m->rom`.  Every
+     * raw RAM read therefore sees the shadow copy -- flash contents until a
+     * guest stores over it -- and a raw RAM write mutates it while `m->rom`
+     * keeps the pristine image (which is exactly what PAM's RAM-write
+     * select wants).  Anything that treats "in-range" as "plain RAM" must
+     * know this: perf_tlb_plain_table() excludes the window for exactly
+     * that reason, and a future RAM-only cache MUST keep doing so. */
     m->mmio_list = NULL;
 }
 
