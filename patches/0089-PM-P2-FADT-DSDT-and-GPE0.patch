+    io_write(&m, B + 0x20, 4, 0x00000001);            /* W1C the bit     */
+    assert(io_read(&m, B + 0x20, 4) == 0);
+    assert((m.pic.slave.lines & 0x02) == 0);          /* SCI released    */
+    puts("ok   pm: GPE0 STS/EN live, W1C clears, GPE joins SCI");
+}
