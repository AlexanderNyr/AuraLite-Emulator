diff --git a/tests/integration/n1_tap_responder.py b/tests/integration/n1_tap_responder.py
new file mode 100755
index 0000000..1eba96c
--- /dev/null
+++ b/tests/integration/n1_tap_responder.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+"""tests/integration/n1_tap_responder.py -- NET N1 host-side TAP endpoint.
+
+The N0 ground rule fixes the transport: TAP datagrams ARE Ethernet frames and
+the endpoint is UDP 127.0.0.1:8080, with the emulator as the connecting side.
+N1 is the first phase where a frame leaves the guest, so something has to be
+bound at that endpoint to prove it -- this is the smallest honest thing that
+can be: it records every datagram, one hex frame per line, and exits after
+`--count` frames or `--timeout` seconds.
+
+It deliberately does NOT answer (N2 is the host-responder phase), and it
+deliberately writes nothing that could leak back into the emulator's own log:
+the frames land in a separate file so the determinism pair in n1_tx_tap.sh
+compares emulator output only.
+
+Usage:
+    n1_tap_responder.py --out frames.hex [--port 8080] [--count 1]
+                        [--timeout 30]
+"""
+import argparse
+import binascii
+import socket
+import sys
+import time
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True, help="hex frame log to write")
+    ap.add_argument("--port", type=int, default=8080)
+    ap.add_argument("--host", default="127.0.0.1")
+    ap.add_argument("--count", type=int, default=1, help="frames to capture")
+    ap.add_argument("--timeout", type=float, default=30.0, help="seconds")
+    a = ap.parse_args()
+
+    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+    s.bind((a.host, a.port))
+    s.settimeout(a.timeout)
+
+    got = 0
+    deadline = time.monotonic() + a.timeout
+    with open(a.out, "w", encoding="ascii") as f:
+        while got < a.count:
+            s.settimeout(max(0.05, deadline - time.monotonic()))
+            try:
+                data, _peer = s.recvfrom(65536)
+            except socket.timeout:
+                break
+            if not data:
+                continue
+            f.write(binascii.hexlify(data).decode("ascii") + "\n")
+            f.flush()
+            got += 1
+    s.close()
+    print("responder: captured %d frame(s) -> %s" % (got, a.out))
+    return 0 if got >= a.count else 2
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/integration/n1_tx_tap.sh b/tests/integration/n1_tx_tap.sh
new file mode 100755
index 0000000..f1e413e
--- /dev/null
+++ b/tests/integration/n1_tx_tap.sh
@@ -0,0 +1,147 @@
+#!/bin/sh
+# tests/integration/n1_tx_tap.sh -- NET N1 wire + guest receipt harness.
+#
+# N1's claim is that a frame the guest submits to the TX ring actually reaches
+# the wire, and that the descriptor is completed inside the doorbell store so
+# the guest's e1000_send() DD spin-wait retires.  Three lanes measure that:
+#
+#   Lane A (wire, always runs): the real firmware-boot transport loads
+#     tests/nic_tx.asm off LBA 0 of a throwaway --disk= image and jumps to it
+#     in long mode; the payload programs the TX ring exactly the way the
+#     frozen guest driver does, rings the TDT doorbell and reports on COM1.
+#     n1_tap_responder.py holds the ground-rule endpoint (UDP 127.0.0.1:8080)
+#     and records what arrived.  Receipts required:
+#       guest   [serial] N1TXOK  status=01 tdh=01 icr=81
+#       wire    ffffffffffff52540012345608004e3154584f4b   (one frame, exact)
+#     status=01 is DD in the status BYTE (descriptor offset 12), tdh=01 is the
+#     head advance, icr=81 is TXDW|TXQE.  Run twice: both .out tapes and both
+#     frame logs must be byte-identical (determinism pair).
+#
+#   Lane B (opt-in, always runs): the same payload WITHOUT --tap=.  The e1000
+#     PCI function does not exist then (ground rule 3), so BAR0 reads hit the
+#     open bus and return all-ones (measured: status=00 tdh=ff icr=ff), and the
+#     payload must report failure.  This is the pin that keeps every historical
+#     no-NIC lane byte-stable.
+#
+#   Lane C (guest receipts, SKIPs without the frozen guest): the N0 lane
+#     re-run.  N1's DoD is that `[e1000] TX timeout` disappears and `[dhcp]`
+#     reaches the wire, with the rest of the tape unchanged modulo those TX
+#     receipts.  Requires the frozen AuraLite-OS kernel/initrd (the recipe is
+#     recorded in docs/plans/NET_PLAN.md N0/N1).
+#
+# Usage:
+#   tests/integration/n1_tx_tap.sh [workdir]
+# Optional env: X86EMU (default ./x86emu), KERNEL, INITRD (lane C),
+#   RESP_TIMEOUT (default 20).
+
+set -eu
+
+ROOT=$(cd "$(dirname "$0")/../.." && pwd)
+X86EMU=${X86EMU:-$ROOT/x86emu}
+WORK=${1:-/tmp/n1-tx-tap}   # fixed default: the tape embeds the --disk= path, so a
+                             # stable workdir is what makes the recorded shas reproducible
+KERNEL=${KERNEL:-/home/user/AuraLite-OS/build/kernel.elf}
+INITRD=${INITRD:-/home/user/AuraLite-OS/build/initrd.tar}
+RESP_TIMEOUT=${RESP_TIMEOUT:-20}
+TAP=127.0.0.1:8080
+FRAME_HEX=ffffffffffff52540012345608004e3154584f4b
+
+mkdir -p "$WORK"
+fail=0
+need()    { grep -q "$1" "$2"    || { echo "  MISSING: $3"; fail=1; }; }
+need_no() { grep -q "$1" "$2" && { echo "  PRESENT: $3"; fail=1; } || :; }
+
+command -v nasm    >/dev/null 2>&1 || { echo "SKIP: nasm missing"; exit 0; }
+command -v python3 >/dev/null 2>&1 || { echo "SKIP: python3 missing"; exit 0; }
+[ -x "$X86EMU" ] || { echo "ERROR: build x86emu first (make x86emu)"; exit 1; }
+
+# ---- the payload and its throwaway disk image -----------------------------
+nasm -f bin "$ROOT/tests/nic_tx.asm" -o "$WORK/nic_tx.bin"
+python3 - "$WORK/nic_tx.bin" "$WORK/disk.img" <<'EOF' || exit 1
+import sys
+p = open(sys.argv[1], 'rb').read()
+assert len(p) <= 512, 'payload must fit the firmware loader single block (%d)' % len(p)
+open(sys.argv[2], 'wb').write(p + b'\0' * (1024 * 1024 - len(p)))
+EOF
+
+# ---- one lane: responder up first (UDP connect() is a no-op, so an unbound
+# ---- endpoint would silently cost us the frame), then the emulator.
+run_tx_lane() { # run_tx_lane <tag> <extra emu args...>
+    tag=$1; shift
+    python3 "$ROOT/tests/integration/n1_tap_responder.py" \
+        --out "$WORK/$tag-frames.hex" --count 1 --timeout "$RESP_TIMEOUT" \
+        > "$WORK/$tag-resp.out" 2>&1 &
+    resp=$!
+    # wait until the endpoint is actually bound
+    i=0
+    while [ $i -lt 100 ]; do
+        if python3 -c "
+import socket,sys
+s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM)
+try:
+    s.bind(('127.0.0.1',8080))
+except OSError:
+    sys.exit(0)
+s.close(); sys.exit(1)" 2>/dev/null; then break; fi
+        i=$((i+1)); sleep 0.05
+    done
+    "$X86EMU" --platform=haswell --disk="$WORK/disk.img" "$@" \
+        --max-instr=600000 > "$WORK/$tag.out" 2>&1
+    wait "$resp" || true
+}
+
+echo "== lane A: TX through the real firmware-boot transport (x2 determinism)"
+run_tx_lane a1 --tap="$TAP"
+run_tx_lane a2 --tap="$TAP"
+for t in a1 a2; do
+    need "N1TXOK  status=01 tdh=01 icr=81" "$WORK/$t.out" \
+        "lane $t: DD + TDH + TXDW/TXQE receipt"
+    need "\[guest\] conventional entry reached at 0x00100000" "$WORK/$t.out" \
+        "lane $t: firmware transport reached the payload"
+    if [ "$(cat "$WORK/$t-frames.hex" 2>/dev/null)" != "$FRAME_HEX" ]; then
+        echo "  WIRE: lane $t frame mismatch:"
+        echo "    want $FRAME_HEX"
+        echo "    got  $(cat "$WORK/$t-frames.hex" 2>/dev/null)"
+        fail=1
+    fi
+done
+cmp -s "$WORK/a1.out" "$WORK/a2.out" \
+    || { echo "  NONDETERMINISTIC: lane A tapes differ"; fail=1; }
+cmp -s "$WORK/a1-frames.hex" "$WORK/a2-frames.hex" \
+    || { echo "  NONDETERMINISTIC: lane A wire frames differ"; fail=1; }
+
+echo "== lane B: no --tap= means no e1000 at all (opt-in ground rule)"
+"$X86EMU" --platform=haswell --disk="$WORK/disk.img" \
+    --max-instr=600000 > "$WORK/b1.out" 2>&1
+need "N1TXFAIL  status=00 tdh=ff icr=ff" "$WORK/b1.out" \
+    "lane B: BAR0 reads open-bus 0xFF without the device"
+need "\[guest\] conventional entry reached at 0x00100000" "$WORK/b1.out" \
+    "lane B: the same transport still boots"
+need_no "\[e1000\]" "$WORK/b1.out" "lane B: no e1000 device lines"
+
+echo "== lane C: frozen-guest receipts (the N0 lane re-run)"
+if [ -r "$KERNEL" ] && [ -r "$INITRD" ]; then
+    python3 "$ROOT/tests/integration/n1_tap_responder.py" \
+        --out "$WORK/c1-frames.hex" --count 1 --timeout "$RESP_TIMEOUT" \
+        > "$WORK/c1-resp.out" 2>&1 &
+    "$X86EMU" --platform=haswell --kernel="$KERNEL" --initrd="$INITRD" \
+        --tap="$TAP" --log="$WORK/c1.log" \
+        --max-instr=4500000000 > "$WORK/c1.out" 2>&1 || true
+    wait || true
+    need "\[net\] using NIC: e1000"                "$WORK/c1.log" "lane C: NIC bound"
+    need "\[dhcp\] starting DHCP discovery"        "$WORK/c1.log" "lane C: DHCP ran"
+    need_no "\[e1000\] TX timeout"                 "$WORK/c1.log" "lane C: D2 receipt gone"
+    [ -s "$WORK/c1-frames.hex" ] \
+        || { echo "  MISSING: lane C put nothing on the wire"; fail=1; }
+else
+    echo "SKIP: frozen guest kernel/initrd missing ($KERNEL / $INITRD)"
+    echo "      reproduce with:"
+    echo "        KERNEL=$KERNEL INITRD=$INITRD $0 $WORK"
+fi
+
+if [ "$fail" -eq 0 ]; then
+    echo "N1 TX wire receipts: ALL PASS"
+else
+    echo "N1 TX wire receipts: FAIL (see $WORK)"
+    exit 1
+fi
diff --git a/tests/nic_tx.asm b/tests/nic_tx.asm
new file mode 100644
index 0000000..f4be2a0
--- /dev/null
+++ b/tests/nic_tx.asm
@@ -0,0 +1,174 @@
+; tests/nic_tx.asm -- NET N1 wire payload: the TX half of the e1000, measured
+; through the real firmware-boot transport (not a unit fixture).
+;
+; The firmware's USB mass-storage loader reads exactly ONE 512-byte block off
+; LBA 0 of --disk= into physical 0x00100000 and jumps there in 64-bit long
+; mode, identity paging, interrupts off (firmware/sample_firmware.nas:689) --
+; the contract disk/test_kernel.asm runs under.  So this payload must stay
+; <= 512 bytes; it is that contract's NIC twin.  It programs the TX ring the
+; way the frozen guest driver does (AuraLite-OS@0ed0d29 drivers/e1000/e1000.c:
+; e1000_init + e1000_send), rings the TDT doorbell and reports on COM1:
+;
+;   N1TXOK status=01 tdh=01 icr=81   <- DD written back inside the doorbell
+;                                        store, TDH advanced, TXDW|TXQE up
+;   N1TXFAIL status=.. tdh=.. icr=.. <- any of those missing; defect D2's
+;                                        receipt was status=00 tdh=00
+;
+; The frame itself leaves through the TAP socket (ground rule: UDP datagrams =
+; Ethernet frames, 127.0.0.1:8080), so "the bytes reached the wire" is proven
+; host-side by tests/integration/n1_tx_tap.sh, not here.  Keeping this output
+; independent of the socket is deliberate: the same binary must print the same
+; thing whether or not a responder is bound, or the determinism pair would
+; depend on host scheduling.
+;
+; Build: nasm -f bin tests/nic_tx.asm -o <out>.bin   (Makefile: test-net-tx)
+[bits 64]
+[org 0x100000]
+
+BAR    equ 0xFEBC0000       ; e1000 82540EM BAR0 (0:4.0, opt-in via --tap=)
+CTRL   equ 0x0000
+ICR    equ 0x00C0
+IMS    equ 0x00D0
+TCTL   equ 0x0400
+TDBAL  equ 0x3800
+TDLEN  equ 0x3808
+TDH    equ 0x3810
+TDT    equ 0x3818
+COM1   equ 0x03F8
+; The firmware's long-mode map is NOT all of RAM: PML4[0] -> PDPT[0] -> PD,
+; and PD[0] = 0x19B is a 2 MiB page (PS in a PDE), so the only conventional
+; RAM a payload may touch is 0x100000..0x1FFFFF -- measured: a write to
+; 0x200000 raises #PF err=0x2 (PD[1] = 0).  MMIO reaches the payload through
+; PDPT[3] (0xC0000000..0xFFFFFFFF, which is how the framebuffer at
+; 0xD0000000 and BAR0 at 0xFEBC0000 work).  So the ring and the DMA buffer
+; live just above this payload's own 512 bytes.
+RING   equ 0x100800         ; 32 legacy TX descriptors (guest NUM_TX_DESC)
+FRAME  equ 0x100C00         ; the frame's DMA buffer (guest tx_buffers[0])
+FLEN   equ 20
+
+%macro MW 2                 ; MMIO write
+    mov r11d, BAR + %1
+    mov eax, %2
+    mov [r11], eax
+%endmacro
+%macro MR 1                 ; MMIO read -> eax
+    mov r11d, BAR + %1
+    mov eax, [r11]
+%endmacro
+
+start:
+    cli
+    ; ---- the frame: broadcast dst, the QEMU-default src 52:54:00:12:34:56,
+    ; ---- ethertype 0x0800, payload "N1TXOK" -- three stores, not twenty
+    ; ---- byte-writes, because the loader only gives us one block.
+    mov rax, 0x5452FFFFFFFFFFFF       ; ff*6 | 52 54
+    mov [FRAME], rax
+    mov rax, 0x314E000856341200       ; 00 12 34 56 | 08 00 | 'N' '1'
+    mov [FRAME+8], rax
+    mov eax, 0x4B4F5854               ; 'T' 'X' 'O' 'K'
+    mov [FRAME+16], eax
+
+    ; ---- descriptor 0, exactly as e1000_send() fills it: addr=FRAME,
+    ; ---- length=20, cso=0, cmd=0x0B (EOP|IFCS|RS), status=0.
+    mov dword [RING+0], FRAME
+    mov dword [RING+4], 0
+    mov dword [RING+8], FLEN | (0x0B << 24)
+    mov dword [RING+12], 0
+
+    ; ---- TX init as e1000_init() does it.  The TCTL write is itself a
+    ; ---- doorbell (QEMU maps [TCTL] and [TDT] to the same op), so the cause
+    ; ---- register is drained afterwards to keep the receipt honest.
+    MW CTRL,  (1 << 0) | (1 << 6)     ; FD | SLU
+    MW IMS,   0xD5                    ; the guest's mask
+    MW TDBAL, RING
+    MW TDLEN, 32 * 16
+    MW TDH,   0
+    MW TDT,   0
+    MW TCTL,  (1 << 1) | (0x10 << 4) | (0x40 << 12)   ; EN | CT | COLD
+    MR ICR                            ; drain the empty init walk's TXQE
+
+    ; ---- the doorbell.  e1000_send() then spins on status&0x01 with a
+    ; ---- bounded PAUSE budget; here the very next read is the check, so a
+    ; ---- DD that lands later than the TDT store is a failure.
+    MW TDT, 1
+    mov r12d, [RING+12]               ; status byte = bits 0..7 of the dword
+    and r12d, 0xFF
+    MR TDH
+    mov r13d, eax
+    MR ICR
+    mov r14d, eax
+
+    ; ---- verdict, then one receipt line
+    mov rsi, .sok
+    cmp r12d, 0x01                    ; DD?
+    jne .fail
+    cmp r13d, 1                       ; TDH advanced?
+    jne .fail
+    test r14d, (1 << 0) | (1 << 7)    ; TXDW and TXQE?
+    jz .fail
+    jmp .say
+.fail:
+    mov rsi, .sbad
+.say:
+    call .str
+    mov rsi, .sst
+    call .str
+    mov r9d, r12d
+    call .hex2
+    mov rsi, .stdh
+    call .str
+    mov r9d, r13d
+    call .hex2
+    mov rsi, .sicr
+    call .str
+    mov r9d, r14d
+    call .hex2
+    mov ecx, 10
+    call .put
+.halt:
+    hlt
+    jmp .halt
+
+.str:                                 ; NUL-terminated string at rsi -> COM1
+    mov al, [rsi]
+    test al, al
+    jz .ret
+    inc rsi
+    mov cl, al                        ; .put takes the character in cl
+    call .put
+    jmp .str
+.hex2:                                ; r9d low byte -> two hex digits
+    mov rcx, r9
+    shr rcx, 4
+    call .nib
+    mov rcx, r9
+.nib:
+    and ecx, 0xF
+    cmp ecx, 10
+    jb .dig
+    add ecx, 39                       ; 'a'-10-'0'
+.dig:
+    add ecx, '0'
+.put:                                 ; cl = character -> COM1, polled THR-empty
+    push rax
+    push rcx
+    mov dx, COM1 + 5
+.spin:
+    in al, dx
+    test al, 0x20
+    jz .spin
+    mov dx, COM1
+    mov al, cl
+    out dx, al
+    pop rcx
+    pop rax
+.ret:
+    ret
+
+.sok:    db 'N1TXOK ', 0
+.sbad:   db 'N1TXFAIL ', 0
+.sst:    db ' status=', 0
+.stdh:   db ' tdh=', 0
+.sicr:   db ' icr=', 0
+
+times 512-($-$$) db 0
diff --git a/tests/test_net.c b/tests/test_net.c
index 9d5ea0c..cf12b8e 100644
--- a/tests/test_net.c
+++ b/tests/test_net.c
@@ -1,4 +1,4 @@
-/* tests/test_net.c -- NET N0 vectors: the e1000 82540EM "RX-ready" model.
+/* tests/test_net.c -- NET N0+N1 vectors: the e1000 82540EM model.
  *
  * Contract measured from AuraLite-OS@0ed0d29 (drivers/e1000/e1000.c,
  * kernel/arch/i386/net32.c) and QEMU's hw/net/e1000.c e1000_reset:
@@ -9,6 +9,19 @@
  *   - RXCSUM reads 0 after reset (QEMU compat);
  *   - RX ring ingress: frame DMA into the head buffer, DD status, RDH
  *     advance, ICR.RXT0; RCTL.EN gates the receiver, RDH==RDT drops.
+ *
+ * N1 adds the TX ring (QEMU start_xmit / process_tx_desc / txdesc_writeback,
+ * guest side e1000_send()):
+ *   - the doorbell is a TDT write AND a TCTL write -- both map to QEMU's
+ *     set_tctl, which stores, masks TDT to 16 bits and calls start_xmit();
+ *   - TCTL.EN gates the walk ("tx disabled" -> return);
+ *   - the walk runs while TDH != TDT, DD is written back inside the doorbell
+ *     store (the guest spins on status&0x01 with a bounded PAUSE budget),
+ *     CMD stays intact (QEMU's txdesc_writeback does not clear it), and
+ *     TDH wraps with "++TDH * 16 >= TDLEN -> TDH = 0";
+ *   - ICR gets TXDW (bit 0) for RS descriptors and TXQE (bit 7) for every
+ *     completed walk;
+ *   - a frame without CMD.EOP accumulates: no wire, no DD, no TXDW.
  */
 #include <assert.h>
 #include <stdint.h>
@@ -98,9 +111,238 @@ static void test_rx_ingress(void) {
     printf("ok e1000 rx ingress (DMA + DD + RDH, EN/full gating)\n");
 }
 
+/* ---- N1 helpers: one legacy TX descriptor, exactly as e1000_send() builds it
+ * (length, cso=0, cmd=0x0B = EOP|IFCS|RS, status=0). ---- */
+static void tx_desc_put(fx_t *f, uint64_t ring, unsigned idx, uint64_t buf,
+                        uint16_t len, uint8_t cmd) {
+    uint64_t d = ring + idx * 16;
+    mem_write(&f->m, d + 0, 4, (uint32_t)buf);          /* addr lo */
+    mem_write(&f->m, d + 4, 4, 0);                      /* addr hi */
+    mem_write(&f->m, d + 8, 4, (uint32_t)len | ((uint32_t)cmd << 24));
+    mem_write(&f->m, d + 12, 4, 0);                     /* status/css/popts */
+}
+static uint8_t tx_desc_status(fx_t *f, uint64_t ring, unsigned idx) {
+    return (uint8_t)mem_read(&f->m, ring + idx * 16 + 12, 1);
+}
+static uint8_t tx_desc_cmd(fx_t *f, uint64_t ring, unsigned idx) {
+    return (uint8_t)mem_read(&f->m, ring + idx * 16 + 11, 1);
+}
+
+/* Program the TX ring the way the guest's e1000_init() does: TDLEN =
+ * NUM_TX_DESC*16, TDH = TDT = 0, TCTL = EN | (0x10<<4) | (0x40<<12).
+ * The wire counters are device state, so a CTRL.RST first gives every
+ * vector its own baseline instead of inheriting the previous one's. */
+static void tx_ring_setup(fx_t *f, uint64_t ring, uint32_t ndesc) {
+    wr(f, 0x0000, (1u << 26));                          /* CTRL.RST */
+    wr(f, 0x3800, (uint32_t)ring);                      /* TDBAL */
+    wr(f, 0x3804, 0);                                   /* TDBAH */
+    wr(f, 0x3808, ndesc * 16);                          /* TDLEN */
+    wr(f, 0x3810, 0);                                   /* TDH */
+    wr(f, 0x3818, 0);                                   /* TDT */
+    wr(f, 0x0400, (1u << 1) | (0x10u << 4) | (0x40u << 12));
+}
+
+static void test_tx_doorbell_completion(void) {
+    fx_t f; fx_init(&f);
+    const uint64_t ring = 0x100000;                     /* 32 descriptors */
+    const uint64_t buf  = 0x200000;
+    tx_ring_setup(&f, ring, 32);
+    assert(rd(&f, 0x3808) == 32 * 16);                  /* TDLEN stored */
+    (void)rd(&f, 0x00C0);                               /* drain setup TXQE */
+
+    /* The guest's frame: broadcast dst, our MAC src, a tagged payload. */
+    static const uint8_t frame[20] = {
+        0xff,0xff,0xff,0xff,0xff,0xff, 0x52,0x54,0x00,0x12,0x34,0x56,
+        0x08,0x00, 'N','1','T','X','O','K'
+    };
+    for (unsigned i = 0; i < sizeof frame; i++)
+        mem_write(&f.m, buf + i, 1, frame[i]);
+    tx_desc_put(&f, ring, 0, buf, sizeof frame, 0x0B);  /* EOP|IFCS|RS */
+    assert(tx_desc_status(&f, ring, 0) == 0);
+
+    /* The doorbell: one TDT store.  DD must be back before it returns --
+     * e1000_send() spins on status&0x01 with a 100000-PAUSE budget and
+     * prints "[e1000] TX timeout" when it never lands (defect D2). */
+    wr(&f, 0x3818, 1);
+    assert(tx_desc_status(&f, ring, 0) == 0x01);        /* DD */
+    assert(tx_desc_cmd(&f, ring, 0) == 0x0B);           /* CMD intact (QEMU) */
+    assert(rd(&f, 0x3810) == 1);                        /* TDH advanced */
+    assert(rd(&f, 0x3818) == 1);                        /* TDT as written */
+
+    /* ICR: TXDW (RS writeback) + TXQE (QEMU raises it on every walk). */
+    uint32_t icr = rd(&f, 0x00C0);
+    assert(icr & (1u << 0));                            /* TXDW  */
+    assert(icr & (1u << 7));                            /* TXQE  */
+    assert(rd(&f, 0x00C0) == 0);                        /* read-to-clear */
+
+    /* Second descriptor in the same ring: the walk is repeatable. */
+    tx_desc_put(&f, ring, 1, buf, sizeof frame, 0x0B);
+    wr(&f, 0x3818, 2);
+    assert(tx_desc_status(&f, ring, 1) == 0x01);
+    assert(rd(&f, 0x3810) == 2);
+
+    /* The socketless lane drops the frames but still completes them (QEMU
+     * with a null backend); the counters are the observable proof. */
+    uint64_t sent = 1, dropped = 0;
+    e1000_tx_stats(&sent, &dropped);
+    assert(sent == 0 && dropped == 2);
+    fx_done(&f);
+    printf("ok e1000 tx doorbell completion (DD + CMD intact + TDH + TXDW/TXQE)\n");
+}
+
+static void test_tx_tctl_gate_and_doorbell(void) {
+    fx_t f; fx_init(&f);
+    const uint64_t ring = 0x100000, buf = 0x200000;
+    tx_ring_setup(&f, ring, 32);
+    tx_desc_put(&f, ring, 0, buf, 14, 0x0B);
+    /* tx_ring_setup's own TCTL write is a doorbell (QEMU maps [TCTL] to
+     * set_tctl): with TDH==TDT the walk is empty but start_xmit still ends
+     * with set_ics(..., TXQE), so drain the cause register before asserting
+     * on the gated one.  Measured: ICR reads 0x80 right after the setup. */
+    assert(rd(&f, 0x00C0) == (1u << 7));                 /* TXQE only */
+    (void)rd(&f, 0x00C0);                                /* read-to-clear */
+
+    /* Transmitter disabled: QEMU start_xmit() returns before the walk, so
+     * the doorbell stores TDT but consumes nothing -- not even TXQE. */
+    wr(&f, 0x0400, 0);                                   /* TCTL without EN */
+    wr(&f, 0x3818, 1);
+    assert(rd(&f, 0x3818) == 1);                        /* TDT stored */
+    assert(rd(&f, 0x3810) == 0);                        /* TDH unmoved */
+    assert(tx_desc_status(&f, ring, 0) == 0);           /* no DD */
+    assert(rd(&f, 0x00C0) == 0);                        /* no cause */
+
+    /* A TCTL write is the second doorbell: QEMU maps [TCTL] and [TDT] to the
+     * same op, so enabling the transmitter drains the pending descriptor. */
+    wr(&f, 0x0400, (1u << 1) | (0x10u << 4) | (0x40u << 12));
+    assert(rd(&f, 0x3810) == 1);                        /* TDH advanced */
+    assert(tx_desc_status(&f, ring, 0) == 0x01);        /* DD */
+    assert(rd(&f, 0x00C0) & (1u << 0));                 /* TXDW */
+
+    /* TDT is masked to 16 bits by that same op (QEMU set_tctl). */
+    wr(&f, 0x3818, 0x00030001u);
+    assert(rd(&f, 0x3818) == 1);
+    fx_done(&f);
+    printf("ok e1000 tx TCTL.EN gate + TCTL-write doorbell + TDT 16-bit mask\n");
+}
+
+static void test_tx_multidescriptor_and_wrap(void) {
+    fx_t f; fx_init(&f);
+    const uint64_t ring = 0x100000;
+    tx_ring_setup(&f, ring, 32);
+    (void)rd(&f, 0x00C0);                               /* drain setup TXQE */
+
+    /* A frame split over two descriptors: the first carries no EOP, so it
+     * only accumulates -- ONE frame reaches the wire, not two.  Both
+     * descriptors still get DD, because QEMU calls txdesc_writeback() for
+     * every descriptor of the walk (EOP or not) and both have CMD.RS. */
+    tx_desc_put(&f, ring, 0, 0x200000, 8, 0x0A);        /* IFCS|RS, no EOP */
+    tx_desc_put(&f, ring, 1, 0x200008, 6, 0x0B);        /* EOP|IFCS|RS     */
+    wr(&f, 0x3818, 2);
+    assert(tx_desc_status(&f, ring, 0) == 0x01);        /* RS -> DD */
+    assert(tx_desc_status(&f, ring, 1) == 0x01);
+    assert(rd(&f, 0x3810) == 2);
+    uint64_t sent = 1, dropped = 0;
+    e1000_tx_stats(&sent, &dropped);
+    assert(sent == 0 && dropped == 1);                  /* ONE frame, not two */
+    (void)rd(&f, 0x00C0);                               /* drain TXDW|TXQE */
+
+    /* No RS: QEMU's txdesc_writeback returns 0 without touching upper.data,
+     * so DD never lands -- the pin that keeps the writeback conditional.
+     * TXQE is still raised (every walk ends with set_ics(..., TXQE)). */
+    tx_desc_put(&f, ring, 2, 0x200000, 14, 0x01);       /* EOP only */
+    wr(&f, 0x3818, 3);
+    assert(tx_desc_status(&f, ring, 2) == 0);           /* no DD without RS */
+    assert(rd(&f, 0x3810) == 3);                        /* consumed anyway */
+    assert(!(rd(&f, 0x00C0) & (1u << 0)));              /* no TXDW */
+
+    /* Ring wrap: TDH 31 -> 0 via "++TDH * 16 >= TDLEN".  The head is parked
+     * with the pending descriptor already in slot 31, so the single TDT
+     * store that opens the slot both transmits it and wraps the head. */
+    tx_desc_put(&f, ring, 31, 0x200000, 14, 0x0B);
+    wr(&f, 0x3810, 31);                                 /* TDH = last slot */
+    assert(rd(&f, 0x3810) == 31);
+    wr(&f, 0x3818, 0);                                  /* TDT = wrap point */
+    assert(tx_desc_status(&f, ring, 31) == 0x01);       /* slot 31 consumed */
+    assert(rd(&f, 0x3810) == 0);                        /* head wrapped */
+    assert(rd(&f, 0x3818) == 0);
+
+    /* TDLEN is a set_dlen register: val & 0xfff80 (128-byte multiples). */
+    wr(&f, 0x3808, 0xFFFFFFFFu);
+    assert(rd(&f, 0x3808) == 0xFFF80u);
+    wr(&f, 0x3808, 32 * 16);
+    fx_done(&f);
+    printf("ok e1000 tx multi-descriptor EOP, RS-gated writeback, TDH wrap, TDLEN mask\n");
+}
