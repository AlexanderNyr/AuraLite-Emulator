++    """Run the guest's `tcp_close` from ESTABLISHED.  -> (ok, reason)."""
++    out = r.handle_many(g_tcp_segment(sport, dport, isn + 1, our_isn + 1,
++                                      R.TCP_FIN | R.TCP_ACK))
++    if len(out) != 1:
++        return False, "FIN got %d replies, wanted one FIN-ACK" % len(out)
