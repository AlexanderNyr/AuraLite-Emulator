+++    REG(E_CTRL) = CTRL_FD | CTRL_SLU;
+++    REG(E_IMS)  = 0xD5;                       /* the guest's mask */
+++
+++    /* TX, exactly as e1000_init's step 6 */
+++    REG(E_TDBAL) = TX_RING_PHYS;
+++    REG(E_TDBAH) = 0;
+++    REG(E_TDLEN) = NUM_TX_DESC * 16;
+++    REG(E_TDH)   = 0;
+++    REG(E_TDT)   = 0;
+++    REG(E_TCTL)  = TCTL_EN | (0x10u << 4) | (0x40u << 12);
