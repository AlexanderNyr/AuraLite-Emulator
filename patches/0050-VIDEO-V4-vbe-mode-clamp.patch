++++         * TDT/TDLEN: the head came back round to where it started, or the
++++         * start was already past the ring.  Without them a TDH==0/TDT==32
++++         * ring with TDLEN==0 would spin forever. */
++++        if (e->regs[E1000_TDH / 4] == tdh_start ||
