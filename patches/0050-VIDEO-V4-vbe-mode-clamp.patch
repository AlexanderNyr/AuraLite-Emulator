++    s.bind(('127.0.0.1',$1))
++except OSError:
++    sys.exit(0)
++s.close(); sys.exit(1)" 2>/dev/null; then return 0; fi
++        i=$((i+1)); sleep 0.05
++    done
++    echo "  ERROR: nothing bound UDP $1"
++    return 1
++}
++
++run_lane() { # run_lane <tag> <tap|none> <responder args...>
++    tag=$1; mode=$2; shift 2
