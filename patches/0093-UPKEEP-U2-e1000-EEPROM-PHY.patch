+static void mdic_write(fx_t *f, unsigned reg, uint16_t data) {
+    wr(f, 0x0020, MDIC_CMD(1, 1, reg, data));            /* OP=write, PHY 1 */
+    uint32_t v = rd(f, 0x0020);
+    assert(v & (1u << 28));
+    assert(!(v & (1u << 30)));
