+    uint32_t r = v & ~EERD_START;
+    unsigned index = r >> 8;                    /* E1000_EEPROM_RW_ADDR_SHIFT */
+    if (index > 0x3Fu)                          /* EEPROM_CHECKSUM_REG */
+        return r | EERD_DONE;
+    return ((uint32_t)e->eeprom[index] << 16) | EERD_DONE | r;
