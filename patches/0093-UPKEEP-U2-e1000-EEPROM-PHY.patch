+    unsigned reg = (val >> 16) & 0x1Fu;         /* MDIC_REG */
+    if (((val >> 21) & 0x1Fu) != 1) {           /* MDIC_PHY: the PHY is #1 */
+        val = e->regs[E1000_MDIC / 4] | MDIC_ERROR;
+    } else if (val & MDIC_OP_READ) {
