+    smfix(jmpe, sizeof jmpe); c = &g_m.cpu;
+    c->rip = 0x1000; (void)cpu_step(c);
+    assert(c->fault && !c->exception_taken);
+    puts("ok cf4 POPCNT 64-bit counts + flags; bare 0F B8 stays #UD");
