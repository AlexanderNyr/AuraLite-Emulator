+static void expect_gp0(cpu_t *c, uint64_t rip) {
+    c->rip = rip; (void)cpu_step(c);
+    assert(c->exception_taken && c->rip == 0x9000 + 13 * 8);
+    assert(r64(c->gpr[RSP]) == 0);
