+static int mk_crimm(uint8_t *b, uint64_t imm, uint8_t modrm) {
+    b[0] = 0x48; b[1] = 0xB8;
+    for (int i = 0; i < 8; i++) b[2 + i] = (uint8_t)(imm >> (8 * i));
+    b[10] = 0x0F; b[11] = 0x22; b[12] = modrm;
+    return 13;
