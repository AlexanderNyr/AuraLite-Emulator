+## 1h. M4 measured receipts (snapshots, determinism) + close-out
+
+- **Snapshots**: no new code was needed and that is worth recording --
+  both state copies already ride whole-struct snapshot tags
+  (`xhci_t` in `dev.xhci`, `ahci_t` in `dev.ahciN`), and the PCI cfg
+  side (Message Control bits) rides the per-function 256-byte
+  `pci.BB.DD.F` records. The M4 vector proves the composition instead
+  of assuming it: programme entry 0 + Enable, save, vandalise
+  (disable, scribble the entry, HCRST), load — cfg enable bit, table
+  contents and *live delivery of the next message* all restored.
+- **Determinism**: a fixed message script (physical, fallback,
+  illegal, logical) replayed against `msi_deliver` yields identical
+  intack streams twice.
+- NC: MSI-X state dropped on snapshot load → 3 failures.
+
+### Close-out
+
+M0–M4 complete (`patches/0082`–`0086`): from zero PCI capabilities to
+a QEMU-parity MSI-X on the xHCI (16 entries, entry 0 in use), a
+shared x86 message-delivery core on the IOAPIC's LAPIC sink, an
+ICH-parity MSI on both AHCIs, per-device edge routing with
+byte-identical INTx fallback, and snapshot/determinism receipts.
+Ledger D1–D3 closed by M1/M2/M3. Stated limits: one MSI-X vector in
+use (one interrupter exists), no PBA accumulation (level-source
+re-evaluation), Lowest Priority degenerates to Fixed (no arbitration
+fabric), SMI/NMI/INIT/ExtINT messages refused, no interrupt
+remapping, e1000 stays INTx-only by silicon parity, and the
+north-star guest still prefers INTx -- which now has a modern
+sibling waiting for whoever asks.
+
 ## 2. Architecture decisions (M0)
 
 - **XHCI gets MSI-X in the QEMU shape**: capability at cfg 0x90 (id 0x11,
diff --git a/tests/test_msi.c b/tests/test_msi.c
index f6ba50d..e402d09 100644
--- a/tests/test_msi.c
+++ b/tests/test_msi.c
@@ -86,6 +86,29 @@ static void v_shape(void) {
     if (fails == f0) printf("ok shape: driver-programmed addr/data land verbatim\n");
 }
 
+/* ---- v_determinism: the same script lands identically twice ---------- */
+static void v_determinism(void) {
+    int f0 = fails;
+    static const struct { uint64_t a; uint32_t d; } script[5] = {
+        { 0xFEE00000ull, 0x60 }, { 0xFEE00000ull, 0x61 },
+        { 0xFEE04000ull, 0x22 },                    /* dest 4: BSP fallback */
+        { 0xFEE00000ull, 0x08 },                    /* illegal vector */
+        { 0xFEE00004ull, 0x63 },                    /* logical, dest 0 */
+    };
+    int got[2][5];
+    for (int r = 0; r < 2; r++) {
+        M.lapic.esr = 0;
+        for (int i = 0; i < 5; i++) {
+            msi_deliver(&M, script[i].a, script[i].d);
+            got[r][i] = take();
+        }
+    }
+    EXPECT(memcmp(got[0], got[1], sizeof got[0]) == 0,
+           "identical message scripts -> identical intack streams");
+    EXPECT(got[0][0] == 0x60 && got[0][3] < 0, "script sanity (illegal vec dropped)");
+    if (fails == f0) printf("ok determinism: message script replayed x2 identically\n");
+}
+
 int main(void) {
     devices_init_common(&M);
     M.lapic.svr |= 0x100u;   /* APIC software-enable, as any OS does first */
@@ -93,6 +116,7 @@ int main(void) {
     v_modes();
     v_logical();
     v_shape();
+    v_determinism();
     if (fails) { printf("test-msi: %d FAILED\n", fails); return 1; }
     printf("test-msi: all vectors passed\n");
     return 0;
diff --git a/tests/test_xhci.c b/tests/test_xhci.c
index bed86ef..2cfab74 100644
--- a/tests/test_xhci.c
+++ b/tests/test_xhci.c
@@ -13,6 +13,7 @@
 #include <string.h>
 #include "devices.h"
 #include "harness.h"
+#include "snapshot.h"     /* MSI M4: save/load round-trip */
 
 static int fails;
 #define EXPECT(cond, ...) do { if (!(cond)) { printf("FAIL " __VA_ARGS__); printf("\n"); fails++; } } while (0)
@@ -976,6 +977,39 @@ static void v_msix_route(void) {
     if (fails == f0) printf("ok msix route: edge-once messages, mask/unmask release, INTx fallback\n");
 }
 
+/* ---- v_msix_snapshot: capability + table + router survive save/load -- */
+/* Runs last on purpose: snap_load rewrites the whole machine image. */
+static void v_msix_snapshot(void) {
+    int f0 = fails;
+    M.lapic.svr |= 0x100u;
+    hc_reset_program(32);
+    uint32_t T = XHCI_BAR + 0x3000u;
+    wr32(T + 0, 0xFEE00000u); wr32(T + 4, 0); wr32(T + 8, 0x71u); wr32(T + 12, 0);
+    pci_wr32(20, 0x90, (0x8000u << 16) | 0x11u);        /* MSI-X Enable */
+    static const snap_cfg_t CFG = { "Haswell", 0, 0 };
+    const char *path = "m4_snap_tmp.bin";
+    EXPECT(snap_save(&M, path, &CFG) == 0, "snapshot saves");
+    /* vandalise everything the snapshot is supposed to preserve */
+    pci_wr32(20, 0x90, 0x11u);
+    wr32(T + 8, 0x22u); wr32(T + 12, 1u);
+    hc_reset_program(32);
+    EXPECT(((pci_rd32(20, 0x90) >> 16) & 0x8000u) == 0, "live state really off");
+    EXPECT(rd32(T + 8) == 0x22u, "table scribble is live");
+    EXPECT(snap_load(&M, path, &CFG) == 0, "snapshot loads");
+    EXPECT(((pci_rd32(20, 0x90) >> 16) & 0x8000u) != 0, "MSI-X Enable back (pci cfg tag)");
+    EXPECT(rd32(T + 8) == 0x71u && rd32(T + 12) == 0, "vector entry back (dev.xhci tag)");
+    /* RAM came from the snapshot too: re-sync the fixture's own counters
+     * to the save-time ones and prove the router is live, not just stored */
+    t_cmd_idx = 0; t_cmd_cycle = 1; t_ev_idx = 0; t_ev_cycle = 1;
+    queue_noop();
+    wr32(DB0, 0);
+    EXPECT(lapic_intack(&M) == 0x71, "message delivered right after load");
+    lapic_eoi();
+    EXPECT(!(M.pic.slave.lines & (1u << 2)), "pin still silent after load");
+    remove(path);
+    if (fails == f0) printf("ok msix snapshot: enable+table+router survive save/load\n");
+}
+
 int main(void) {
     setup_machine(&M);
     devices_init_common(&M);
@@ -1003,6 +1037,7 @@ int main(void) {
     v_determinism();
     v_msix_cap();
     v_msix_route();
+    v_msix_snapshot();
     devices_done(&M);
     if (fails) { printf("test-xhci: %d FAILED\n", fails); return 1; }
     puts("test-xhci: all vectors passed");
