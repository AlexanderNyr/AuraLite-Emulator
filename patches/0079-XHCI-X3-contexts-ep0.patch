+ * the device offers (wLength-bounded).  Returns 0, or -1 for Stall. */
+static int dev_control(xhci_slot_t *sl, const uint8_t su[8], uint8_t *buf,
+                       uint32_t *actual) {
+    uint8_t rt = su[0], req = su[1];
