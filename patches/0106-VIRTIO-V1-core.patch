+int main(void) {
+    setup_machine(&M);
+    devices_init_common(&M);
+    fake_add();
+    v_pci_identity();
+    v_caps();
+    v_bar_probe();
+    v_features();
+    v_queue_regs();
+    v_echo_net_shape();
+    v_echo_blk_shape();
+    v_second_queue();
+    v_no_interrupt();
+    v_malformed();
+    v_reset();
+    v_device_config();
+    v_dma_bounds();
+    devices_done(&M);
+    if (fails) { printf("test-virtio: %d FAILED\n", fails); return 1; }
+    puts("test-virtio: all vectors passed");
+    return 0;
+}
