diff --git a/tests/test_xhci.c b/tests/test_xhci.c
index d2287a7..1f0f2ea 100644
--- a/tests/test_xhci.c
+++ b/tests/test_xhci.c
@@ -604,6 +604,175 @@ static void v_configure_eval(void) {
