+#include "devices.h"        /* X4: usb_stick_serve (shared MSC model) */
 
 /* capability register values (BAR0-relative dword reads) */
 #define X_CAP_LEN        0x40u
@@ -657,6 +658,67 @@ static void ep0_process(xhci_t *x, uint32_t slot) {
