diff --git a/src/xhci.c b/src/xhci.c
new file mode 100644
index 0000000..2a76711
--- /dev/null
+++ b/src/xhci.c
@@ -0,0 +1,335 @@
+// xhci.c -- USB 3.0 host controller (XHCI plan, docs/plans/XHCI_PLAN.md).
+//
+// X1: PCI identity 1b36:000d (QEMU qemu-xhci parity) + the full register
+// file: capability, operational, runtime/interrupter-0, doorbell and
+// root-port registers, the HCRST/CNR handshake and PORTSC RW1C
+// discipline.  Rings and transfers are X2+; doorbells are accepted and
+// ignored here.  Everything the guest driver touches is 32-bit MMIO
+// (AuraLite-OS@main drivers/usb/xhci.c, XHCI_PLAN section 1a); other
+// sizes compose from the containing dword like the AHCI model does.
+#include <stdint.h>
+#include <string.h>
+#include "xhci.h"
+#include "pci.h"
+
+/* capability register values (BAR0-relative dword reads) */
+#define X_CAP_LEN        0x40u
+#define X_HCI_VERSION    0x0100u
+#define X_HCSPARAMS1     ((XHCI_MAX_PORTS << 24) | (1u << 8) | XHCI_MAX_SLOTS)
+#define X_HCCPARAMS1     0x1u          /* AC64; CSZ=0 (32B contexts), PPC=0 */
+#define X_DBOFF          0x1000u
+#define X_RTSOFF         0x0800u
+/* operational register offsets (from BAR0 + X_CAP_LEN) */
+#define OP_USBCMD        0x00
+#define OP_USBSTS        0x04
+#define OP_PAGESIZE      0x08
+#define OP_DNCTRL        0x14
+#define OP_CRCR          0x18
+#define OP_DCBAAP        0x30
+#define OP_CONFIG        0x38
+#define OP_PORT_BASE     0x400
+#define OP_PORT_STRIDE   0x10
+/* USBCMD bits */
+#define CMD_RUN          (1u << 0)
+#define CMD_HCRST        (1u << 1)
+#define CMD_INTE         (1u << 2)
+#define CMD_HSEE         (1u << 3)
+#define CMD_LHCRST       (1u << 7)
+/* USBSTS bits */
+#define STS_HCH          (1u << 0)
+#define STS_PCD          (1u << 4)
+/* CRCR bits */
+#define CRCR_CRR         (1u << 3)
+/* PORTSC bits */
+#define P_PP             (1u << 9)
+#define P_WAKE           ((1u << 25) | (1u << 26) | (1u << 27))
+#define P_CHANGE         ((1u << 17) | (1u << 18) | (1u << 19) | (1u << 20) | \
+                          (1u << 21) | (1u << 22) | (1u << 23))
+/* runtime: interrupter 0 offsets (from BAR0 + X_RTSOFF) */
+#define RT_IMAN          0x20
+#define RT_IMOD          0x24
+#define RT_ERSTSZ        0x28
+#define RT_ERSTBA        0x30
+#define RT_ERDP          0x38
+#define IMAN_IP          (1u << 0)
+#define IMAN_IE          (1u << 1)
+
+typedef struct {
+    machine_t *m;
+    uint32_t base;          /* live BAR0 decode base */
+    int bar_probe;          /* BAR sizing probe in flight */
+    uint32_t usbcmd, config, dnctrl;
+    uint64_t crcr, dcbaap;
+    uint32_t port_change[XHCI_MAX_PORTS];   /* latched RW1C bits */
+    uint32_t port_wake[XHCI_MAX_PORTS];     /* WCE|WDE|WOE */
+    int iman_ie;
+    uint32_t imod, erstsz;
+    uint64_t erstba, erdp;
+    int intx_level;         /* last level driven on XHCI_IRQ */
+} xhci_t;
+
+static xhci_t g_xhci;
+
+/* ---- host-controller reset: every software-visible register to its
+ * power-on value (XHCI_PLAN X1; the guest's init step 2 waits on the
+ * HCRST bit self-clearing and on CNR clearing, both immediate here). */
+static void xhci_hw_reset(xhci_t *x) {
+    machine_t *m = x->m;
+    uint32_t base = x->base;
+    int probe = x->bar_probe;
+    memset(x, 0, sizeof *x);
+    x->m = m;
+    x->base = base;
+    x->bar_probe = probe;
+}
+
+static uint32_t op_read(xhci_t *x, uint32_t off) {
+    switch (off) {
+    case OP_USBCMD:  return x->usbcmd;
+    case OP_USBSTS: {
+        uint32_t v = 0;
+        if (!(x->usbcmd & CMD_RUN)) v |= STS_HCH;
+        for (int p = 0; p < XHCI_MAX_PORTS; p++)
+            if (x->port_change[p]) { v |= STS_PCD; break; }
+        return v;
+    }
+    case OP_PAGESIZE: return 1;                 /* 4 KiB pages */
+    case OP_DNCTRL:   return x->dnctrl;
+    case OP_CRCR: {
+        uint32_t v = (uint32_t)(x->crcr & ~0xFu) | (uint32_t)(x->crcr & 1u);
+        if ((x->usbcmd & CMD_RUN) && (x->crcr & ~0xFull)) v |= CRCR_CRR;
+        return v;
+    }
+    case OP_CRCR + 4:  return (uint32_t)(x->crcr >> 32);
+    case OP_DCBAAP:    return (uint32_t)x->dcbaap;
+    case OP_DCBAAP + 4:return (uint32_t)(x->dcbaap >> 32);
+    case OP_CONFIG:    return x->config;
+    default: break;
+    }
+    if (off >= OP_PORT_BASE && off < OP_PORT_BASE + XHCI_MAX_PORTS * OP_PORT_STRIDE) {
+        int p = (int)((off - OP_PORT_BASE) / OP_PORT_STRIDE);
+        uint32_t sub = (off - OP_PORT_BASE) % OP_PORT_STRIDE;
+        if (sub == 0)   /* PORTSC: PPC=0 -> power always on; no devices in X1 */
+            return P_PP | x->port_change[p] | x->port_wake[p];
+        return 0;       /* PORTPMSC / PORTLI / reserved */
+    }
+    return 0;
+}
+
+static void op_write(xhci_t *x, uint32_t off, uint32_t val) {
+    switch (off) {
+    case OP_USBCMD:
+        if (val & CMD_HCRST) { xhci_hw_reset(x); return; }
+        x->usbcmd = val & (CMD_RUN | CMD_INTE | CMD_HSEE);
+        return;
+    case OP_USBSTS:  return;                    /* HSE/EINT never latch in X1 */
+    case OP_DNCTRL:  x->dnctrl = val; return;
+    case OP_CRCR:
+        x->crcr = (x->crcr & 0xFFFFFFFF00000000ull) | (val & ~0x6u);
+        return;
+    case OP_CRCR + 4:
+        x->crcr = (x->crcr & 0xFFFFFFFFull) | ((uint64_t)val << 32);
+        return;
+    case OP_DCBAAP:
+        x->dcbaap = (x->dcbaap & 0xFFFFFFFF00000000ull) | (val & ~0x3Fu);
+        return;
+    case OP_DCBAAP + 4:
+        x->dcbaap = (x->dcbaap & 0xFFFFFFFFull) | ((uint64_t)val << 32);
+        return;
+    case OP_CONFIG:  x->config = val; return;
+    default: break;
+    }
+    if (off >= OP_PORT_BASE && off < OP_PORT_BASE + XHCI_MAX_PORTS * OP_PORT_STRIDE) {
+        int p = (int)((off - OP_PORT_BASE) / OP_PORT_STRIDE);
+        uint32_t sub = (off - OP_PORT_BASE) % OP_PORT_STRIDE;
+        if (sub == 0) {   /* PORTSC: RW1C change bits + wake enables */
+            x->port_change[p] &= ~(val & P_CHANGE);
+            x->port_wake[p] = val & P_WAKE;
+        }
+        return;
+    }
+}
+
+static uint32_t rt_read(xhci_t *x, uint32_t off) {
+    switch (off) {
+    case RT_IMAN:    return x->iman_ie ? IMAN_IE : 0;   /* IP: X5 */
+    case RT_IMOD:    return x->imod;
+    case RT_ERSTSZ:  return x->erstsz;
+    case RT_ERSTBA:  return (uint32_t)x->erstba;
+    case RT_ERSTBA + 4: return (uint32_t)(x->erstba >> 32);
+    case RT_ERDP:    return (uint32_t)x->erdp;
+    case RT_ERDP + 4:   return (uint32_t)(x->erdp >> 32);
+    default:         return 0;   /* MFINDEX + interrupters 1.. (MaxIntrs=1) */
+    }
+}
+
+static void rt_write(xhci_t *x, uint32_t off, uint32_t val) {
+    switch (off) {
+    case RT_IMAN:    x->iman_ie = (val & IMAN_IE) != 0; return;
+    case RT_IMOD:    x->imod = val; return;
+    case RT_ERSTSZ:  x->erstsz = val & 0xFFFFu; return;
+    case RT_ERSTBA:
+        x->erstba = (x->erstba & 0xFFFFFFFF00000000ull) | (val & ~0x3Fu);
+        return;
+    case RT_ERSTBA + 4:
+        x->erstba = (x->erstba & 0xFFFFFFFFull) | ((uint64_t)val << 32);
+        return;
+    case RT_ERDP:
+        x->erdp = (x->erdp & 0xFFFFFFFF00000000ull) | val;
+        return;
+    case RT_ERDP + 4:
+        x->erdp = (x->erdp & 0xFFFFFFFFull) | ((uint64_t)val << 32);
+        return;
+    default: return;
+    }
+}
+
+static uint32_t xhci_read32(xhci_t *x, uint32_t off) {
+    if (off < X_CAP_LEN) {
+        switch (off) {
+        case 0x00: return (X_HCI_VERSION << 16) | X_CAP_LEN;
+        case 0x04: return X_HCSPARAMS1;
+        case 0x10: return X_HCCPARAMS1;
+        case 0x14: return X_DBOFF;
+        case 0x18: return X_RTSOFF;
+        default:   return 0;   /* HCSPARAMS2/3, HCCPARAMS2 */
+        }
+    }
+    if (off >= X_RTSOFF && off < X_DBOFF) return rt_read(x, off - X_RTSOFF);
+    if (off >= X_DBOFF) return 0;               /* doorbells read 0 */
+    return op_read(x, off - X_CAP_LEN);
+}
+
+static void xhci_write32(xhci_t *x, uint32_t off, uint32_t val) {
+    if (off < X_CAP_LEN) return;                /* capability space is RO */
+    if (off >= X_RTSOFF && off < X_DBOFF) { rt_write(x, off - X_RTSOFF, val); return; }
+    if (off >= X_DBOFF) return;                 /* doorbells: X2 rings the engine */
+    op_write(x, off - X_CAP_LEN, val);
+}
+
+static uint64_t xhci_mmio_read(void *ctx, uint64_t addr, int size) {
+    xhci_t *x = ctx;
+    uint32_t off = (uint32_t)(addr - x->base);
+    if (size == 8) {
+        return (uint64_t)xhci_read32(x, off & ~3u) |
+               ((uint64_t)xhci_read32(x, (off & ~3u) + 4) << 32);
+    }
+    if (size != 4) {   /* guest is 32-bit only; compose like AHCI */
+        uint32_t dw = xhci_read32(x, off & ~3u);
+        uint32_t in = off & 3u;
+        if ((uint32_t)size + in <= 4)
+            return (dw >> (8 * in)) & ((size >= 4) ? 0xFFFFFFFFu : ((1u << (8 * size)) - 1u));
+        return 0;
+    }
+    return xhci_read32(x, off);
+}
+
+static void xhci_mmio_write(void *ctx, uint64_t addr, int size, uint64_t val) {
+    xhci_t *x = ctx;
+    uint32_t off = (uint32_t)(addr - x->base);
+    if (size == 8) {
+        xhci_write32(x, off & ~3u, (uint32_t)val);
+        xhci_write32(x, (off & ~3u) + 4, (uint32_t)(val >> 32));
+        return;
+    }
+    if (size != 4) {
+        uint32_t old = xhci_read32(x, off & ~3u);
+        uint32_t in = off & 3u, mask = 0;
+        for (int i = 0; i < size; i++) mask |= 0xFFu << (8 * (in + i));
+        val = (old & ~mask) | ((val << (8 * in)) & mask);
+        off &= ~3u;
+    }
+    xhci_write32(x, off, (uint32_t)val);
+}
+
+/* ---- BAR0 (64-bit, 64 KiB) probe + relocation, the AHCI BAR5 pattern -- */
+static void xhci_set_base(xhci_t *x, uint64_t base) {
+    int enabled = base != 0 && (base >> 32) == 0;
+    x->base = enabled ? (uint32_t)base : 0;
+    if (!x->m) return;
+    for (mmio_region_t *r = x->m->mmio_list; r; r = r->next) {
+        if (r->ctx == x && r->size == XHCI_MMIO_SIZE) {
+            r->base = x->base;
+            r->enabled = enabled;
+            return;
+        }
+    }
+}
+
+static xhci_t *xhci_pci_controller(pci_dev_t *d) {
+    if (!d || d->bus != 0 || d->dev != 20 || d->func != 0) return NULL;
+    return &g_xhci;
+}
+
+static uint64_t xhci_bar_value(xhci_t *x, pci_dev_t *d) {
+    if (x->bar_probe) return 0xFFFF0004ull;    /* mask | 64-bit type, hi=0 */
+    uint64_t v = 0;
+    for (int i = 0; i < 8; i++) v |= (uint64_t)d->cfg[0x10 + i] << (8 * i);
+    return v;
+}
+
+uint64_t xhci_pci_cfg_read(struct pci_dev *dev, int reg, int size) {
+    pci_dev_t *d = dev;
+    xhci_t *x = xhci_pci_controller(d);
+    if (!x || size <= 0 || size > 8) return 0;
+    uint64_t bar = xhci_bar_value(x, d);
+    uint64_t value = 0;
+    for (int i = 0; i < size; i++) {
+        int off = reg + i;
+        uint8_t byte = 0;
+        if (off >= 0x10 && off < 0x18)
+            byte = (uint8_t)(bar >> (8 * (off - 0x10)));
+        else if (!((off >= 0x18 && off < 0x28) || (off >= 0x30 && off < 0x34))
+                 && off >= 0 && off < 256)
+            byte = d->cfg[off];
+        value |= (uint64_t)byte << (8 * i);
+    }
+    return value;
+}
+
+void xhci_pci_cfg_write(struct pci_dev *dev, int reg, int size, uint64_t val) {
+    pci_dev_t *d = dev;
+    xhci_t *x = xhci_pci_controller(d);
+    if (!x || size <= 0 || size > 8) return;
+    if ((reg == 0x10 || reg == 0x14) && size == 4 && (uint32_t)val == 0xFFFFFFFFu) {
+        x->bar_probe = 1;
+        return;
+    }
+    int touches_bar = reg < 0x18 && reg + size > 0x10;
+    if (touches_bar) x->bar_probe = 0;
+    pci_default_cfg_write(d, reg, size, val);
+    /* BAR2..5 and the expansion-ROM BAR are not implemented. */
+    memset(d->cfg + 0x18, 0, 0x10);
+    memset(d->cfg + 0x30, 0, 4);
+    if (touches_bar) {
+        uint64_t req = 0;
+        for (int i = 0; i < 8; i++) req |= (uint64_t)d->cfg[0x10 + i] << (8 * i);
+        uint64_t base = req & ~(uint64_t)(XHCI_MMIO_SIZE - 1u) & ~0xFull;
+        uint64_t stored = base | 0x4u;         /* 64-bit memory BAR */
+        for (int i = 0; i < 8; i++) d->cfg[0x10 + i] = (uint8_t)(stored >> (8 * i));
+        xhci_set_base(x, base);
+    }
+}
+
+void xhci_register(machine_t *m) {
+    xhci_t *x = &g_xhci;
+    memset(x, 0, sizeof *x);
+    x->m = m;
+    x->base = XHCI_MMIO_BASE;
+    mem_register_mmio(m, x->base, XHCI_MMIO_SIZE, xhci_mmio_read,
+                      xhci_mmio_write, x, "XHCI BAR0");
+    mlog(&m->log, "[xhci] BAR0 registered at 0x%x (%d ports, X1: register file)\n",
+         x->base, XHCI_MAX_PORTS);
+}
+
+void xhci_snap(machine_t *m, snap_t *s) {
+    (void)m;
+    xhci_t t = g_xhci;
+    if (!snap_loading(s)) t.m = NULL;
+    snap_bytes(s, "dev.xhci", &t, sizeof t);
+    if (snap_loading(s)) {
+        t.m = g_xhci.m;
+        g_xhci = t;
+        xhci_set_base(&g_xhci, g_xhci.base);
+    }
+}
diff --git a/src/xhci.h b/src/xhci.h
new file mode 100644
index 0000000..3d2be16
--- /dev/null
+++ b/src/xhci.h
@@ -0,0 +1,29 @@
+/* xhci.h -- XHCI plan: USB 3.0 host controller (docs/plans/XHCI_PLAN.md).
+ *
+ * X1: PCI identity + register file.  The contract is measured from the
+ * guest driver (AuraLite-OS@main drivers/usb/xhci.c, see XHCI_PLAN.md
+ * section 1a): class 0x0C/0x03/0x30 probe, legacy INTx, 64 KiB BAR0,
+ * the exact 11-step bring-up.  State is a plain-data global (the AHCI
+ * pattern) so snapshots serialize it via xhci_snap().
+ */
+#ifndef EMU_XHCI_H
+#define EMU_XHCI_H
+
+#include <stdint.h>
+#include "machine.h"
+#include "snapshot.h"
+
+#define XHCI_MMIO_BASE   0xFEB20000u   /* 64 KiB; clear of EHCI/AHCI/e1000 */
+#define XHCI_MMIO_SIZE   0x10000u
+#define XHCI_IRQ         10            /* measured free ISA line */
+#define XHCI_MAX_SLOTS   32
+#define XHCI_MAX_PORTS   4
+
+struct pci_dev;
+
+void     xhci_register(machine_t *m);
+void     xhci_snap(machine_t *m, snap_t *s);
+uint64_t xhci_pci_cfg_read(struct pci_dev *dev, int reg, int size);
+void     xhci_pci_cfg_write(struct pci_dev *dev, int reg, int size, uint64_t val);
+
+#endif
diff --git a/tests/test_xhci.c b/tests/test_xhci.c
new file mode 100644
index 0000000..10b277a
--- /dev/null
+++ b/tests/test_xhci.c
@@ -0,0 +1,243 @@
+/* tests/test_xhci.c -- XHCI X1 vectors: PCI identity + register file.
+ *
+ * Everything pinned here is the measured guest contract (XHCI_PLAN.md
+ * section 1a: AuraLite-OS drivers/usb/xhci.c) and the QEMU identity
+ * (section 1b: qemu-xhci = 1b36:000d rev 01).  The fixture is the full
+ * machine (devices_init_common), PCI config goes through the real
+ * 0xCF8/0xCFC mechanism and MMIO through mem_read/mem_write, so the
+ * vectors see exactly what the guest driver sees.
+ */
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "devices.h"
+#include "harness.h"
+
+static int fails;
+#define EXPECT(cond, ...) do { if (!(cond)) { printf("FAIL " __VA_ARGS__); printf("\n"); fails++; } } while (0)
+
+static machine_t M;   /* static: machine_t is ~2.8MB */
+
+#define XHCI_BAR   0xFEB20000u
+#define OP(off)    (XHCI_BAR + 0x40u + (off))          /* operational */
+#define PORT(p)    (XHCI_BAR + 0x40u + 0x400u + (p) * 0x10u)
+#define RT(off)    (XHCI_BAR + 0x800u + (off))         /* runtime */
+
+static uint32_t rd32(uint32_t a) { return (uint32_t)mem_read(&M, a, 4); }
+static void     wr32(uint32_t a, uint32_t v) { mem_write(&M, a, 4, v); }
+
+/* PCI mechanism #1, the test_pam.c recipe */
+static void pci_addr(int dev, int reg) {
+    io_write(&M, 0xCF8, 4, 0x80000000u | ((uint32_t)dev << 11) | ((uint32_t)reg & 0xFCu));
+}
+static uint32_t pci_rd32(int dev, int reg) { pci_addr(dev, reg); return (uint32_t)io_read(&M, 0xCFC, 4); }
+static void pci_wr32(int dev, int reg, uint32_t v) { pci_addr(dev, reg); io_write(&M, 0xCFC, 4, v); }
+static uint8_t pci_rd8(int dev, int reg) { pci_addr(dev, reg); return (uint8_t)io_read(&M, 0xCFC + (reg & 3), 1); }
+
+/* ---- v_pci_identity: the guest's class probe finds 1b36:000d ---------- */
+static void v_pci_identity(void) {
+    int f0 = fails;
+    int found = -1;
+    for (int d = 0; d < 32 && found < 0; d++) {
+        if ((pci_rd32(d, 0) & 0xFFFFu) == 0xFFFFu) continue;
+        if (pci_rd8(d, 0x0B) == 0x0C && pci_rd8(d, 0x0A) == 0x03 && pci_rd8(d, 0x09) == 0x30)
+            found = d;
+    }
+    EXPECT(found == 20, "class 0C/03/30 scan finds dev 20 (got %d)", found);
+    EXPECT(pci_rd32(20, 0x00) == 0x000D1B36u, "vendor:device 1b36:000d (got %08x)", pci_rd32(20, 0x00));
+    EXPECT(pci_rd32(20, 0x08) == 0x0C033001u, "class/revision dword (got %08x)", pci_rd32(20, 0x08));
+    EXPECT(pci_rd32(20, 0x2C) == 0x11001AF4u, "subsystem 1af4:1100 (got %08x)", pci_rd32(20, 0x2C));
+    EXPECT(pci_rd8(20, 0x3C) == 10, "interrupt line 10 (got %u)", pci_rd8(20, 0x3C));
+    EXPECT(pci_rd8(20, 0x3D) == 1, "interrupt pin INTA# (got %u)", pci_rd8(20, 0x3D));
+    EXPECT(pci_rd32(20, 0x10) == (XHCI_BAR | 0x4u), "BAR0 seeded 64-bit (got %08x)", pci_rd32(20, 0x10));
+    EXPECT(pci_rd32(20, 0x14) == 0, "BAR1 (upper dword) 0");
+    EXPECT(pci_rd32(20, 0x18) == 0 && pci_rd32(20, 0x30) == 0, "unimplemented BARs read 0");
+    if (fails == f0) printf("ok pci identity: 1b36:000d class 0C/03/30 at 0:20.0, IRQ 10 INTA#\n");
+}
+
+/* ---- v_bar_probe: sizing reads the 64 KiB mask, relocation rebinds ---- */
+static void v_bar_probe(void) {
+    int f0 = fails;
+    pci_wr32(20, 0x10, 0xFFFFFFFFu);
+    EXPECT(pci_rd32(20, 0x10) == 0xFFFF0004u, "BAR0 probe mask (got %08x)", pci_rd32(20, 0x10));
+    pci_wr32(20, 0x14, 0xFFFFFFFFu);
+    EXPECT(pci_rd32(20, 0x14) == 0, "BAR1 probe reads 0 (no bits above 32)");
+    /* place the BAR back; the MMIO window must decode at the seeded base */
+    pci_wr32(20, 0x10, XHCI_BAR | 0x4u);
+    pci_wr32(20, 0x14, 0);
+    EXPECT(pci_rd32(20, 0x10) == (XHCI_BAR | 0x4u), "BAR0 restored");
+    EXPECT(rd32(XHCI_BAR) == 0x01000040u, "caps dword decodes at the BAR base");
+    if (fails == f0) printf("ok bar probe: sizing mask + restore + decode\n");
+}
+
+/* ---- v_caps: the capability block the guest parses -------------------- */
+static void v_caps(void) {
+    int f0 = fails;
+    EXPECT(rd32(XHCI_BAR + 0x00) == 0x01000040u, "CAPLENGTH=0x40 HCIVERSION=1.00");
+    uint32_t h1 = rd32(XHCI_BAR + 0x04);
+    EXPECT((h1 & 0xFFu) == 32, "HCSPARAMS1 MaxSlots=32");
+    EXPECT(((h1 >> 8) & 0xFFu) == 1, "HCSPARAMS1 MaxIntrs=1");
+    EXPECT((h1 >> 24) == 4, "HCSPARAMS1 MaxPorts=4");
+    EXPECT(rd32(XHCI_BAR + 0x08) == 0, "HCSPARAMS2: no scratchpads");
+    EXPECT(rd32(XHCI_BAR + 0x10) == 1, "HCCPARAMS1: AC64 only (CSZ=0, PPC=0)");
+    EXPECT(rd32(XHCI_BAR + 0x14) == 0x1000u, "DBOFF");
+    EXPECT(rd32(XHCI_BAR + 0x18) == 0x800u, "RTSOFF");
+    /* sub-dword reads compose (test_usb.c EHCI-cap precedent) */
+    EXPECT(mem_read(&M, XHCI_BAR, 1) == 0x40, "CAPLENGTH byte read");
+    EXPECT(mem_read(&M, XHCI_BAR + 2, 2) == 0x0100, "HCIVERSION word read");
+    /* capability space is read-only */
+    wr32(XHCI_BAR + 0x00, 0xDEADBEEFu);
+    EXPECT(rd32(XHCI_BAR + 0x00) == 0x01000040u, "caps ignore writes");
+    if (fails == f0) printf("ok caps: version 1.00, 32 slots, 4 ports, AC64, RO\n");
+}
+
+/* ---- v_op_reset: the halt/reset/run handshake (guest init 1-3, 10) ---- */
+static void v_op_reset(void) {
+    int f0 = fails;
+    EXPECT(rd32(OP(0x04)) & 1u, "power-on USBSTS.HCH set");
+    wr32(OP(0x00), 0);                                   /* halt */
+    EXPECT(rd32(OP(0x04)) & 1u, "HCH after USBCMD=0");
+    wr32(OP(0x00), 4u | 1u);                             /* INTE|RUN */
+    EXPECT(!(rd32(OP(0x04)) & 1u), "HCH clears with RUN");
+    /* program state, then HCRST must wipe it */
+    wr32(OP(0x38), 32);                                  /* CONFIG */
+    wr32(OP(0x30), 0x00030000u);                         /* DCBAAP lo */
+    wr32(OP(0x18), 0x00040001u);                         /* CRCR ptr|RCS */
+    wr32(OP(0x00), 2u);                                  /* HCRST */
+    EXPECT(rd32(OP(0x00)) == 0, "HCRST self-clears (USBCMD=0)");
+    EXPECT(!(rd32(OP(0x04)) & (1u << 11)), "CNR clear after reset");
+    EXPECT(rd32(OP(0x04)) & 1u, "HCH set after reset");
+    EXPECT(rd32(OP(0x38)) == 0 && rd32(OP(0x30)) == 0 && rd32(OP(0x18)) == 0,
+           "CONFIG/DCBAAP/CRCR reset to 0");
+    if (fails == f0) printf("ok op reset: halt -> HCRST (self-clear, CNR=0) -> state wiped\n");
+}
+
+/* ---- v_programming: store registers read back exactly ----------------- */
+static void v_programming(void) {
+    int f0 = fails;
+    wr32(OP(0x38), 32);
+    EXPECT(rd32(OP(0x38)) == 32, "CONFIG MaxSlotsEn store");
+    wr32(OP(0x30), 0x00030000u); wr32(OP(0x34), 0x2u);
+    EXPECT(rd32(OP(0x30)) == 0x00030000u && rd32(OP(0x34)) == 2u, "DCBAAP 64-bit store");
+    wr32(OP(0x14), 0xFFFFu);
+    EXPECT(rd32(OP(0x14)) == 0xFFFFu, "DNCTRL store");
+    EXPECT(rd32(OP(0x08)) == 1, "PAGESIZE reads 1 (4 KiB)");
+    wr32(OP(0x08), 0xFFFFu);
+    EXPECT(rd32(OP(0x08)) == 1, "PAGESIZE is RO");
+    wr32(OP(0x18), 0x00040001u);
+    EXPECT(rd32(OP(0x18)) == 0x00040001u, "CRCR ptr|RCS store, CRR=0 while stopped");
+    wr32(OP(0x00), 4u | 1u);                             /* INTE|RUN */
+    EXPECT(rd32(OP(0x18)) == (0x00040001u | (1u << 3)), "CRR set once running");
+    wr32(OP(0x00), 0);
+    if (fails == f0) printf("ok programming: CONFIG/DCBAAP/CRCR/DNCTRL/PAGESIZE semantics\n");
+}
+
+/* ---- v_ports: empty ports, PPC=0 power, wake bits, no fake changes ---- */
+static void v_ports(void) {
+    int f0 = fails;
+    for (int p = 0; p < 4; p++) {
+        uint32_t ps = rd32(PORT(p));
+        EXPECT(ps == (1u << 9), "port %d empty: PP=1 only (got %08x)", p, ps);
+        EXPECT(rd32(PORT(p) + 4) == 0 && rd32(PORT(p) + 8) == 0, "port %d PMSC/LI read 0", p);
+    }
+    /* the guest's bring-up writes: PP alone, then PP|WCE|WDE */
+    wr32(PORT(0), 1u << 9);
+    EXPECT(rd32(PORT(0)) == (1u << 9), "PP-only write is stable");
+    wr32(PORT(0), (1u << 9) | (1u << 25) | (1u << 26));
+    EXPECT(rd32(PORT(0)) == ((1u << 9) | (1u << 25) | (1u << 26)), "wake bits store");
+    /* an all-ones write must not fabricate change/CCS/PED bits */
+    wr32(PORT(1), 0xFFFFFFFFu);
+    uint32_t ps = rd32(PORT(1));
+    EXPECT(!(ps & 0x3u), "all-ones write: CCS/PED stay 0 (got %08x)", ps);
+    EXPECT(!(ps & (0x7Fu << 17)), "all-ones write: no change bits fabricated");
+    EXPECT((ps & (7u << 25)) == (7u << 25), "all-ones write: wake bits taken");
+    if (fails == f0) printf("ok ports: PP=1 (PPC=0), wake store, writes fabricate nothing\n");
+}
+
+/* ---- v_interrupter: runtime registers store, IP quiet in X1 ----------- */
+static void v_interrupter(void) {
+    int f0 = fails;
+    wr32(RT(0x28), 1);
+    EXPECT(rd32(RT(0x28)) == 1, "ERSTSZ store");
+    wr32(RT(0x30), 0x00050000u); wr32(RT(0x34), 0);
+    EXPECT(rd32(RT(0x30)) == 0x00050000u, "ERSTBA store");
+    wr32(RT(0x38), 0x00060000u); wr32(RT(0x3C), 0);
+    EXPECT(rd32(RT(0x38)) == 0x00060000u, "ERDP store");
+    wr32(RT(0x24), 0);
+    EXPECT(rd32(RT(0x24)) == 0, "IMOD store");
+    wr32(RT(0x20), 2u);                                  /* IMAN.IE */
+    EXPECT(rd32(RT(0x20)) == 2u, "IMAN: IE=1, IP=0");
+    EXPECT(rd32(RT(0x40)) == 0, "interrupter 1 absent (MaxIntrs=1)");
+    if (fails == f0) printf("ok interrupter: ERST/ERDP/IMAN/IMOD store semantics\n");
+}
+
+/* ---- v_doorbell: X1 accepts and ignores (X2 rings the engine) --------- */
+static void v_doorbell(void) {
+    int f0 = fails;
+    wr32(XHCI_BAR + 0x1000u, 0);                         /* DB0: command ring */
+    wr32(XHCI_BAR + 0x1004u, 1u);                        /* DB1: slot 1 EP0 */
+    EXPECT(rd32(XHCI_BAR + 0x1000u) == 0, "doorbells read 0");
+    if (fails == f0) printf("ok doorbell: writes accepted, reads 0 (engine is X2)\n");
+}
+
+/* ---- v_guest_init: the guest's 11-step bring-up, in miniature ----------
+ * Replays xhci_init's register sequence (XHCI_PLAN 1a steps 1-11) with
+ * dummy DMA addresses; every wait the guest spins on must complete
+ * immediately, and the port scan must see 4 empty ports. */
+static void v_guest_init(void) {
+    int f0 = fails;
+    wr32(OP(0x00), 2u);                                  /* fresh HCRST */
+    int t = 1000000;
+    wr32(OP(0x00), 0);
+    while (!(rd32(OP(0x04)) & 1u) && t-- > 0) { }
+    EXPECT(t > 0, "step 1: halt waits HCH");
+    wr32(OP(0x00), 2u);
+    t = 1000000;
+    while ((rd32(OP(0x00)) & 2u) && t-- > 0) { }
+    EXPECT(t > 0, "step 2: HCRST clears");
+    t = 1000000;
+    while ((rd32(OP(0x04)) & (1u << 11)) && t-- > 0) { }
+    EXPECT(t > 0, "step 3: CNR clears");
+    wr32(OP(0x38), 32);                                  /* step 4: CONFIG */
+    wr32(OP(0x30), 0x00030000u); wr32(OP(0x34), 0);      /* steps 5-6: DCBAAP */
+    wr32(OP(0x18), 0x00040000u | 1u); wr32(OP(0x1C), 0); /* step 7: CRCR|RCS */
+    wr32(RT(0x28), 1);                                   /* step 8: interrupter 0 */
+    wr32(RT(0x30), 0x00050000u); wr32(RT(0x34), 0);
+    wr32(RT(0x38), 0x00060000u); wr32(RT(0x3C), 0);
+    wr32(RT(0x20), 2u); wr32(RT(0x24), 0);
+    for (int p = 0; p < 4; p++) {                        /* step 9: port power */
+        uint32_t ps = rd32(PORT(p));
+        if (!(ps & (1u << 9))) wr32(PORT(p), 1u << 9);
+    }
+    wr32(OP(0x00), 4u | 1u);                             /* step 10: INTE|RUN */
+    for (int p = 0; p < 4; p++) {
+        uint32_t ps = rd32(PORT(p));
+        wr32(PORT(p), (ps & (1u << 9)) | (1u << 25) | (1u << 26));
+    }
+    t = 1000000;
+    while ((rd32(OP(0x04)) & 1u) && t-- > 0) { }
+    EXPECT(t > 0, "step 10: controller running (HCH clear)");
+    int ready = 0;                                       /* step 11: port scan */
+    for (int p = 0; p < 4; p++) if (rd32(PORT(p)) & 1u) ready++;
+    EXPECT(ready == 0, "step 11: no devices attached yet (X4 binds the sticks)");
+    if (fails == f0) printf("ok guest init replay: steps 1-11 complete, 0 devices (X1 state)\n");
+}
+
+int main(void) {
+    setup_machine(&M);
+    devices_init_common(&M);
+    v_pci_identity();
+    v_bar_probe();
+    v_caps();
+    v_op_reset();
+    v_programming();
+    v_ports();
+    v_interrupter();
+    v_doorbell();
+    v_guest_init();
+    devices_done(&M);
+    if (fails) { printf("test-xhci: %d FAILED\n", fails); return 1; }
+    puts("test-xhci: all vectors passed");
+    return 0;
+}
-- 
