+<script>
+'use strict';
+const $=s=>document.querySelector(s), $$=s=>Array.from(document.querySelectorAll(s));
+const canvas=$('#screen'), ctx=canvas.getContext('2d');
+let ws=null, lastLog=[], logSeq=0, machineState='off', autoRan=false;
+
+/* ---------------- notifications ---------------- */
+function toast(msg, err){const t=$('#toast');t.textContent=msg;t.className='toast show'+(err?' err':'');
+  clearTimeout(t._h);t._h=setTimeout(()=>t.className='toast', err?6500:3200);}
+
+async function api(path, method='GET', body){
+  const r=await fetch(path,{method,headers:{'Content-Type':'application/json'},
+    body: body!==undefined?JSON.stringify(body):undefined});
+  let j={};try{j=await r.json()}catch(_e){}
+  if(!r.ok||j.ok===false) throw new Error(j.error||('HTTP '+r.status));
+  return j;
+}
+
+/* ---------------- configuration ---------------- */
+function cfgFromForm(){
+  const c={};
+  const put=(k,v)=>{if(v!==''&&v!==null&&v!==undefined&&v!==false)c[k]=v;};
+  put('rom',$('#fRom').value); put('disk',$('#fDisk').value);
+  put('kernel',$('#fKernel').value); put('initrd',$('#fInitrd').value);
+  put('snapshot_load',$('#fSnapLoad').value);
+  put('platform',$('#fPlatform').value);
+  put('smp',$('#fSmp').value|0 || '');
+  put('cpus',$('#fCpus').value);
+  if($('#fSmpProbe').checked)put('smp_probe',true);
+  if($('#fLpc').value!=='pantherpoint')put('lpc',$('#fLpc').value);
+  if($('#fNoUhci').checked)put('no_usb_uhci',true);
+  put('sata1',$('#fSata1').value); put('sata2p',$('#fSata2p').value); put('sata3',$('#fSata3').value);
+  if($('#fAhci2').checked)put('ahci2',true);
+  put('sata2',$('#fSata2').value); put('sata2_port1',$('#fSata2p1').value);
+  if($('#fWritethrough').checked)put('sata_writethrough',true);
+  const vbe=$('#fVbe').value;
+  if(vbe==='custom')put('vbe',$('#fVbeCustom').value);else if(vbe)put('vbe',vbe);
+  if($('#fNoFb').checked)put('no_fb',true);
+  put('tap',$('#fTap').value);
+  put('max_instr',$('#fMaxInstr').value);
+  if($('#fStats').checked)put('stats',true);
+  if($('#fLog').checked)put('log',true);
+  if($('#fDumpFb').checked)put('dump_fb',true);
+  if($('#fDumpText').checked)put('dump_text',true);
+  if($('#fTrace').checked)put('trace_file',true);
+  put('trace_from',$('#fTraceFrom').value); put('trace_count',$('#fTraceCount').value);
+  put('gdb',$('#fGdb').value); put('watch_phys',$('#fWatchPhys').value);
+  put('symbols',$('#fSymbols').value); put('debug_script',$('#fDebugScript').value);
+  put('keys',$('#fKeys').value); put('keys_at',$('#fKeysAt').value);
+  return c;
+}
+function cfgToForm(c){
+  const set=(sel,v)=>{const e=$(sel);if(e&&v!==undefined&&v!==null&&v!==false)e.value=v;};
+  set('#fRom',c.rom);set('#fDisk',c.disk);set('#fKernel',c.kernel);set('#fInitrd',c.initrd);
+  set('#fSnapLoad',c.snapshot_load);set('#fPlatform',c.platform||'haswell');
+  set('#fSmp',c.smp||1);set('#fCpus',c.cpus);set('#fLpc',c.lpc||'pantherpoint');
+  set('#fSata1',c.sata1);set('#fSata2p',c.sata2p);set('#fSata3',c.sata3);
+  set('#fSata2',c.sata2);set('#fSata2p1',c.sata2_port1);set('#fVbe',c.vbe||'');
+  set('#fTap',c.tap);set('#fMaxInstr',c.max_instr!==undefined?c.max_instr:'200000000');
+  set('#fTraceFrom',c.trace_from);set('#fTraceCount',c.trace_count);
+  set('#fGdb',c.gdb);set('#fWatchPhys',c.watch_phys);set('#fSymbols',c.symbols);
+  set('#fDebugScript',c.debug_script);set('#fKeys',c.keys);set('#fKeysAt',c.keys_at);
+  $('#fSmpProbe').checked=!!c.smp_probe;$('#fNoUhci').checked=!!c.no_usb_uhci;
+  $('#fAhci2').checked=!!c.ahci2;$('#fWritethrough').checked=!!c.sata_writethrough;
+  $('#fNoFb').checked=!!c.no_fb;$('#fStats').checked=c.stats!==false;
+  $('#fLog').checked=c.log!==false;$('#fDumpFb').checked=c.dump_fb!==false;
+  $('#fDumpText').checked=!!c.dump_text;$('#fTrace').checked=!!c.trace_file;
+  if(c.vbe&&c.vbe!=='off'&&['800x600x32','1024x768x32','1280x800x32'].indexOf(c.vbe)<0){
+    $('#fVbe').value='custom';$('#fVbeCustom').value=c.vbe;$('#vbeCustomWrap').style.display='';
+  }
+}
+
+/* ---------------- WebSocket (monitor protocol) ---------------- */
+function wsURL(){
+  const proto=location.protocol==='https:'?'wss://':'ws://';
+  return proto+location.host+'/ws';
+}
+function connectWS(){
+  if(ws){try{ws.close()}catch(_e){}}
+  $('#stConn').textContent='GUI: connecting…';$('#stConn').className='badge warn';
+  ws=new WebSocket(wsURL());ws.binaryType='arraybuffer';
+  ws.onopen=()=>{$('#stConn').textContent='GUI: connected';$('#stConn').className='badge ok';
+    if($('#fAutoRun').checked&&!autoRan){autoRan=true;sendCommand('continue');}};
+  ws.onclose=()=>{$('#stConn').textContent='GUI: disconnected';$('#stConn').className='badge bad';};
+  ws.onerror=()=>{$('#stConn').textContent='GUI: WS error';$('#stConn').className='badge bad';};
+  ws.onmessage=e=>{if(typeof e.data==='string'){
+    try{const m=JSON.parse(e.data);
+      if(m.kind==='state')renderState(m);else if(m.kind==='reply')renderReply(m);
+    }catch(_e){}
+  }else renderFramebuffer(e.data)};
+}
+function sendCommand(cmd,extra){
+  if(!ws||ws.readyState!==WebSocket.OPEN){toast('no connection to the machine',true);return}
+  ws.send(JSON.stringify(Object.assign({cmd},extra||{})));
+}
+function renderReply(r){
+  const txt=(r.ok?'OK':'ERROR')+' '+(r.cmd||'')+': '+(r.message||'')+(r.output?('\\n'+r.output):'');
+  $('#execOut').textContent=txt;
+  if(!r.ok)toast(r.message||'command error',true);
+}
+
+/* ---------------- state rendering ---------------- */
+function renderState(s){
+  $('#mPlatform').textContent=s.platform||'—';
+  $('#mMode').textContent=s.mode||'—';
+  $('#mStop').textContent=(s.stop_reason||'—')+(s.stop_lin?(' · '+s.stop_lin):'');
+  $('#stStop').textContent=s.stop_reason||'—';
+  if(s.stop_reason==='end'){
+    $('#stStop').className='badge ok';
+    $('#stStop').textContent='run finished (end) — "Stop" keeps the results';
+  }else{
+    $('#stStop').className='badge';
+    $('#stStop').textContent=s.stop_reason||'—';
+  }
+  $('#mVtime').textContent=s.vtime||'—';
+  $('#mExec').textContent=s.executed||'—';
+  $('#mDisasm').textContent=s.disassembly||'—';
+  const regs=s.registers||{};
+  $('#rGrid').innerHTML=Object.entries(regs).map(([k,v])=>
+    `<div class="r"><b>${k}</b><span>${v}</span></div>`).join('')||'—';
+  $('#mVcpus').textContent=(s.vcpus||[]).map(v=>
+    `vcpu${v.id}  ${v.state}  ${v.mode}  RIP=${v.rip}  steps=${v.executed_steps}`+
+    (v.halted?'  halted':'')+(v.fault?'  FAULT':'')).join('\n')||'—';
+  if(Array.isArray(s.logs)&&s.logs.length){
+    lastLog.push(...s.logs);
+    if(lastLog.length>2000)lastLog=lastLog.slice(-2000);
+    paintLog();
+  }
+  if(s.framebuffer)$('#fbInfo').textContent=`framebuffer: ${s.framebuffer.width}×${s.framebuffer.height}`;
+}
+function paintLog(){
+  const f=($('#logFilter').value||'').toLowerCase();
+  const txt=lastLog.filter(l=>!f||l.toLowerCase().includes(f)).join('\n');
+  $('#logBox').textContent=txt||'(empty)';
+  if($('#logScroll').checked)$('#logBox').scrollTop=$('#logBox').scrollHeight;
+}
+function renderFramebuffer(buffer){
+  const b=new Uint8Array(buffer);
+  if(b.length<10||b[0]!==70||b[1]!==66||b[2]!==1)return;
+  const d=new DataView(buffer), flags=b[3], w=d.getUint16(4,true), h=d.getUint16(6,true), rows=d.getUint16(8,true);
+  if(!w||!h||w>4096||h>4096)return;
+  if(canvas.width!==w||canvas.height!==h){canvas.width=w;canvas.height=h}
+  if(flags&1)ctx.clearRect(0,0,w,h);
+  let off=10;const rowImage=ctx.createImageData(w,1);
+  for(let n=0;n<rows;n++){
+    if(off+2>b.length)return;
+    const y=d.getUint16(off,true);off+=2;
+    if(y>=h||off+w*3>b.length)return;
+    for(let x=0;x<w;x++){const q=x*4,p=off+x*3;
+      rowImage.data[q]=b[p];rowImage.data[q+1]=b[p+1];rowImage.data[q+2]=b[p+2];rowImage.data[q+3]=255}
+    ctx.putImageData(rowImage,0,y);off+=w*3;
+  }
+}
+function applyScale(){
+  const v=$('#fbScale').value, w=canvas.width,h=canvas.height;
+  if(v==='fit')canvas.style.width='min(100%,720px)';
+  else canvas.style.width=(w*parseFloat(v))+'px';
+}
+
+/* ---------------- machine lifecycle ---------------- */
+async function refreshStatus(){
+  try{
+    const s=await api('/api/status');
+    machineState=s.state;
+    const map={off:['machine is off',''],running:['machine is running','ok'],
+      exited:['run finished'+(s.exit_code!==null?` (code ${s.exit_code})`:''), s.exit_code===0?'ok':'bad']};
+    const [txt,cls]=map[s.state]||[s.state,''];
+    $('#stState').textContent=txt;$('#stState').className='badge accent '+cls;
+    $('#btnStart').disabled=(s.state==='running');
+    $('#btnStop').disabled=(s.state!=='running');
+    $('#btnRestart').disabled=false;
+    if(s.run_dir)$('#runDirLabel').textContent='directory: '+s.run_dir;
+    const r=s.responder||{};
+    $('#respState').textContent='responder: '+(r.running?'on (pid '+r.pid+')':'off');
+    $('#respState').className='badge '+(r.running?'ok':'');
+    return s;
+  }catch(e){$('#stState').textContent='GUI: launcher unavailable';
+    $('#stState').className='badge bad';return null}
+}
+async function startMachine(){
+  try{
+    const cfg=cfgFromForm();
+    const st=await refreshStatus();
+    if(st&&st.state==='running'){if(!confirm('The machine is already running. Restart it?'))return;
+      await api('/api/stop','POST',{});}
+    await api('/api/start','POST',{config:cfg});
+    autoRan=false;
+    toast('machine starting…');
+    await refreshStatus();
+    setTimeout(connectWS,250);
+    setTimeout(()=>{refreshArtifacts()},1200);
+  }catch(e){toast('start: '+e.message,true)}
+}
+async function stopMachine(){
+  try{
+    /* T5 semantics: at the post-mortem "end" stop (and at any stop) the
+       polite way down is the monitor's quit -- it makes the emulator print
+       its stats/receipts and write the artifacts.  SIGTERM is the fallback. */
+    if(ws&&ws.readyState===WebSocket.OPEN&&machineState==='running'){sendCommand('quit');
+      for(let i=0;i<20;i++){await new Promise(r=>setTimeout(r,250));
+        const s=await refreshStatus();if(s&&s.state!=='running')break;}}
+    const r=await api('/api/stop','POST',{});
+    toast('stopped, code '+r.exit_code);
+    await refreshStatus();refreshArtifacts();refreshOutput();
+  }catch(e){toast('stop: '+e.message,true)}
+}
+async function restartMachine(){
+  try{await api('/api/stop','POST',{});autoRan=false;
+    await api('/api/restart','POST',{config:cfgFromForm()});
+    toast('restarting…');await refreshStatus();setTimeout(connectWS,250);}
+  catch(e){toast('restart: '+e.message,true)}
+}
+
+/* ---------------- artifacts / output / snapshots ---------------- */
+async function refreshArtifacts(){
+  try{
+    const a=await api('/api/artifacts');
+    $('#artRows').innerHTML=a.entries.map(e=>
+      `<tr><td>${e.name}</td><td>${e.size}</td><td>${new Date(e.mtime*1000).toLocaleString()}</td>
+      <td><a href="/api/artifact/${encodeURIComponent(e.name)}"><button class="small">Download</button></a></td></tr>`).join('')
+      ||'<tr><td colspan="4">— no files —</td></tr>';
+  }catch(e){}
+}
+async function refreshOutput(){
+  try{
+    const o=await api('/api/output?which='+$('#outWhich').value+'&tail=300');
+    $('#outBox').textContent=o.output||'(empty)';
+  }catch(e){}
+}
+async function refreshSnaps(){
+  try{
+    const s=await api('/api/snapshots');
+    $('#snapRows').innerHTML=s.entries.map(e=>
+      `<tr><td>${e.name}</td><td>${e.size}</td><td>${new Date(e.mtime*1000).toLocaleString()}</td>
+      <td class="flex"><button class="small" onclick="snapLoad('${e.name}')">Load</button>
+      <button class="small danger" onclick="snapDel('${e.name}')">Delete</button></td></tr>`).join('')
+      ||'<tr><td colspan="4">— no snapshots —</td></tr>';
+  }catch(e){}
+}
+async function snapSave(){
+  const name=($('#fSnapName').value||'').trim();
+  if(!name){toast('enter a snapshot name',true);return}
+  const st=await refreshStatus();
+  const dir=(st&&st.snap_dir)||'';
+  sendCommand('exec',{line:'savevm '+dir+'/'+name.replace(/[^\w.\-]/g,'_')+'.snap'});
+  setTimeout(refreshSnaps,800);
+}
+window.snapLoad=async name=>{
+  const st=await refreshStatus();const dir=(st&&st.snap_dir)||'';
+  sendCommand('exec',{line:'loadvm '+dir+'/'+name});
+};
+window.snapDel=async name=>{
+  if(!confirm('Delete snapshot '+name+'?'))return;
+  try{await api('/api/snapshots?name='+encodeURIComponent(name),'DELETE');refreshSnaps();}
+  catch(e){toast(e.message,true)}
+};
+
+/* ---------------- presets ---------------- */
+async function refreshPresets(){
+  try{
+    const p=await api('/api/presets');
+    const sel=$('#presetSel');
+    sel.innerHTML='<option value="">— presets —</option>'+
+      Object.keys(p.presets).sort().map(n=>`<option value="${n}">${n}</option>`).join('');
+  }catch(e){}
+}
+async function presetSave(){
+  const name=prompt('Preset name:');
+  if(!name)return;
+  try{await api('/api/presets','POST',{name,config:cfgFromForm()});
+    toast('preset saved');refreshPresets();}
+  catch(e){toast(e.message,true)}
+}
+async function presetLoad(){
+  const name=$('#presetSel').value;
+  if(!name){toast('choose a preset',true);return}
+  try{const p=await api('/api/presets');if(p.presets[name]){cfgToForm(p.presets[name]);
+    toast('preset "'+name+'" loaded');}}
+  catch(e){toast(e.message,true)}
+}
+async function presetDel(){
+  const name=$('#presetSel').value;
+  if(!name)return;
+  if(!confirm('Delete preset "'+name+'"?'))return;
+  try{await api('/api/presets?name='+encodeURIComponent(name),'DELETE');refreshPresets();}
+  catch(e){toast(e.message,true)}
+}
+
+/* ---------------- file picker ---------------- */
+let browseTarget=null, browseDir='';
+function openBrowser(fieldId, exts){
+  browseTarget=fieldId;
+  $('#fileModal').classList.add('open');
+  const cur=$('#'+fieldId).value.trim();
+  browseDir=cur?cur.replace(/[^/]+$/,''):'.';
+  if(!browseDir)browseDir='.';
+  loadDir(browseDir,exts);
+}
+async function loadDir(dir,exts){
+  try{
+    const r=await api('/api/files?path='+encodeURIComponent(dir)+
+      (exts?('&ext='+encodeURIComponent(exts)):''));
+    browseDir=r.path;
+    $('#fPath').value=r.path;
+    $('#fileList').innerHTML=
+      (r.parent?`<div class="frow dir" data-dir="${r.parent}">../</div>`:'')+
+      r.entries.map(e=>e.dir
+        ?`<div class="frow dir" data-dir="${r.path.replace(/\/$/,'')}/${e.name}">${e.name}/</div>`
+        :`<div class="frow" data-file="${r.path.replace(/\/$/,'')}/${e.name}">${e.name}
+           <span class="hint">${e.size}</span></div>`).join('')||'<div class="hint" style="padding:10px">empty</div>';
+  }catch(e){toast(e.message,true)}
+}
+
+/* ---------------- events ---------------- */
+$('#btnStart').onclick=startMachine;
+$('#btnStop').onclick=stopMachine;
+$('#btnRestart').onclick=restartMachine;
+$('#btnRun').onclick=()=>sendCommand('continue');
+$('#btnPause').onclick=()=>sendCommand('pause');
+$('#btnStep').onclick=()=>sendCommand('step');
+$('#btnQuit').onclick=()=>sendCommand('quit');
+$('#btnBreak').onclick=()=>{const a=$('#fBreak').value.trim();if(a)sendCommand('break',{addr:a})};
+$('#btnBreaks').onclick=()=>sendCommand('exec',{line:'info break'});
+$('#btnKeys').onclick=()=>{const c=$('#fKeyCodes').value.trim();if(c)sendCommand('keys',{codes:c})};
+$('#btnType').onclick=()=>{const t=$('#fTypeText').value.replace(/\\n/g,'\n');if(t)sendCommand('type',{text:t})};
+$('#btnExec').onclick=()=>{const l=$('#fExec').value;if(l)sendCommand('exec',{line:l})};
+$('#fExec').addEventListener('keydown',e=>{if(e.key==='Enter')$('#btnExec').click()});
+$('#btnFbPng').onclick=()=>{
+  const a=document.createElement('a');a.download='framebuffer.png';
+  a.href=canvas.toDataURL('image/png');a.click();
+};
+$('#fbScale').onchange=applyScale;
+$('#logFilter').oninput=paintLog;
+$('#btnLogClear').onclick=()=>{lastLog=[];paintLog()};
+$('#btnLogDownload').onclick=()=>{
+  const blob=new Blob([lastLog.join('\n')],{type:'text/plain'});
+  const a=document.createElement('a');a.download='machine-log.txt';
+  a.href=URL.createObjectURL(blob);a.click();
+};
+$('#btnOutRefresh').onclick=refreshOutput;
+$('#outWhich').onchange=refreshOutput;
+$('#btnArtRefresh').onclick=refreshArtifacts;
+$('#btnSnapRefresh').onclick=refreshSnaps;
+$('#btnSnapSave').onclick=snapSave;
+$('#btnPresetSave').onclick=presetSave;
+$('#btnPresetLoad').onclick=presetLoad;
+$('#btnPresetDel').onclick=presetDel;
+$('#btnRespOn').onclick=async()=>{
+  try{await api('/api/responder','POST',{on:true,port:+$('#fRespPort').value||8080,
+    drop:$('#fRespDrop').value,no_tcp:$('#fRespNoTcp').checked});
+    toast('responder started');refreshStatus();}
+  catch(e){toast(e.message,true)}
+};
+$('#btnRespOff').onclick=async()=>{
+  try{await api('/api/responder','POST',{on:false});toast('responder stopped');refreshStatus();}
+  catch(e){toast(e.message,true)}
+};
+$('#fVbe').onchange=()=>{$('#vbeCustomWrap').style.display=$('#fVbe').value==='custom'?'':'none'};
+$$('input[name=bootPath]').forEach(r=>r.onchange=()=>{
+  const k=$('input[name=bootPath]:checked').value==='kernel';
+  $('#fKernel').style.opacity=k?1:.55;$('#fInitrd').style.opacity=k?1:.55;
+  $('#fRom').style.opacity=k?.55:1;
+});
+$$('[data-browse]').forEach(b=>b.onclick=()=>openBrowser(b.dataset.browse,b.dataset.ext));
+$('#btnPathGo').onclick=()=>loadDir($('#fPath').value);
+$('#btnFileCancel').onclick=()=>$('#fileModal').classList.remove('open');
+$('#btnFileOk').onclick=()=>{
+  const sel=$('#fileList .frow.sel');
+  if(sel&&sel.dataset.file&&browseTarget)$('#'+browseTarget).value=sel.dataset.file;
+  $('#fileModal').classList.remove('open');
+};
+$('#fileList').addEventListener('click',e=>{
+  const row=e.target.closest('.frow');if(!row)return;
+  if(row.dataset.dir){loadDir(row.dataset.dir,$('#fileModal').dataset.exts||'');return}
+  $$('#fileList .frow').forEach(x=>x.classList.remove('sel'));
+  row.classList.add('sel');
+});
+$('#fileList').addEventListener('dblclick',e=>{
+  const row=e.target.closest('.frow');if(row&&row.dataset.file&&browseTarget){
+    $('#'+browseTarget).value=row.dataset.file;$('#fileModal').classList.remove('open');}
+});
+$$('.tab').forEach(t=>t.onclick=()=>{
+  $$('.tab').forEach(x=>x.classList.remove('active'));
+  $$('.page').forEach(x=>x.classList.remove('active'));
+  t.classList.add('active');
+  $('#tab-'+t.dataset.tab).classList.add('active');
+  if(t.dataset.tab==='files'){refreshArtifacts();refreshOutput()}
+  if(t.dataset.tab==='snap')refreshSnaps();
+});
+
+/* ---------------- startup ---------------- */
+(async function init(){
+  applyScale();
+  await refreshStatus();
+  refreshPresets();
+  setInterval(refreshStatus,2500);
+  try{
+    const s=await api('/api/status');
+    if(s.state==='running'){autoRan=true;connectWS();}
+    if(s.config)cfgToForm(s.config);
+  }catch(_e){}
+})();
+</script>
+</body>
