+# ---------------------------------------------------------------------------
+# Presets
+# ---------------------------------------------------------------------------
+
+class Presets:
+    def __init__(self, state_dir):
+        self.path = os.path.join(state_dir, "presets.json")
+        self.lock = threading.RLock()   # save() calls load() under the lock
+
+    def load(self):
+        with self.lock:
+            try:
+                with open(self.path, "r", encoding="utf-8") as f:
+                    data = json.load(f)
+                return data if isinstance(data, dict) else {}
+            except (OSError, ValueError):
+                return {}
+
+    def save(self, name, config):
+        name = str(name).strip()
+        if not re.match(r"^[\w .\-]{1,64}$", name):
+            raise ConfigError("bad preset name")
+        validate_config(config)  # presets store only schema-clean configs
+        with self.lock:
+            data = self.load()
+            data[name] = config
+            tmp = self.path + ".tmp"
+            with open(tmp, "w", encoding="utf-8") as f:
+                json.dump(data, f, indent=1)
+            os.replace(tmp, self.path)
+        return {"ok": True}
+
+    def delete(self, name):
+        with self.lock:
+            data = self.load()
+            data.pop(name, None)
+            with open(self.path, "w", encoding="utf-8") as f:
+                json.dump(data, f, indent=1)
+        return {"ok": True}
