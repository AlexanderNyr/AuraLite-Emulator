+        with self.lock:
+            run_dir = self.run_dir
+        if not run_dir or not name:
+            return None
+        path = os.path.join(run_dir, name)
+        return path if os.path.isfile(path) else None
+
+    # -- snapshots ----------------------------------------------------------
+    def snapshots(self):
