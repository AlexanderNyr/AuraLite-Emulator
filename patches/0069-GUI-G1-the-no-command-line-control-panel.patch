+                argv, cwd=ROOT, stdout=out, stderr=err,
+                stdin=subprocess.DEVNULL, start_new_session=True)
+            out.close(); err.close()
+            self.run_dir = run_dir
+            self.monitor_port = monitor_port
+            self.config = config
+            self.argv = argv
