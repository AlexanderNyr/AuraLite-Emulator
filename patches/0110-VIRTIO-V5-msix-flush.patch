+static void v_msix(void) {
+    int f0 = fails;
+    M.lapic.svr |= 0x100u;
+    guest_init(2, NULL);
+    /* entry 1 -> RX queue (LAPIC vector 0x61), entry 2 -> TX (0x62) */
+    static const struct { int entry; uint32_t vec; } tab[2] = { { 1, 0x61 }, { 2, 0x62 } };
