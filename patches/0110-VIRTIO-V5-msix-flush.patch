+static void msix_entry(int i, uint32_t vec, int unmask) {
+    wr32(MSIX_AT(i, 0), 0xFEE00000u);      /* msg addr: BSP, physical */
+    wr32(MSIX_AT(i, 1), 0);
+    wr32(MSIX_AT(i, 2), vec);              /* msg data: the bare vector */
+    wr32(MSIX_AT(i, 3), unmask ? 0u : 1u); /* vector control */
