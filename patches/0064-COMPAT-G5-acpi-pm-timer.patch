diff --git a/src/pm.c b/src/pm.c
new file mode 100644
index 0000000..32555c5
--- /dev/null
+++ b/src/pm.c
@@ -0,0 +1,100 @@
+/* pm.c -- ACPI PM register block (COMPAT G5).  Contract in pm.h. */
+#include <string.h>
+#include "machine.h"
+#include "pit.h"
+#include "pm.h"
+
+#define PM_BLOCK_LEN   0x40      /* PMBASE..PMBASE+0x3f                    */
+#define PM_TMR_OFF     0x08      /* PM1a_EVT_BLK (4) + PM1a_CNT_BLK (2) .. */
+#define PM_TMR_MASK    0x00FFFFFFu
+#define PM_TMR_RATIO   3u        /* 3.579545 MHz / 1.193182 MHz, exactly 3 */
+
+/* Advance the 24-bit counter to "now".  Called on every read, so the value
+ * a guest sees never depends on how often the block was polled; the whole
+ * cadence is derived from vtime_instr, like pit_tick(). */
+static void pm_advance(machine_t *m) {
+    pm_t *p = &m->pm;
+    uint64_t ipt = m->pit.instr_per_tick ? m->pit.instr_per_tick
+                                         : PIT_DEFAULT_IPT;
+    uint64_t now = m->vtime_instr;
+    uint64_t delta = now - p->last_instr;
+    p->last_instr = now;
+    if (!delta) return;
+    p->accum += delta * PM_TMR_RATIO;
+    uint64_t ticks = p->accum / ipt;
+    p->accum %= ipt;
+    if (ticks) p->count = (uint32_t)((p->count + ticks) & PM_TMR_MASK);
+}
+
+uint32_t pm_timer_now(machine_t *m) {
+    pm_advance(m);
+    return m->pm.count & PM_TMR_MASK;
+}
+
+/* Does [off, off+size) touch the Timer register's three live bytes? */
+static int pm_hits_tmr(uint16_t off, int size) {
+    return off < PM_TMR_OFF + 3 && (uint32_t)off + (uint32_t)size > PM_TMR_OFF;
+}
+
+static uint32_t pm_read_byte_stream(machine_t *m, uint16_t off, int size) {
+    /* Assemble the Timer register from its three live bytes.  Bits 31:24
+     * are reserved and read as zero (ICH9: TMR is a 24-bit counter). */
+    uint32_t tmr = pm_hits_tmr(off, size) ? pm_timer_now(m) : 0;
+    uint32_t v = 0;
+    for (int i = 0; i < size; i++) {
+        unsigned a = off + (unsigned)i;
+        uint8_t b = 0;
+        if (a >= PM_TMR_OFF && a < PM_TMR_OFF + 3)
+            b = (uint8_t)(tmr >> (8 * (a - PM_TMR_OFF)));
+        v |= (uint32_t)b << (8 * i);
+    }
+    return v;
+}
+
+static uint32_t pm_io_read(void *ctx, uint16_t port, int size) {
+    machine_t *m = ctx;
+    uint16_t off = (uint16_t)(port - m->pm.base);
+    /* Only the Timer register has state; the rest of the block reads 0.
+     * A read that straddles the Timer keeps its live bytes (see above). */
+    if (port >= m->pm.base && off < PM_BLOCK_LEN) {
+        if (pm_hits_tmr(off, size)) m->pm.reads++;
+        return pm_read_byte_stream(m, off, size);
+    }
+    return size == 1 ? 0xFFu : size == 2 ? 0xFFFFu : 0xFFFFFFFFu;
+}
+
+static void pm_io_write(void *ctx, uint16_t port, int size, uint32_t val) {
+    machine_t *m = ctx;
+    (void)size; (void)val;
+    uint16_t off = (uint16_t)(port - m->pm.base);
+    if (port < m->pm.base || off >= PM_BLOCK_LEN) return;
+    /* The Timer is read-only; PM1_STS would be W1C and PM1_CNT a sleep
+     * transition, neither of which this behavioural model implements.
+     * Swallowing the write is the honest option: nothing is fabricated. */
+}
+
+static void pm_register_block(machine_t *m, uint16_t base) {
+    io_register(m, base, PM_BLOCK_LEN, pm_io_read, pm_io_write, m,
+                "ACPI PM block");
+}
+
+static void pm_unregister_block(machine_t *m, uint16_t base) {
+    io_register(m, base, PM_BLOCK_LEN, NULL, NULL, NULL, NULL);
+}
+
+void pm_set_base(machine_t *m, uint16_t base) {
+    base = (uint16_t)(base & 0xFF80u);          /* PMBASE bits 15:7 */
+    if (base == m->pm.base) return;
+    pm_unregister_block(m, m->pm.base);
+    m->pm.base = base;
+    pm_register_block(m, base);
+}
+
+void pm_init(machine_t *m) {
+    uint16_t old = m->pm.base;
+    if (old) pm_unregister_block(m, old);
+    memset(&m->pm, 0, sizeof m->pm);
+    m->pm.base = 0xB000;                        /* Q35 / SeaBIOS default */
+    m->pm.last_instr = m->vtime_instr;
+    pm_register_block(m, m->pm.base);
+}
diff --git a/src/pm.h b/src/pm.h
new file mode 100644
index 0000000..1324354
--- /dev/null
+++ b/src/pm.h
@@ -0,0 +1,45 @@
+/* pm.h -- ACPI PM timer block (COMPAT G5).
+ *
+ * The ICH9/Q35 LPC function owns an ACPI PM register block at PMBASE.
+ * SeaBIOS programs PMBASE (`pci config 0:31.0 0x40 = 0xb000|1`) and then,
+ * once the FADT is published, switches its own timer to the 24-bit PM Timer
+ * at PMBASE+8 -- `timer_setup()` logs "Using pmtimer".  Before this module
+ * existed the port was unconnected, so it read 0xFFFFFFFF forever and every
+ * `timer_check()` poll spun without a timeout: with `--lpc=ich9` the AHCI
+ * port scan never expired and the BIOS never reached the boot path.
+ *
+ * Time base is the same deterministic one the PIT uses (pit.h, D6/K7): the
+ * PM timer runs at 3.579545 MHz, exactly three PIT ticks (1.193182 MHz),
+ * so it advances three counts per PIT tick.  There is no wall clock and no
+ * host timing anywhere in this file.
+ *
+ * Scope: the Timer register (offset 0x08, 24 bits, read-only) is modelled;
+ * every other byte of the 0x40-byte block reads as zero and ignores writes.
+ * PM1_CNT sleep transitions, PM1_STS/EN, GPE and SMBus are not modelled --
+ * a guest that writes them sees no effect instead of a fabricated one.
+ */
+#ifndef PM_H
+#define PM_H
+
+#include <stdint.h>
+
+struct machine;
+
+typedef struct pm {
+    uint16_t base;      /* PMBASE as programmed (bits 15:7), default 0xb000 */
+    uint32_t count;     /* 24-bit TMR counter                              */
+    uint64_t last_instr;/* vtime_instr at the last advance                  */
+    uint64_t accum;     /* fractional PIT-tick accumulator (TMR runs 3x)   */
+    uint64_t reads;     /* TMR reads (diagnostic)                          */
+} pm_t;
+
+/* Reset the block and decode it at the Q35/SeaBIOS default base 0xb000. */
+void pm_init(struct machine *m);
+
+/* Move the 0x40-byte register block; the old window stops decoding. */
+void pm_set_base(struct machine *m, uint16_t base);
+
+/* Current 24-bit Timer value, advanced from vtime_instr. */
+uint32_t pm_timer_now(struct machine *m);
+
+#endif
diff --git a/tests/g5_acpi_receipt.py b/tests/g5_acpi_receipt.py
new file mode 100644
index 0000000..7b0d315
--- /dev/null
+++ b/tests/g5_acpi_receipt.py
@@ -0,0 +1,248 @@
+#!/usr/bin/env python3
+"""COMPAT G5: ACPI acceptance on the accepted image.
+
+Walks the live ACPI tree inside an x86emu AURASNP1 snapshot and decodes the
+MADT far enough to check the two claims the guest makes on the serial line:
+
+  * `[BL9] ACPI RSDP found` / `[BL9] ACPI MADT parsed` -- the guest found a
+    root pointer and parsed one MADT;
+  * `[ioapic] base 0xfec00000 (MADT agree)` and `24 redirection entries` --
+    the I/O APIC the kernel programmed is the one the MADT describes.
+
+Usage:
+  g5_acpi_receipt.py --snapshot s.snap --serial run.serial.log   # print
+  g5_acpi_receipt.py --check receipt.txt --serial run.serial.log # gate
+
+Exit: 0 pass, 1 mismatch, 2 usage/IO.
+"""
+from __future__ import annotations
+
+import argparse
+import re
+import struct
+import sys
+from pathlib import Path
+
+PAGE = 4096
+RSDP_START, RSDP_END = 0x00080000, 0x00100000     # SeaBIOS search window
+
+
+def exact(f, n: int) -> bytes:
+    b = f.read(n)
+    if len(b) != n:
+        raise SystemExit(f"truncated snapshot: wanted {n} bytes, got {len(b)}")
+    return b
+
+
+def snapshot_ram(path: Path) -> bytearray:
+    with path.open("rb") as f:
+        if exact(f, 8) != b"AURASNP1":
+            raise SystemExit("not an x86emu AURASNP1 snapshot")
+        version, _ms, _cs = struct.unpack("<III", exact(f, 12))
+        if version not in (1, 2):
+            raise SystemExit(f"unsupported snapshot version {version}")
+        while True:
+            tag = exact(f, 16).split(b"\0", 1)[0].decode("ascii", "replace")
+            (size,) = struct.unpack("<Q", exact(f, 8))
+            if tag != "ram":
+                f.seek(size, 1)
+                continue
+            pages = (size + PAGE - 1) // PAGE
+            bitmap = exact(f, (pages + 7) // 8)
+            ram = bytearray(size)
+            for p in range(pages):
+                if bitmap[p // 8] & (1 << (p % 8)):
+                    off = p * PAGE
+                    ram[off:off + min(PAGE, size - off)] = exact(f, min(PAGE, size - off))
+            return ram
+
+
+def checksum_ok(data: bytes) -> bool:
+    return (sum(data) & 0xFF) == 0
+
+
+def read_table(ram: bytearray, addr: int) -> bytes:
+    if addr < 0 or addr + 36 > len(ram):
+        raise SystemExit(f"table header outside RAM at 0x{addr:x}")
+    length = struct.unpack_from("<I", ram, addr + 4)[0]
+    if length < 36 or addr + length > len(ram):
+        raise SystemExit(f"table length {length} outside RAM at 0x{addr:x}")
+    return bytes(ram[addr:addr + length])
+
+
+def decode_madt(body: bytes) -> dict:
+    lapic_base = struct.unpack_from("<I", body, 36)[0]
+    out = {"lapic_base": lapic_base, "cpus": [], "ioapics": [], "overrides": []}
+    off = 44
+    while off + 2 <= len(body):
+        etype, elen = body[off], body[off + 1]
+        if elen < 2 or off + elen > len(body):
+            break
+        if etype == 0 and elen >= 8:                       # Processor Local APIC
+            out["cpus"].append({"uid": body[off + 2], "apic_id": body[off + 3],
+                                "flags": struct.unpack_from("<I", body, off + 4)[0]})
+        elif etype == 1 and elen >= 12:                    # I/O APIC
+            out["ioapics"].append({"id": body[off + 2],
+                                   "addr": struct.unpack_from("<I", body, off + 4)[0],
+                                   "gsi_base": struct.unpack_from("<I", body, off + 8)[0]})
+        elif etype == 2 and elen >= 10:                    # Interrupt Source Override
+            out["overrides"].append({"bus": body[off + 2], "source": body[off + 3],
+                                     "gsi": struct.unpack_from("<I", body, off + 4)[0],
+                                     "flags": struct.unpack_from("<H", body, off + 8)[0]})
+        off += elen
+    return out
+
+
+SERIAL_PATTERNS = {
+    "rsdp": re.compile(r"\[BL9\] ACPI RSDP found"),
+    "madt": re.compile(r"\[BL9\] ACPI MADT parsed"),
+    "ioapic_agree": re.compile(r"\[ioapic\] base (0x[0-9a-f]+) \(MADT agree\)"),
+    "ioapic_entries": re.compile(r"I/O APIC @(0x[0-9a-f]+) ver 0x[0-9a-f]+, "
+                                 r"(\d+) redirection entries"),
+    "overrides": re.compile(r"\[ioapic\] overrides: (.+)$"),
+}
+
+
+def serial_facts(path: Path) -> dict:
+    text = path.read_text(errors="replace")
+    facts = {k: None for k in SERIAL_PATTERNS}
+    facts["order"] = []
+    for name, rx in SERIAL_PATTERNS.items():
+        m = rx.search(text)
+        if not m:
+            continue
+        if name in ("ioapic_agree", "ioapic_entries"):
+            facts["order"].append(name)
+        facts[name] = m.groups()
+    for marker in ("rsdp", "madt"):
+        if SERIAL_PATTERNS[marker].search(text):
+            pos = SERIAL_PATTERNS[marker].search(text).start()
+            facts["order"].append((pos, marker))
+    return facts
+
+
+def render(ram: bytearray) -> tuple[list[str], dict]:
+    lines: list[str] = []
+    at = ram.find(b"RSD PTR ", RSDP_START)
+    if at < 0 or at >= RSDP_END:
+        raise SystemExit("NO RSDP in the SeaBIOS window")
+    rsdp = bytes(ram[at:at + 20])
+    if not checksum_ok(rsdp):
+        raise SystemExit(f"RSDP at 0x{at:x}: bad checksum")
+    rsdt = struct.unpack_from("<I", ram, at + 16)[0]
+    lines.append(f"rsdp addr=0x{at:08x} rev={rsdp[15]} checksum=ok rsdt=0x{rsdt:08x}")
+
+    body = read_table(ram, rsdt)
+    if body[:4] != b"RSDT":
+        raise SystemExit(f"RSDT signature mismatch: {body[:4]!r}")
+    if not checksum_ok(body):
+        raise SystemExit("RSDT checksum bad")
+    count = (len(body) - 36) // 4
+    lines.append(f"rsdt sig=RSDT entries={count} checksum=ok")
+    facts = {"rsdp": at, "rsdt": rsdt, "entries": count, "tables": {}, "madt": None}
+    for k in range(count):
+        entry = struct.unpack_from("<I", ram, rsdt + 36 + 4 * k)[0]
+        tbl = read_table(ram, entry)
+        sig = tbl[:4].decode("ascii", "replace")
+        ok = checksum_ok(tbl)
+        facts["tables"][sig] = {"addr": entry, "len": len(tbl), "checksum_ok": ok}
+        lines.append(f"table sig={sig} addr=0x{entry:08x} len={len(tbl)} "
+                     f"checksum={'ok' if ok else 'BAD'}")
+        if sig == "APIC":
+            madt = decode_madt(tbl)
+            madt["len"] = len(tbl)
+            madt["checksum_ok"] = ok
+            facts["madt"] = madt
+    if facts["madt"] is None:
+        raise SystemExit("no MADT in the RSDT")
+    m = facts["madt"]
+    lines.append(f"madt lapic_base=0x{m['lapic_base']:08x} cpus={len(m['cpus'])} "
+                 f"ioapics={len(m['ioapics'])} isos={len(m['overrides'])}")
+    for io in m["ioapics"]:
+        lines.append(f"madt_ioapic id={io['id']} addr=0x{io['addr']:08x} "
+                     f"gsi_base=0x{io['gsi_base']:x}")
+    for ov in m["overrides"]:
+        lines.append(f"madt_iso bus={ov['bus']} source={ov['source']} "
+                     f"gsi={ov['gsi']} flags=0x{ov['flags']:04x}")
+    return lines, facts
+
+
+def check(receipt: Path, serial: Path) -> int:
+    kv: dict[str, str] = {}
+    for line in receipt.read_text().splitlines():
+        if not line.strip() or line.startswith("#"):
+            continue
+        parts = line.split()
+        kv[parts[0]] = line
+    fails = []
+
+    def need(cond: bool, msg: str) -> None:
+        if not cond:
+            fails.append(msg)
+
+    need("rsdp" in kv and "checksum=ok" in kv["rsdp"], "receipt: RSDP missing/bad")
+    need("rsdt" in kv and "checksum=ok" in kv["rsdt"], "receipt: RSDT missing/bad")
+    entries = int(re.search(r"entries=(\d+)", kv.get("rsdt", "")).group(1)) \
+        if "rsdt" in kv else 0
+    tables = [l for l in receipt.read_text().splitlines() if l.startswith("table sig=")]
+    need(len(tables) == entries, f"receipt: {len(tables)} table lines for {entries} RSDT entries")
+    need(all("checksum=ok" in t for t in tables), "receipt: a table checksum is BAD")
+    need(any("sig=APIC " in l for l in tables), "receipt: no MADT/APIC table")
+    madt_line = kv.get("madt", "")
+    need("lapic_base=0x" in madt_line, "receipt: MADT line missing")
+    ioapic_lines = [l for l in receipt.read_text().splitlines() if l.startswith("madt_ioapic ")]
+    need(len(ioapic_lines) >= 1, "receipt: MADT has no I/O APIC")
+
+    s = serial.read_text(errors="replace")
+    for key, rx in (("rsdp", SERIAL_PATTERNS["rsdp"]), ("madt", SERIAL_PATTERNS["madt"])):
+        need(rx.search(s) is not None, f"serial: missing {key} marker")
+    ioa = SERIAL_PATTERNS["ioapic_agree"].search(s)
+    need(ioa is not None, "serial: missing '[ioapic] base ... (MADT agree)'")
+    if ioa and ioapic_lines:
+        receipt_addr = re.search(r"addr=(0x[0-9a-f]+)", ioapic_lines[0]).group(1)
+        need(int(ioa.group(1), 16) == int(receipt_addr, 16),
+             f"serial ioapic {ioa.group(1)} != MADT {receipt_addr}")
+    ent = SERIAL_PATTERNS["ioapic_entries"].search(s)
+    need(ent is not None, "serial: missing I/O APIC redirection-entry count")
+    if ent and ioapic_lines:
+        need(ent.group(1) == ioapic_lines[0].split("addr=")[1].split()[0],
+             "serial: I/O APIC address differs from MADT")
+        madt_line = kv.get("madt", "")
+        isos = int(re.search(r"isos=(\d+)", madt_line).group(1)) if "isos=" in madt_line else 0
+        need(isos > 0, "receipt: MADT carries no ISO entries")
+    # Marker order: RSDP before MADT before the ioapic programming line.
+    pos = [s.find(m) for m in ("[BL9] ACPI RSDP found", "[BL9] ACPI MADT parsed",
+                               "[ioapic] base")]
+    need(all(p >= 0 for p in pos) and pos == sorted(pos),
+         "serial: RSDP/MADT/ioapic markers out of order")
+
+    for f in fails:
+        print("FAIL:", f, file=sys.stderr)
+    if fails:
+        return 1
+    print(f"g5 acpi: PASS ({len(tables)} tables, MADT ioapic "
+          f"{ioapic_lines[0].split('addr=')[1].split()[0]})")
+    return 0
+
+
+def main(argv: list[str]) -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--snapshot", type=Path)
+    ap.add_argument("--serial", type=Path, required=True)
+    ap.add_argument("--check", type=Path)
+    ap.add_argument("--out", type=Path)
+    a = ap.parse_args(argv)
+    if a.check:
+        return check(a.check, a.serial)
+    if not a.snapshot:
+        ap.error("need --snapshot (or --check RECEIPT)")
+    lines, _facts = render(snapshot_ram(a.snapshot))
+    text = "\n".join(lines) + "\n"
+    if a.out:
+        a.out.write_text(text)
+    sys.stdout.write(text)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
diff --git a/tests/integration/g5_acceptance_nc.sh b/tests/integration/g5_acceptance_nc.sh
new file mode 100755
index 0000000..c04dde6
--- /dev/null
+++ b/tests/integration/g5_acceptance_nc.sh
@@ -0,0 +1,85 @@
+#!/bin/sh
+# COMPAT G5 acceptance gate — negative control (patch 0064).
+#
+# Each case copies the bundle, applies one tampering, and requires
+# tests/test_g5_acceptance.py to reject it.  Cases 1-3 re-sign SHA256SUMS, so
+# the manifest cannot be what fails: the semantic checks must catch each
+# mutation themselves.  Case 4 leaves the manifest stale to prove the digest
+# check works.
+set -eu
+
+HERE=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+BUNDLE="$HERE/docs/evidence/compat-g5"
+GATE="$HERE/tests/test_g5_acceptance.py"
+TMP=${TMPDIR:-/tmp}/g5-acceptance-nc.$$
+mkdir -p "$TMP"
+trap 'rm -rf "$TMP"' EXIT INT TERM
+
+[ -d "$BUNDLE" ] || { echo "NC setup: missing $BUNDLE" >&2; exit 1; }
+[ -f "$GATE" ] || { echo "NC setup: missing $GATE" >&2; exit 1; }
+
+resign() {
+    ( cd "$1" && sha256sum $(ls | grep -v '^SHA256SUMS$') > SHA256SUMS )
+}
+
+expect_reject() {
+    case_name=$1
+    dir=$2
+    if python3 "$GATE" --evidence "$dir" >"$dir.gate.log" 2>&1; then
+        echo "NC FAIL: $case_name — gate accepted a tampered bundle"
+        cat "$dir.gate.log"
+        exit 1
+    fi
+    echo "NC PASS: $case_name (${dir}.gate.log)"
+}
+
+# Case 1: shell-active marker removed; manifest re-signed.
+C1="$TMP/1-no-shell"
+cp -a "$BUNDLE" "$C1"
+gzip -dc "$C1/x86emu-ich9.serial.log.gz" \
+    | grep -v 'shell active; kmain idling' \
+    | gzip -9n > "$C1/x86emu-ich9.serial.log.gz.new"
+mv "$C1/x86emu-ich9.serial.log.gz.new" "$C1/x86emu-ich9.serial.log.gz"
+resign "$C1"
+expect_reject "serial log without the shell-active marker" "$C1"
+
+# Case 2: the ICH9 RCRB reservation dropped from boot_info_t; manifest re-signed.
+C2="$TMP/2-no-rcrb"
+cp -a "$BUNDLE" "$C2"
+python3 - "$C2/bootinfo-ich9.bin" <<'PY'
+import struct, sys
+path = sys.argv[1]
+raw = bytearray(open(path, "rb").read())
+count = struct.unpack_from("<I", raw, 6184)[0]
+assert count == 8, count
+# Drop entry 6 (0xfed1c000+0x4000) by shifting entry 7 down and counting 7.
+base = 40
+raw[base + 6 * 24: base + 7 * 24] = raw[base + 7 * 24: base + 8 * 24]
+raw[base + 7 * 24: base + 8 * 24] = b"\0" * 24
+struct.pack_into("<I", raw, 6184, 7)
+open(path, "wb").write(raw)
+PY
+resign "$C2"
+expect_reject "E820 without the ICH9 RCRB reservation" "$C2"
+
+# Case 3: the PM-timer negative control edited to claim the mutant boots.
+C3="$TMP/3-nc-claims-pass"
+cp -a "$BUNDLE" "$C3"
+sed -i 's/^frozen:  BL3=absent steps=300000000/frozen:  BL3=present steps=297585739/' \
+    "$C3/nc-pm.txt"
+resign "$C3"
+expect_reject "negative control claims the frozen timer boots" "$C3"
+
+# Case 4: RSDP zeroed in boot_info_t, manifest left stale.
+C4="$TMP/4-stale-manifest"
+cp -a "$BUNDLE" "$C4"
+python3 - "$C4/bootinfo-ich9.bin" <<'PY'
+import sys
+path = sys.argv[1]
+raw = bytearray(open(path, "rb").read())
+raw[7760:7768] = b"\0" * 8
+open(path, "wb").write(raw)
+PY
+expect_reject "RSDP zeroed with a stale manifest" "$C4"
+
+echo "g5 acceptance NC: all four cases rejected"
diff --git a/tests/integration/g5_pm_nc.sh b/tests/integration/g5_pm_nc.sh
new file mode 100755
index 0000000..c2dbb23
--- /dev/null
+++ b/tests/integration/g5_pm_nc.sh
@@ -0,0 +1,93 @@
+#!/bin/sh
+# COMPAT G5 — negative control for the ACPI PM timer (patch 0064).
+#
+# The fix claims one thing: the ICH9 boot hangs because PMBASE+8 has no state.
+# This script restores exactly that defect in a throw-away copy and requires the
+# boot to stall again, while the unmodified tree reaches Stage 2 on the same
+# image and the same instruction budget.
+#
+#   case "frozen": pm_timer_now() returns 0xFFFFFFFF (the pre-fix port float).
+#     -> must NOT reach [BL3], must burn the whole budget.
+#   case "control": unmodified sources, same budget.
+#     -> must reach [BL3].
+#
+# The 300M budget is measured, not guessed: the fixed boot prints [BL3] at
+# executed_steps=297,585,739 and the frozen one prints nothing in 300M.
+set -eu
+
+HERE=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+TMP=${TMPDIR:-/tmp}/g5-pm-nc.$$
+BUDGET=300000000
+mkdir -p "$TMP"
+trap 'rm -rf "$TMP"' EXIT INT TERM
+
+ROM=${G5_ROM:-/tmp/sbpkg/usr/share/seabios/bios.bin}
+ISO=${G5_ISO:-/tmp/iso-candidate.iso}
+DISK="$HERE/docs/evidence/compat-g3/blank-usb-1m.img"
+
+for f in "$ROM" "$ISO" "$DISK"; do
+    [ -f "$f" ] || { echo "NC setup: missing $f" >&2; exit 2; }
+done
+
+run_boot() {   # $1 = tree, $2 = tag
+    ( cd "$1" && ./x86emu --lpc=ich9 --rom="$ROM" --platform=haswell \
+        --disk="$DISK" --sata="$ISO" --max-instr="$BUDGET" --stats ) \
+        >"$TMP/$2.out" 2>"$TMP/$2.serial.log"
+}
+
+# --- case 1: the defect, restored ------------------------------------------
+cp -a "$HERE" "$TMP/mutant"
+python3 - "$TMP/mutant/src/pm.c" <<'PY'
+import sys
+path = sys.argv[1]
+src = open(path).read()
+old = """uint32_t pm_timer_now(machine_t *m) {
+    pm_advance(m);
+    return m->pm.count & PM_TMR_MASK;
+}"""
+new = """uint32_t pm_timer_now(machine_t *m) {
+    /* G5 NC: pre-fix behaviour -- unconnected port floats high. */
+    (void)m;
+    return 0xFFFFFFFFu;
+}"""
+assert old in src, "NC setup: pm_timer_now() shape changed; update the mutation"
+src = src.replace(old, new, 1)
+src = src.replace("static void pm_advance(machine_t *m) {",
+                  "__attribute__((unused)) static void pm_advance(machine_t *m) {", 1)
+open(path, "w").write(src)
+PY
+( cd "$TMP/mutant" && make -j4 x86emu >"$TMP/mutant.build.log" 2>&1 ) || {
+    echo "NC setup: mutant build failed; see $TMP/mutant.build.log" >&2; exit 2; }
+
+run_boot "$TMP/mutant" frozen
+steps=$(sed -n 's/.*executed_steps=\([0-9]*\).*/\1/p' "$TMP/frozen.out" | head -1)
+if grep -qa '\[BL3\]' "$TMP/frozen.serial.log"; then
+    echo "NC FAIL: frozen TMR still reached Stage 2 (steps=$steps)"
+    exit 1
+fi
+[ "${steps:-0}" = "$BUDGET" ] || {
+    echo "NC FAIL: frozen run stopped early at steps=$steps, expected $BUDGET"
+    exit 1; }
+echo "NC PASS: frozen TMR never reaches [BL3] (steps=$steps)"
+
+# --- case 2: control --------------------------------------------------------
+run_boot "$HERE" control
+csteps=$(sed -n 's/.*executed_steps=\([0-9]*\).*/\1/p' "$TMP/control.out" | head -1)
+if ! grep -qa '\[BL3\]' "$TMP/control.serial.log"; then
+    echo "NC FAIL: control did not reach [BL3] within $BUDGET"
+    exit 1
+fi
+[ "${csteps:-0}" -lt "$BUDGET" ] || {
+    echo "NC FAIL: control only reached [BL3] by exhausting the budget"
+    exit 1; }
+echo "NC PASS: control reaches [BL3] at steps=$csteps (< $BUDGET)"
+
+diff_log="$HERE/docs/evidence/compat-g5/nc-pm.txt"
+{
+    echo "# COMPAT G5 PM-timer negative control"
+    echo "# rom=$ROM iso=$ISO"
+    echo "# md5=$(md5sum <"$ROM" | cut -d' ' -f1)"
+    echo "frozen:  BL3=absent steps=$steps"
+    echo "control: BL3=present steps=$csteps"
+} > "$diff_log" 2>/dev/null || true
+echo "NC: log -> ${diff_log#$HERE/}"
diff --git a/tests/test_g5_acceptance.py b/tests/test_g5_acceptance.py
new file mode 100644
index 0000000..9e786db
--- /dev/null
+++ b/tests/test_g5_acceptance.py
@@ -0,0 +1,217 @@
+#!/usr/bin/env python3
+"""COMPAT G5 acceptance gate (patch 0064).
+
+Re-checks the recorded receipts for the ICH9 lane: the boot reaches
+`[kernel] shell active` with `fault=0` inside the instruction budget, the
+handoff block reports eight E820 entries including the ICH9 RCRB window and a
+live RSDP, the ACPI receipt agrees with the serial log, and the negative
+control shows that a frozen PM timer reproduces the stall.
+
+File-based like the G3 gate: no emulator, no ISO, no snapshot needed, so it
+runs inside `make test`.
+
+Exit: 0 pass, 1 any check fails, 2 usage/IO.
+"""
+from __future__ import annotations
+
+import argparse
+import gzip
+import hashlib
+import re
+import struct
+import sys
+from pathlib import Path
+
+BOOT_INFO_SIZE = 7776
+BOOT_MAGIC = 0x4155524142544C44
+MMAP_OFF, MMAP_ENTRY_SIZE, MMAP_COUNT_OFF = 40, 24, 6184
+HHDM_OFF, INITRD_PHYS_OFF, INITRD_SIZE_OFF = 6192, 6200, 6208
+CPU_COUNT_OFF, BSP_LAPIC_OFF, RSDP_OFF, UEFI_OFF = 6216, 6220, 7760, 7768
+HHDM_VALUE = 0xFFFF800000000000
+RCRB = (0xFED1C000, 0x4000)
+SHELL_MARKER = "[kernel] shell active; kmain idling."
+
+FAILS: list[str] = []
+
+
+def check(ok: bool, label: str, detail: str = "") -> bool:
+    if ok:
+        print(f"ok   {label}" + (f" ({detail})" if detail else ""))
+    else:
+        print(f"FAIL {label}" + (f" ({detail})" if detail else ""), file=sys.stderr)
+        FAILS.append(label)
+    return ok
+
+
+def verify_manifest(directory: Path) -> None:
+    manifest = directory / "SHA256SUMS"
+    if not check(manifest.is_file(), "SHA256SUMS present"):
+        return
+    listed = 0
+    for line in manifest.read_text().splitlines():
+        if not line.strip():
+            continue
+        digest, name = line.split(None, 1)
+        name = name.lstrip("*")
+        target = directory / name
+        if not check(target.is_file(), f"bundle file {name}"):
+            continue
+        got = hashlib.sha256(target.read_bytes()).hexdigest()
+        check(got == digest, f"sha256 {name}", got[:16])
+        listed += 1
+    present = {p.name for p in directory.iterdir() if p.is_file()} - {"SHA256SUMS"}
+    check(listed == len(present), "manifest covers every file",
+          f"{listed}/{len(present)}")
+
+
+def read_serial(directory: Path) -> str:
+    plain = directory / "x86emu-ich9.serial.log"
+    if plain.is_file():
+        return plain.read_text(errors="replace")
+    gz = directory / "x86emu-ich9.serial.log.gz"
+    if gz.is_file():
+        return gzip.decompress(gz.read_bytes()).decode("utf-8", "replace")
+    return ""
+
+
+def verify_serial(directory: Path) -> str:
+    text = read_serial(directory)
+    if not check(bool(text), "serial log present"):
+        return ""
+    order = [
+        "[BL3] AuraLite stage2 alive",
+        "[BL3] unreal mode OK",
+        "[BL10] CPU supports long mode",
+        "[BL9] ACPI RSDP found",
+        "[BL9] ACPI MADT parsed",
+        "[BL4] ELF PT_LOAD segments copied to phys",
+        "[BL4] entering long mode; jumping to kernel _start",
+        SHELL_MARKER,
+    ]
+    pos = [text.find(m) for m in order]
+    missing = [m for m, p in zip(order, pos) if p < 0]
+    check(not missing, "every boot marker present", str(missing))
+    if not missing:
+        check(pos == sorted(pos), "boot markers in order")
+    check("panic" not in text.lower(), "no kernel panic in the serial log")
+    check("[ioapic] base 0xfec00000 (MADT agree)" in text,
+          "guest agrees with the MADT's I/O APIC base")
+    return text
+
+
+def verify_stats(directory: Path) -> None:
+    path = directory / "x86emu-ich9.stdout.txt"
+    if not check(path.is_file(), "stats stdout present"):
+        return
+    text = path.read_text(errors="replace")
+    m = re.search(r"\[stats\] vcpu=0 executed_steps=(\d+) instr_count=(\d+) "
+                  r"halted=(\d+) fault=(\d+)", text)
+    if not check(m is not None, "stats line parses"):
+        return
+    steps, _instr, _halted, fault = (int(x) for x in m.groups())
+    check(fault == 0, "fault=0", str(fault))
+    cap = re.search(r"\[stats\] cap=(\d+) cap_reached=(\d+)", text)
+    check(cap is not None, "cap line present")
+    if cap:
+        cap_n, reached = int(cap.group(1)), int(cap.group(2))
+        check(cap_n == 2_000_000_000, "budget is 2 G", str(cap_n))
+        check(reached == 1, "run ended by the cap, not by a fault", str(reached))
+    check("mode=long64" in text, "CPU finished in long mode")
+    check(steps > 0, "executed_steps recorded", str(steps))
+
+
+def verify_bootinfo(directory: Path) -> None:
+    block = directory / "bootinfo-ich9.bin"
+    if not check(block.is_file(), "bootinfo-ich9.bin present"):
+        return
+    raw = block.read_bytes()
+    if not check(len(raw) == BOOT_INFO_SIZE, "boot_info_t size", str(len(raw))):
+        return
+    check(struct.unpack_from("<Q", raw, 0)[0] == BOOT_MAGIC, "BOOT_MAGIC")
+    count = struct.unpack_from("<I", raw, MMAP_COUNT_OFF)[0]
+    check(count == 8, "E820 has 8 entries under --lpc=ich9", str(count))
+    entries = [struct.unpack_from("<QQII", raw, MMAP_OFF + i * MMAP_ENTRY_SIZE)
+               for i in range(min(count, 256))]
+    check(all(length > 0 and typ in (1, 2) for _, length, typ, _ in entries),
+          "E820 entries are non-empty RAM/reserved")
+    check(all(pad == 0 for *_, pad in entries), "E820 entry padding is zero")
+    ordered = all(entries[i][0] + entries[i][1] <= entries[i + 1][0]
+                  for i in range(len(entries) - 1))
+    check(ordered, "E820 entries sorted and non-overlapping")
+    check(any((base, length) == RCRB and typ == 2
+              for base, length, typ, _ in entries),
+          "ICH9 RCRB 0xfed1c000+0x4000 is reserved")
+    check(struct.unpack_from("<Q", raw, HHDM_OFF)[0] == HHDM_VALUE, "HHDM offset")
+    ip = struct.unpack_from("<Q", raw, INITRD_PHYS_OFF)[0]
+    isz = struct.unpack_from("<Q", raw, INITRD_SIZE_OFF)[0]
+    check(ip == 0x1800000 and isz == 0xB22000, "initrd address and size")
+    check(struct.unpack_from("<I", raw, CPU_COUNT_OFF)[0] == 1, "one CPU")
+    check(struct.unpack_from("<I", raw, BSP_LAPIC_OFF)[0] == 0, "BSP APIC id 0")
+    rsdp = struct.unpack_from("<Q", raw, RSDP_OFF)[0]
+    check(rsdp != 0, "boot_info_t carries a live RSDP", f"{rsdp:#x}")
+    check(raw[UEFI_OFF] == 0, "boot_from_uefi is 0")
+    check(not any(raw[UEFI_OFF + 1:]), "reserved padding is zero")
+    # The RSDP the handoff carries must be the one the ACPI walk found.
+    receipt = (directory / "acpi-receipt.txt").read_text().splitlines()
+    at = int(re.search(r"rsdp addr=0x([0-9a-f]+)", receipt[0]).group(1), 16)
+    check(rsdp == at, "handoff RSDP == RSDP found in memory",
+          f"{rsdp:#x} vs {at:#x}")
+
+
+def verify_acpi(directory: Path, tool: Path) -> None:
+    receipt = directory / "acpi-receipt.txt"
+    if not check(receipt.is_file(), "acpi-receipt.txt present"):
+        return
+    import subprocess
+    import tempfile
+    text = read_serial(directory)
+    with tempfile.NamedTemporaryFile("w", suffix=".log", delete=False) as tmp:
+        tmp.write(text)
+        tmp_path = Path(tmp.name)
+    try:
+        proc = subprocess.run([sys.executable, str(tool), "--check", str(receipt),
+                               "--serial", str(tmp_path)], capture_output=True, text=True)
+        check(proc.returncode == 0, "ACPI receipt agrees with the serial log",
+              (proc.stdout or proc.stderr).strip()[:120])
+    finally:
+        tmp_path.unlink(missing_ok=True)
+
+
+def verify_negative_control(directory: Path) -> None:
+    path = directory / "nc-pm.txt"
+    if not check(path.is_file(), "nc-pm.txt present"):
+        return
+    text = path.read_text()
+    frozen = re.search(r"frozen:\s+BL3=absent steps=(\d+)", text)
+    control = re.search(r"control:\s+BL3=present steps=(\d+)", text)
+    check(frozen is not None and int(frozen.group(1)) == 300_000_000,
+          "frozen PM timer burns the whole 300 M budget")
+    check(control is not None and int(control.group(1)) < 300_000_000,
+          "control reaches Stage 2 before the budget")
+
+
+def main(argv: list[str]) -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--evidence", type=Path,
+                    default=Path(__file__).resolve().parent.parent /
+                    "docs/evidence/compat-g5")
+    args = ap.parse_args(argv)
+    d = args.evidence
+    if not d.is_dir():
+        print(f"no such evidence directory: {d}", file=sys.stderr)
+        return 2
+    verify_manifest(d)
+    verify_serial(d)
+    verify_stats(d)
+    verify_bootinfo(d)
+    verify_acpi(d, Path(__file__).resolve().parent / "g5_acpi_receipt.py")
+    verify_negative_control(d)
+    if FAILS:
+        print(f"\n{len(FAILS)} check(s) failed", file=sys.stderr)
+        return 1
+    print("\nG5 acceptance: PASS")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
diff --git a/tests/test_pm.c b/tests/test_pm.c
new file mode 100644
index 0000000..6d98f9c
--- /dev/null
+++ b/tests/test_pm.c
@@ -0,0 +1,160 @@
+/* tests/test_pm.c -- COMPAT G5 vectors: ACPI PM block and its 24-bit Timer.
+ *
+ * The measured defect: with the ICH9 LPC identity stock SeaBIOS publishes the
+ * FADT, programs PMBASE (0:31.0 config 0x40 = 0xb000|1) and switches its own
+ * timer to PMBASE+8.  The port was unconnected, read 0xFFFFFFFF forever, and
+ * every timer_check() poll spun without a timeout -- the --lpc=ich9 boot never
+ * reached Stage 2.  These vectors pin the replacement:
+ *
+ *   1. TMR advances exactly three counts per PIT tick (3.579545/1.193182 MHz),
+ *      so 384 instructions/PIT-tick means one count per 128 retired steps.
+ *   2. The counter is 24 bits and wraps at 0x1000000.
+ *   3. Reads compose byte / word / dword at PMBASE+8; bits 31:24 read zero.
+ *   4. The rest of the 0x40-byte block reads zero, and TMR is read-only.
+ *   5. PMBASE moves the block: the old window stops decoding, the new one
+ *      answers, and the LPC config hook drives the move.
+ */
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "machine.h"
+#include "platform.h"
+#include "pci.h"
+#include "pit.h"
+#include "pm.h"
+#include "harness.h"
+
+#define PM_DEFAULT_BASE 0xB000
+#define STEPS_PER_TMR   128u   /* 384 instructions per PIT tick / 3 */
+
+static void step(machine_t *m, uint64_t n) {
+    for (uint64_t i = 0; i < n; i++) m->vtime_instr++;   /* the K6 clock */
+}
+
+static void test_default_window_and_rate(void) {
+    machine_t m; setup_machine(&m);
+    pit_init(&m); pm_init(&m);
+    assert(m.pm.base == PM_DEFAULT_BASE);
+
+    uint32_t t0 = io_read(&m, PM_DEFAULT_BASE + 8, 4);
+    assert(t0 == 0);
+
+    step(&m, STEPS_PER_TMR);
+    assert(io_read(&m, PM_DEFAULT_BASE + 8, 4) == 1);
+
+    step(&m, STEPS_PER_TMR * 10);
+    assert(io_read(&m, PM_DEFAULT_BASE + 8, 4) == 11);
+
+    /* Sub-count steps accumulate instead of being dropped. */
+    step(&m, STEPS_PER_TMR / 2);
+    assert(io_read(&m, PM_DEFAULT_BASE + 8, 4) == 11);
+    step(&m, STEPS_PER_TMR - STEPS_PER_TMR / 2);
+    assert(io_read(&m, PM_DEFAULT_BASE + 8, 4) == 12);
+
+    /* Three counts per PIT tick is the exact ratio the PIT model uses. */
+    machine_t p; setup_machine(&p);
+    pit_init(&p); pm_init(&p);
+    p.pit.instr_per_tick = 384;
+    step(&p, 384);
+    assert(pm_timer_now(&p) == 3);
+    puts("ok   pm: default window, 3 counts per PIT tick");
+}
+
+static void test_24bit_wrap(void) {
+    machine_t m; setup_machine(&m);
+    pit_init(&m); pm_init(&m);
+    m.pm.count = 0x00FFFFFEu;
+    m.pm.last_instr = m.vtime_instr;
+    step(&m, STEPS_PER_TMR * 3);
+    assert(pm_timer_now(&m) == 1);          /* 0xFFFFFE + 3 -> 1 */
+    machine_t n; setup_machine(&n);
+    pit_init(&n); pm_init(&n);
+    step(&n, (uint64_t)STEPS_PER_TMR * 0x1000000u);
+    assert(pm_timer_now(&n) == 0);          /* full 2^24 wrap */
+    puts("ok   pm: 24-bit counter wraps at 0x1000000");
+}
+
+static void test_read_sizes_and_reserved_bits(void) {
+    machine_t m; setup_machine(&m);
+    pit_init(&m); pm_init(&m);
+    m.pm.count = 0x00ABCDEFu;
+    m.pm.last_instr = m.vtime_instr;
+
+    assert(io_read(&m, PM_DEFAULT_BASE + 8, 4) == 0x00ABCDEFu);
+    assert(io_read(&m, PM_DEFAULT_BASE + 8, 1) == 0xEFu);
+    assert(io_read(&m, PM_DEFAULT_BASE + 9, 1) == 0xCDu);
+    assert(io_read(&m, PM_DEFAULT_BASE + 10, 1) == 0xABu);
+    assert(io_read(&m, PM_DEFAULT_BASE + 11, 1) == 0x00u);   /* reserved */
+    assert(io_read(&m, PM_DEFAULT_BASE + 10, 2) == 0x00ABu);
+    /* A read that starts inside the counter and runs past it keeps the live
+     * bytes and reads the modelled zero for the reserved ones. */
+    assert(io_read(&m, PM_DEFAULT_BASE + 10, 4) == 0x000000ABu);
+    puts("ok   pm: byte/word/dword reads, reserved bits read zero");
+}
+
+static void test_other_registers_and_write_ignore(void) {
+    machine_t m; setup_machine(&m);
+    pit_init(&m); pm_init(&m);
+    m.pm.count = 0x00000010u;
+    m.pm.last_instr = m.vtime_instr;
+
+    /* PM1_STS/EN (0x00..0x07), PM1_CNT (0x04), GPE, etc. read zero. */
+    for (uint16_t off = 0; off < 8; off++) assert(io_read(&m, PM_DEFAULT_BASE + off, 1) == 0);
+    assert(io_read(&m, PM_DEFAULT_BASE + 0x0C, 4) == 0);
+
+    /* Writes are swallowed: the Timer does not move, nothing appears. */
+    io_write(&m, PM_DEFAULT_BASE + 8, 4, 0xDEADBEEF);
+    assert(io_read(&m, PM_DEFAULT_BASE + 8, 4) == 0x10);
+    io_write(&m, PM_DEFAULT_BASE + 4, 2, 0x0000);
+    assert(io_read(&m, PM_DEFAULT_BASE + 4, 2) == 0);
+
+    /* Outside the block the port still floats high, as before this module. */
+    assert(io_read(&m, PM_DEFAULT_BASE + 0x40, 1) == 0xFF);
+    puts("ok   pm: only TMR has state; writes are swallowed");
+}
+
+static void test_rebase(void) {
+    machine_t m; setup_machine(&m);
+    pit_init(&m); pm_init(&m);
+    m.pm.count = 0x00000FF0u;
+    m.pm.last_instr = m.vtime_instr;
+
+    pm_set_base(&m, 0x0900 | 0x0001);       /* low bits are not part of base */
+    assert(m.pm.base == 0x0900);
+    assert(io_read(&m, 0x0908, 4) == 0xFF0u);
+    assert(io_read(&m, PM_DEFAULT_BASE + 8, 4) == 0xFFFFFFFFu);  /* old gone */
+
+    pm_set_base(&m, 0xB000);
+    assert(io_read(&m, PM_DEFAULT_BASE + 8, 4) == 0xFF0u);
+    assert(io_read(&m, 0x0908, 4) == 0xFFFFFFFFu);
+    puts("ok   pm: PMBASE moves the block and clears the old window");
+}
+
+static void test_lpc_config_hook_moves_base(void) {
+    machine_t m; setup_machine(&m);
+    pit_init(&m); pm_init(&m);
+    pci_init(&m);
+    pci_dev_t *lpc = pci_add_device(&m, 0, 31, 0, "lpc", 0x8086, 0x2918, 0x06, 0x01, 0);
+
+    /* What SeaBIOS's ich9_lpc_setup does: PMBASE = 0xb000 | 1. */
+    lpc->ctx = &m;
+    pci_default_cfg_write(lpc, 0x40, 4, 0x0000B001u);
+    pm_set_base(&m, (uint16_t)((lpc->cfg[0x40] | (lpc->cfg[0x41] << 8)) & 0xFF80u));
+    assert(m.pm.base == 0xB000);
+    m.pm.count = 0x0000002Au;
+    m.pm.last_instr = m.vtime_instr;
+    assert(io_read(&m, 0xB008, 4) == 0x2Au);
+    pci_done(&m);
+    puts("ok   pm: LPC PMBASE (0x40 = 0xb000|1) lands on 0xb000");
+}
+
+int main(void) {
+    test_default_window_and_rate();
+    test_24bit_wrap();
+    test_read_sizes_and_reserved_bits();
+    test_other_registers_and_write_ignore();
+    test_rebase();
+    test_lpc_config_hook_moves_base();
+    puts("pm tests: ok");
+    return 0;
+}
