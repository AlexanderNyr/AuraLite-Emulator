diff --git a/tests/test_tlb.c b/tests/test_tlb.c
index 2df74b5..541407c 100644
--- a/tests/test_tlb.c
+++ b/tests/test_tlb.c
@@ -490,6 +490,187 @@ static void smep_smap(void) {
     puts("ok cf1 AC cleared on delivery, preserved in the frame");
