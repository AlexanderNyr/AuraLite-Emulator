--- a/src/cpu.c
+++ b/src/cpu.c
@@ -3734,7 +3734,36 @@ really_slow:
                                    if (entering_pg && (c->efer & (1ULL<<8))) c->efer |= (1ULL<<10); /* set LMA */
                                    if (!((v>>31)&1)) c->efer &= ~(1ULL<<10);
