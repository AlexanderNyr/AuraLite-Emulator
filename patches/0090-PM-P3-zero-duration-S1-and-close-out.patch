@@ -54,12 +54,14 @@ uint32_t acpi_madt_len_for(int ncpus) {
 #define DSDT_OFF 0xA00
 #define FADT_LEN 244u           /* revision 4 (ACPI 5.0 shape) */
 
-/* The DSDT carries exactly one object: \_S5 = Package(7, 0), publishing
- * the sleep-type encoding src/pm.c decodes (PM P1).  Hand-encoded AML:
- * 08 _S5_ 12 06 02 0A 07 0A 00 -- NameOp, NameSeg, PackageOp
- * (PkgLength 6, NumElements 2, ByteConst 7, ByteConst 0). */
+/* The DSDT carries the two sleep objects src/pm.c decodes: \_S5 =
+ * Package(7, 0) (PM P1) and \_S1 = Package(1, 0) (PM P3, the
+ * zero-duration suspend).  Hand-encoded AML: 08 <NameSeg> 12 06 02
+ * 0A <typ> 0A 00 -- NameOp, PackageOp (PkgLength 6, NumElements 2,
+ * ByteConst typ, ByteConst 0). */
 static const uint8_t DSDT_AML[] = {
-    0x08, '_', 'S', '5', '_', 0x12, 0x06, 0x02, 0x0A, 0x07, 0x0A, 0x00
+    0x08, '_', 'S', '5', '_', 0x12, 0x06, 0x02, 0x0A, 0x07, 0x0A, 0x00,
+    0x08, '_', 'S', '1', '_', 0x12, 0x06, 0x02, 0x0A, 0x01, 0x0A, 0x00
 };
 #define DSDT_LEN (36u + (uint32_t)sizeof DSDT_AML)
 
diff --git a/src/pm.c b/src/pm.c
index cf8e6de..786cd96 100644
--- a/src/pm.c
+++ b/src/pm.c
@@ -18,6 +18,8 @@
 #define PM1_SLP_EN     0x2000u
 #define PM1_SLP_TYP(v) (((v) >> 10) & 7u)
 #define PM_SLP_TYP_S5  7u        /* Q35/PIIX4 encoding; P2's DSDT matches */
+#define PM_SLP_TYP_S1  1u        /* published as \_S1 by the P3 DSDT      */
+#define PM1_WAK_STS    0x8000u
 
 /* SCI is a level like the rest of the fleet: asserted while SCI_EN and
  * any enabled event latches (PM1 now, GPE0 joins in P2). */
@@ -104,15 +106,21 @@ static uint32_t pm_io_read(void *ctx, uint16_t port, int size) {
     return size == 1 ? 0xFFu : size == 2 ? 0xFFFFu : 0xFFFFFFFFu;
 }
 
-/* PM P1: a sleep request.  S5 is the machine's deterministic stop (the
- * same endpoint the debugger uses); other types are P3's to implement
- * and are logged, not faked. */
+/* PM P1/P3: a sleep request.  S5 is the machine's deterministic stop
+ * (the same endpoint the debugger uses).  S1 is zero-duration by
+ * measured decision (PM_PLAN 2c: no consumer needs real parking, and
+ * an already-pending wake event is spec-legal): WAK_STS latches, the
+ * run continues, and the guest's resume path does what it must do on
+ * any fast-waking machine.  Everything else is logged, not faked. */
 static void pm_sleep(machine_t *m, unsigned typ) {
     if (typ == PM_SLP_TYP_S5) {
         mlog(&m->log, "[pm] S5 power-off via PM1_CNT -- stopping the run");
         m->stop_requested = 1;
+    } else if (typ == PM_SLP_TYP_S1) {
+        m->pm.sts |= PM1_WAK_STS;
+        mlog(&m->log, "[pm] S1 suspend: zero-duration (WAK_STS latched)");
     } else {
-        mlog(&m->log, "[pm] sleep type %u requested -- ignored until PM P3", typ);
+        mlog(&m->log, "[pm] sleep type %u requested -- not implemented", typ);
     }
 }
 
