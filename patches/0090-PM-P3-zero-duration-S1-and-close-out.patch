diff --git a/tests/test_pm.c b/tests/test_pm.c
index 868c029..15c3021 100644
--- a/tests/test_pm.c
+++ b/tests/test_pm.c
@@ -226,6 +226,22 @@ static void test_gpe0(void) {
     puts("ok   pm: GPE0 STS/EN live, W1C clears, GPE joins SCI");
