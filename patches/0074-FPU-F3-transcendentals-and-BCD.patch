+/* the |x| >= 2^63 boundary: source unchanged, C2=1, no push, quiet */
+static void v_trans_huge_c2(void) {
+    static const uint8_t sin_p[]  = {0xBB,0x00,0x30, 0xDB,0x2F, 0xD9,0xFE, 0xDB,0x3F, 0xF4};
