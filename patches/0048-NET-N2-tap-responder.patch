diff --git a/tests/integration/n2_responder.sh b/tests/integration/n2_responder.sh
new file mode 100755
index 0000000..4a1b751
--- /dev/null
+++ b/tests/integration/n2_responder.sh
@@ -0,0 +1,222 @@
+#!/bin/sh
+# tests/integration/n2_responder.sh -- NET N2 host-responder wire harness.
+#
+# N2's claim is that a frame the guest puts on the wire gets a protocol-correct
+# answer back, and that the guest's own filters accept it.  That is a two-sided
+# claim, so it is measured on both sides:
+#
+#   Lane A (wire, always runs, x2): tools/tap_responder.py holds the ground-rule
+#     TAP endpoint (UDP 127.0.0.1:8080) and answers as slirp's user-mode stack
+#     does; tests/nic_net.c rides the K1 kernel-load transport (--kernel=, the
+#     4 GiB identity + HHDM map) and runs the frozen guest's own protocol code:
+#     DHCP DISCOVER/OFFER/REQUEST/ACK, then ARP who-has for the gateway, then an
+#     ICMP echo request with the guest's 32-byte 0x41..0x60 payload.  Receipts
+#     required, in the guest's own wording where the guest has wording:
+#       [dhcp] PASS: IP 10.0.2.15, gateway 10.0.2.2
+#       [net]  ICMP payload verified (ident+seq+32 bytes)
+#       [net]  PASS: lease + ARP + echo reply (payload verified)
+#       N2OK
+#     and the wire tape must be exactly four frames -- DISCOVER, REQUEST, ARP,
+#     ICMP echo -- byte-identical between the two runs.
+#
+#   Lane B (no device, always runs): the same payload WITHOUT --tap=.  The e1000
+#     function does not exist then (ground rule 3), so STATUS reads all-ones off
+#     the open bus -- LU is set, the link looks up -- and the payload proceeds
+#     into a TX ring nobody services.  It must report the guest's own timeout
+#     receipt rather than hang:
+#       [e1000] TX timeout: desc[0].status=0x00 TDH=4294967295 TDT=4294967295
+#       [dhcp] FAIL: DISCOVER transmit failed (link down or TX timeout)
+#       N2FAIL
+#     This is the pin that keeps every historical no-NIC lane byte-stable.
+#
+#   Lane C (frozen guest, SKIPs without it): the real AuraLite-OS kernel + initrd
+#     against the same responder.  N2's DoD receipts are the two lines the
+#     guest's own integration cases assert (tests/integration/cases/test_e1000e.sh
+#     :48 and test_vmxnet3.sh:49 in AuraLite-OS):
+#       [dhcp] PASS: IP 10.0.2.15, gateway 10.0.2.2
+#       [net] PASS: ping 10.0.2.2 successful (ICMP echo reply received)
+#     Requires the frozen build; the recipe is in docs/plans/NET_PLAN.md N2.
+#
+#   Lane D (negative control, always runs): the responder up with
+#     --drop=arp,icmp,dhcp.  Nothing is answered, so the run must degrade to the
+#     first timeout and nothing further:
+#       [dhcp] FAIL: no OFFER received
+#       [net] FAIL: no DHCP lease
+#       N2FAIL
+#     and this lane exits non-zero.  The emulator-side control for the same phase
+#     (removing src/e1000.c's RX descriptor *length* writeback -- not the DD bit,
+#     which the guest never checks) is documented in CHANGELOG.md and NET_PLAN.md
+#     with its measured receipts; it needs a rebuilt emulator, so it stays a
+#     documented manual step instead of a lane that quietly rebuilds the tree.
+#
+# Usage:
+#   tests/integration/n2_responder.sh [workdir]
+# Optional env: X86EMU (default ./x86emu), KERNEL, INITRD (lane C),
+#   RESP_TIMEOUT (default 25), MAX_INSTR (default 60000000).
+
+set -eu
+
+ROOT=$(cd "$(dirname "$0")/../.." && pwd)
+X86EMU=${X86EMU:-$ROOT/x86emu}
+WORK=${1:-/tmp/n2-responder}
+KERNEL=${KERNEL:-/home/user/AuraLite-OS/build/kernel.elf}
+INITRD=${INITRD:-/home/user/AuraLite-OS/build/initrd.tar}
+RESP_TIMEOUT=${RESP_TIMEOUT:-25}
+MAX_INSTR=${MAX_INSTR:-60000000}
+TAP=127.0.0.1:8080
+NC_TAP=127.0.0.1:8081          # lane D binds its own port so it cannot race A
+GW_MAC=52:55:0a:00:02:02
+
+mkdir -p "$WORK"
+fail=0
+need()    { grep -q "$1" "$2"    || { echo "  MISSING: $3"; fail=1; }; }
+need_no() { grep -q "$1" "$2" && { echo "  PRESENT: $3"; fail=1; } || :; }
+
+command -v python3 >/dev/null 2>&1 || { echo "SKIP: python3 missing"; exit 0; }
+[ -x "$X86EMU" ] || { echo "ERROR: build x86emu first (make x86emu)"; exit 1; }
+
+# ---- the payload ----------------------------------------------------------
+# Built here rather than by the Makefile so `sh tests/integration/n2_responder.sh`
+# works on a fresh clone.  Flags are the frozen K1 guest-image flags: no
+# sanitizers, no PIE, kernel code model, no SSE/red zone.
+CC=${CC:-cc}
+"$CC" -std=c11 -O1 -Wall -Wextra -Werror -ffreestanding -fno-stack-protector -fno-pie \
+    -mcmodel=kernel -mno-sse -mno-sse2 -mno-mmx -mno-red-zone -nostdlib -no-pie \
+    -Wl,-z,max-page-size=0x1000 -T "$ROOT/tests/nic_net.ld" \
+    "$ROOT/tests/nic_net.c" -o "$WORK/nic_net.elf"
+
+# wait until a port is actually bound, so the emulator's UDP connect() (a no-op
+# against an unbound endpoint) cannot silently cost us the first frame.
+wait_bound() { # wait_bound <port>
+    i=0
+    while [ "$i" -lt 100 ]; do
+        if python3 -c "
+import socket,sys
+s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM)
+try:
+    s.bind(('127.0.0.1',$1))
+except OSError:
+    sys.exit(0)
+s.close(); sys.exit(1)" 2>/dev/null; then return 0; fi
+        i=$((i+1)); sleep 0.05
+    done
+    echo "  ERROR: nothing bound UDP $1"
+    return 1
+}
+
+run_lane() { # run_lane <tag> <tap|none> <responder args...>
+    tag=$1; mode=$2; shift 2
+    if [ "$mode" != "none" ]; then
+        python3 "$ROOT/tools/tap_responder.py" \
+            --out "$WORK/$tag-frames.hex" --timeout "$RESP_TIMEOUT" "$@" \
+            > "$WORK/$tag-resp.out" 2>&1 &
+        resp=$!
+        wait_bound "${mode##*:}" || { fail=1; return 1; }
+    fi
+    if [ "$mode" = "none" ]; then
+        "$X86EMU" --platform=haswell --kernel="$WORK/nic_net.elf" \
+            --max-instr="$MAX_INSTR" --log="$WORK/$tag.log" \
+            > "$WORK/$tag.out" 2>&1 || true
+    else
+        "$X86EMU" --platform=haswell --kernel="$WORK/nic_net.elf" \
+            --tap="$mode" --max-instr="$MAX_INSTR" --log="$WORK/$tag.log" \
+            > "$WORK/$tag.out" 2>&1 || true
+        wait "$resp" || true
+    fi
+}
+
+echo "== protocol vectors: tools/tap_responder.py against the guest's own filters"
+python3 "$ROOT/tests/test_tap_responder.py" > "$WORK/unit.out" 2>&1 \
+    || { echo "  FAIL: responder protocol vectors (see $WORK/unit.out)"; fail=1; }
+need "test-tap-responder: all tests passed" "$WORK/unit.out" \
+    "responder protocol vectors"
+
+echo "== lane A: DHCP + ARP + ICMP over the real wire (x2 determinism)"
+run_lane a1 "$TAP"
+run_lane a2 "$TAP"
+for t in a1 a2; do
+    need "\[kload\] entry=0xffffffff80100000"          "$WORK/$t.log" \
+        "lane $t: K1 transport reached the payload in long mode"
+    need "\[dhcp\] OFFER: IP 10.0.2.15, server 10.0.2.2" "$WORK/$t.log" \
+        "lane $t: OFFER accepted by net.c's filter"
+    need "\[dhcp\] PASS: IP 10.0.2.15, gateway 10.0.2.2" "$WORK/$t.log" \
+        "lane $t: lease receipt (the guest's own integration assert)"
+    need "\[net\] ARP reply: gateway is $GW_MAC"       "$WORK/$t.log" \
+        "lane $t: ARP reply accepted, gateway MAC learned"
+    need "\[net\] ICMP payload verified (ident+seq+32 bytes)" "$WORK/$t.log" \
+        "lane $t: echo reply payload is the request's 0x41..0x60"
+    need "\[net\] PASS: lease + ARP + echo reply (payload verified)" "$WORK/$t.log" \
+        "lane $t: N2 composite receipt"
+    need "N2OK"                                        "$WORK/$t.log" \
+        "lane $t: payload summary"
+    need_no "N2FAIL"                                   "$WORK/$t.log" \
+        "lane $t: payload reported failure"
+    need "DHCP DISCOVER"                               "$WORK/$t-resp.out" \
+        "lane $t: responder saw the DISCOVER"
+    need "DHCP REQUEST"                                "$WORK/$t-resp.out" \
+        "lane $t: responder saw the REQUEST"
+    need "who-has 10.0.2.2 tell 10.0.2.15"             "$WORK/$t-resp.out" \
+        "lane $t: responder saw the ARP request"
+    need "ICMP echo request from 10.0.2.15 (id 0x1234 seq 1, 32 payload bytes)" \
+        "$WORK/$t-resp.out" "lane $t: responder saw the echo request"
+    n=$(wc -l < "$WORK/$t-frames.hex")
+    [ "$n" -eq 4 ] || { echo "  WIRE: lane $t put $n frames on the wire, want 4"; fail=1; }
+done
+cmp -s "$WORK/a1.log" "$WORK/a2.log" \
+    || { echo "  NONDETERMINISTIC: lane A serial tapes differ"; fail=1; }
+cmp -s "$WORK/a1-frames.hex" "$WORK/a2-frames.hex" \
+    || { echo "  NONDETERMINISTIC: lane A wire frames differ"; fail=1; }
+cmp -s "$WORK/a1-resp.out" "$WORK/a2-resp.out" \
+    || { echo "  NONDETERMINISTIC: lane A responder logs differ"; fail=1; }
+
+echo "== lane B: no --tap= means no e1000 at all (opt-in ground rule)"
+run_lane b1 none
+need "\[e1000\] TX timeout: desc\[0\].status=0x00 TDH=4294967295 TDT=4294967295" \
+    "$WORK/b1.log" "lane B: open-bus STATUS still reports LU, TX ring unserviced"
+need "\[dhcp\] FAIL: DISCOVER transmit failed" "$WORK/b1.log" \
+    "lane B: the payload reports instead of hanging"
+need "N2FAIL"    "$WORK/b1.log" "lane B: payload summary"
+need_no "N2OK"   "$WORK/b1.log" "lane B: payload claimed success without a NIC"
+need_no "\[dhcp\] PASS" "$WORK/b1.log" "lane B: no lease without a device"
+
+echo "== lane C: frozen-guest receipts (the DoD as the guest prints it)"
+if [ -r "$KERNEL" ] && [ -r "$INITRD" ]; then
+    python3 "$ROOT/tools/tap_responder.py" \
+        --out "$WORK/c1-frames.hex" --timeout "$RESP_TIMEOUT" \
+        > "$WORK/c1-resp.out" 2>&1 &
+    "$X86EMU" --platform=haswell --kernel="$KERNEL" --initrd="$INITRD" \
+        --tap="$TAP" --log="$WORK/c1.log" \
+        --max-instr=4500000000 > "$WORK/c1.out" 2>&1 || true
+    wait || true
+    need "\[net\] using NIC: e1000"                "$WORK/c1.log" "lane C: NIC bound"
+    need "\[dhcp\] PASS: IP 10.0.2.15, gateway 10.0.2.2" "$WORK/c1.log" \
+        "lane C: lease receipt"
+    need "\[net\] PASS: ping 10.0.2.2 successful (ICMP echo reply received)" \
+        "$WORK/c1.log" "lane C: self-test ping receipt"
+    need_no "\[e1000\] TX timeout"                 "$WORK/c1.log" "lane C: D2 receipt gone"
+else
+    echo "SKIP: frozen guest kernel/initrd missing ($KERNEL / $INITRD)"
+    echo "      reproduce with:"
+    echo "        KERNEL=$KERNEL INITRD=$INITRD $0 $WORK"
+fi
+
+echo "== lane D: negative control -- responder answers nothing (--drop)"
+run_lane d1 "$NC_TAP" --port 8081 --drop=arp,icmp,dhcp
+need "\[dhcp\] DISCOVER sent"        "$WORK/d1.log" "lane D: the request still went out"
+need "\[dhcp\] FAIL: no OFFER received" "$WORK/d1.log" "lane D: first timeout receipt"
+need "\[net\] FAIL: no DHCP lease"   "$WORK/d1.log" "lane D: no lease"
+need "N2FAIL"                        "$WORK/d1.log" "lane D: payload summary"
+need_no "N2OK"                       "$WORK/d1.log" "lane D: payload claimed success"
+need_no "\[dhcp\] PASS"              "$WORK/d1.log" "lane D: no lease receipt"
+need_no "ARP reply: gateway is"      "$WORK/d1.log" "lane D: never reached ARP"
+n=$(wc -l < "$WORK/d1-frames.hex")
+[ "$n" -eq 1 ] || { echo "  WIRE: lane D saw $n frames, want exactly 1 DISCOVER"; fail=1; }
+need "replies arp=0 dhcp=0 icmp=0" "$WORK/d1-resp.out" \
+    "lane D: responder withheld every reply"
+
+if [ "$fail" -eq 0 ]; then
+    echo "N2 responder receipts: ALL PASS"
+else
+    echo "N2 responder receipts: FAIL (see $WORK)"
+    exit 1
+fi
diff --git a/tests/nic_net.c b/tests/nic_net.c
new file mode 100644
index 0000000..2ed7206
--- /dev/null
+++ b/tests/nic_net.c
@@ -0,0 +1,552 @@
+/* tests/nic_net.c -- NET N2 wire payload: a guest stand-in that runs the
+ * frozen guest's own online self-test (DHCP -> ARP -> ICMP echo) against the
+ * host responder, through the real e1000 rings and the real TAP socket.
+ *
+ * Why this exists.  N2's DoD receipt (`[dhcp] PASS: IP 10.0.2.15, gateway
+ * 10.0.2.2` + `[net] PASS: ping 10.0.2.2 successful`) belongs to the frozen
+ * AuraLite-OS kernel, and that kernel cannot be built in every tree (it needs
+ * clang --target=x86_64-elf, ld.lld, rustc and mtools).  Leaving the phase
+ * unmeasured is not the house style, so this payload reproduces the guest's
+ * wire behaviour line by line and the harness SKIPs the real guest on top of
+ * it.  It is a *stand-in*, and it is written to be one honestly:
+ *
+ *   - the packets are built by the same code shape as AuraLite-OS@0ed0d29
+ *     kernel/net/net.c (net_eth_send's 60-byte pad, the DISCOVER/REQUEST
+ *     builders, net_ping's ident 0x1234 / seq 1 / 0x41..0x60 payload), and
+ *     the replies are accepted by the same filters, in the same order;
+ *   - the rings are programmed the way drivers/e1000/e1000.c e1000_init does
+ *     it (TX: TDLEN 32*16, TCTL EN|CT|COLD; RX: RDLEN 64*16, RDT = N-1,
+ *     MTA[0..127] = ~0, RCTL 0x0400801a) and drained the way
+ *     e1000_hw_rx_drain does (RDH delta, length from the descriptor, status
+ *     cleared, RDT re-armed to last_rdh + N - 1);
+ *   - the receipt lines are the guest's strings, so a tape from this payload
+ *     and a tape from the real kernel are directly comparable.
+ *
+ * It is NOT a second implementation of the stack: no sockets, no timers, no
+ * allocator.  Timeouts are bounded spin counts, which keeps the run
+ * deterministic (see the N2 determinism pair in docs/plans/NET_PLAN.md).
+ *
+ * Build: see the Makefile's `tests/nic_net.elf` rule (freestanding, the K1
+ * fixture's flags).  Entry is _start in long mode with paging on; the identity
+ * map kload_boot installs covers 0..4 GiB, so physical addresses are used
+ * directly.
+ */
+#include <stdint.h>
+
+/* ---- e1000 register file (BAR0 0xFEBC0000, seeded by e1000_add) ---------- */
+#define BAR        0xFEBC0000u
+#define REG(r)     (*(volatile uint32_t *)(uintptr_t)(BAR + (r)))
+#define E_CTRL     0x0000
+#define E_STATUS   0x0008
+#define E_ICR      0x00C0
+#define E_IMS      0x00D0
+#define E_RCTL     0x0100
+#define E_TCTL     0x0400
+#define E_RDBAL    0x2800
+#define E_RDBAH    0x2804
+#define E_RDLEN    0x2808
+#define E_RDH      0x2810
+#define E_RDT      0x2818
+#define E_TDBAL    0x3800
+#define E_TDBAH    0x3804
+#define E_TDLEN    0x3808
+#define E_TDH      0x3810
+#define E_TDT      0x3818
+#define E_MTA      0x5200
+#define E_RAL      0x5400
+#define E_RAH      0x5404
+
+#define CTRL_FD    (1u << 0)
+#define CTRL_SLU   (1u << 6)
+/* RX descriptor status byte (descriptor offset 12), bit 0 = DD.  Same value
+ * and same byte offset as the emulator's src/e1000.c RXD_STAT_DD. */
+#define RXD_STAT_DD  0x01
+#define STATUS_LU  (1u << 1)
+#define TCTL_EN    (1u << 1)
+#define RCTL_EN    (1u << 1)
+
+/* ---- guest constants (drivers/e1000/e1000.c) ----------------------------- */
+#define NUM_TX_DESC   32
+#define NUM_RX_DESC   64
+#define PKT_BUF_SIZE  2048
+
+/* ---- slirp addressing, as the guest hardcodes it (kernel/net/net.c:39-47) - */
+#define OUR_IP   0x0A00020Fu      /* 10.0.2.15, host order like the guest's */
+#define GW_IP    0x0A000202u      /* 10.0.2.2  */
+
+/* ---- fixed physical layout.  kload_boot puts this image at 0x100000 and the
+ * ---- boot_info at 0x20000, so the rings live above both; RAM_SIZE is 128
+ * ---- MiB, and everything here is a few hundred KiB. */
+#define TX_RING_PHYS   0x00300000u
+#define TX_BUF_PHYS    0x00310000u
+#define RX_RING_PHYS   0x00340000u
+#define RX_BUF_PHYS    0x00350000u
+
+struct tx_desc {                    /* e1000.c:93, 16 bytes */
+    uint64_t addr;
+    uint16_t length;
+    uint8_t  cso;
+    uint8_t  cmd;
+    uint8_t  status;
+    uint8_t  css;
+    uint16_t special;
+} __attribute__((packed));
+
+struct rx_desc {
+    uint64_t addr;
+    uint16_t length;
+    uint16_t csum;
+    uint8_t  status;
+    uint8_t  errors;
+    uint16_t special;
+} __attribute__((packed));
+
+static volatile struct tx_desc *const tx_ring =
+    (volatile struct tx_desc *)(uintptr_t)TX_RING_PHYS;
+static volatile struct rx_desc *const rx_ring =
+    (volatile struct rx_desc *)(uintptr_t)RX_RING_PHYS;
+static uint8_t *const tx_buf = (uint8_t *)(uintptr_t)TX_BUF_PHYS;
+static uint8_t *const rx_buf = (uint8_t *)(uintptr_t)RX_BUF_PHYS;
+
+static uint8_t our_mac[6];
+static uint8_t gw_mac[6];
+static uint32_t our_ip, gw_ip;
+static uint32_t tx_tail, rx_last;
+
+/* ---- COM1 ---------------------------------------------------------------- */
+static void outb(uint16_t port, uint8_t v) {
+    __asm__ volatile("outb %0, %1" : : "a"(v), "dN"(port));
+}
+static uint8_t inb(uint16_t port) {
+    uint8_t v; __asm__ volatile("inb %1, %0" : "=a"(v) : "dN"(port)); return v;
+}
+static void putc_(char c) {
+    while (!(inb(0x3FD) & 0x20)) { }
+    outb(0x3F8, (uint8_t)c);
+}
+static void puts_(const char *s) { for (; *s; s++) putc_(*s); }
+static void hex(uint32_t v, int digits) {
+    static const char d[] = "0123456789abcdef";
+    for (int i = digits - 1; i >= 0; i--) putc_(d[(v >> (i * 4)) & 0xF]);
+}
+static void dec(uint32_t v) {
+    char b[10]; int n = 0;
+    if (!v) { putc_('0'); return; }
+    while (v) { b[n++] = (char)('0' + v % 10); v /= 10; }
+    while (n) putc_(b[--n]);
+}
+static void ipdots(uint32_t ip) {          /* the guest prints host order */
+    dec((ip >> 24) & 0xFF); putc_('.');
+    dec((ip >> 16) & 0xFF); putc_('.');
+    dec((ip >> 8) & 0xFF);  putc_('.');
+    dec(ip & 0xFF);
+}
+static void macdots(const uint8_t *m) {
+    for (int i = 0; i < 6; i++) { if (i) putc_(':'); hex(m[i], 2); }
+}
+
+/* ---- byte order + checksum, as net.c:156-198 -----------------------------
+ * The guest's own htons_/htonl_ are not reproduced here: this payload builds
+ * every header byte-wise (put_be32) and reads them back with be32, which is
+ * the same wire order with one less place to get a swap wrong.  `checksum()`
+ * IS reproduced bit for bit, because a wrong header checksum is exactly the
+ * class of bug a lenient peer would hide. */
+static uint16_t checksum(const void *data, uint32_t len) {
+    const uint8_t *p = data;
+    uint32_t sum = 0;
+    for (uint32_t i = 0; i + 1 < len; i += 2)
+        sum += (uint32_t)((p[i] << 8) | p[i + 1]);
+    if (len & 1) sum += p[len - 1];
+    while (sum >> 16) sum = (sum & 0xFFFF) + (sum >> 16);
+    return (uint16_t)(~sum & 0xFFFF);
+}
+static uint32_t be32(const uint8_t *p) {
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+           ((uint32_t)p[2] << 8) | (uint32_t)p[3];
+}
+static void put_be32(uint8_t *p, uint32_t v) {
+    p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16);
+    p[2] = (uint8_t)(v >> 8);  p[3] = (uint8_t)v;
+}
+
+/* ---- the rings ----------------------------------------------------------- */
+static void nic_init(void) {
+    for (uint32_t i = 0; i < NUM_TX_DESC * sizeof(struct tx_desc); i++)
+        ((uint8_t *)(uintptr_t)TX_RING_PHYS)[i] = 0;
+    for (uint32_t i = 0; i < NUM_RX_DESC * sizeof(struct rx_desc); i++)
+        ((uint8_t *)(uintptr_t)RX_RING_PHYS)[i] = 0;
+
+    our_mac[0] = 0x52; our_mac[1] = 0x54; our_mac[2] = 0x00;
+    our_mac[3] = 0x12; our_mac[4] = 0x34; our_mac[5] = 0x56;
+
+    REG(E_CTRL) = CTRL_FD | CTRL_SLU;
+    REG(E_IMS)  = 0xD5;                       /* the guest's mask */
+
+    /* TX, exactly as e1000_init's step 6 */
+    REG(E_TDBAL) = TX_RING_PHYS;
+    REG(E_TDBAH) = 0;
+    REG(E_TDLEN) = NUM_TX_DESC * 16;
+    REG(E_TDH)   = 0;
+    REG(E_TDT)   = 0;
+    REG(E_TCTL)  = TCTL_EN | (0x10u << 4) | (0x40u << 12);
+
+    /* RX, exactly as e1000_init's step 7: one buffer per descriptor, tail
+     * armed to N-1 so the ring is never "full" (RDH == RDT drops). */
+    for (uint32_t i = 0; i < NUM_RX_DESC; i++)
+        rx_ring[i].addr = RX_BUF_PHYS + (uint64_t)i * PKT_BUF_SIZE;
+    REG(E_RDBAL) = RX_RING_PHYS;
+    REG(E_RDBAH) = 0;
+    REG(E_RDLEN) = NUM_RX_DESC * 16;
+    REG(E_RDH)   = 0;
+    REG(E_RDT)   = NUM_RX_DESC - 1;
+    REG(E_RAL)   = (uint32_t)our_mac[0] | ((uint32_t)our_mac[1] << 8) |
+                   ((uint32_t)our_mac[2] << 16) | ((uint32_t)our_mac[3] << 24);
+    REG(E_RAH)   = (uint32_t)our_mac[4] | ((uint32_t)our_mac[5] << 8) |
+                   (1u << 31);
+    for (int i = 0; i < 128; i++) REG(E_MTA + i * 4) = 0xFFFFFFFFu;
+    REG(E_RCTL)  = RCTL_EN | (1u << 26) | (1u << 15) | (1u << 4) | (1u << 3);
+
+    tx_tail = 0;
+    rx_last = 0;
+}
+
+/* e1000_send(): one descriptor, cmd 0x0B, TDT doorbell, then spin on DD. */
+static int nic_send(const uint8_t *frame, uint32_t len) {
+    if (!(REG(E_STATUS) & STATUS_LU)) { puts_("[e1000] link down\n"); return -1; }
+    if (len > PKT_BUF_SIZE) len = PKT_BUF_SIZE;
+    uint32_t slot = tx_tail;
+    for (uint32_t i = 0; i < len; i++) tx_buf[i] = frame[i];
+    tx_ring[slot].addr   = TX_BUF_PHYS;
+    tx_ring[slot].length = (uint16_t)len;
+    tx_ring[slot].cso    = 0;
+    tx_ring[slot].cmd    = 0x0B;              /* EOP | IFCS | RS */
+    tx_ring[slot].status = 0;
+    tx_tail = (tx_tail + 1) % NUM_TX_DESC;
+    REG(E_TDT) = tx_tail;                     /* the doorbell */
+    /* The guest's own budget is 100000 pause-spins (drivers/e1000/e1000.c:565),
+     * and the number matters: it is what makes the no-device lane report
+     * instead of hanging.  Copied, not invented. */
+    for (int32_t timeout = 100000; timeout-- > 0;) {
+        if (tx_ring[slot].status & 0x01) return 0;
+        __asm__ volatile("pause");
+    }
+    puts_("[e1000] TX timeout: desc["); dec(slot);
+    puts_("].status=0x"); hex(tx_ring[slot].status, 2);
+    puts_(" TDH="); dec(REG(E_TDH));
+    puts_(" TDT="); dec(REG(E_TDT)); putc_('\n');
+    return -1;
+}
+
+/* e1000_hw_rx_drain() (drivers/e1000/e1000.c:504): RDH delta, `length` from
+ * the descriptor, `pkt_len > 0` as the gate, status cleared, RDT re-armed.
+ * Returns one frame per call, 0 when the ring holds nothing usable.
+ *
+ * Two fidelity notes, both measured rather than assumed:
+ *  - The guest gates on `length`, NOT on DD.  So removing the emulator's DD
+ *    writeback (src/e1000.c:373) does not make the frozen guest fail; the
+ *    length writeback at src/e1000.c:372 is the one that does.  That is why
+ *    N2's emulator-side negative control removes the length, not the DD.
+ *  - This stand-in additionally requires DD, because that is what the SDM and
+ *    QEMU say a completed RX descriptor carries, and N2 must not pass on an
+ *    emulator that publishes a stale length with no completion.  It is a
+ *    strictly tighter gate than the guest's: everything the guest accepts,
+ *    this accepts too.
+ * A zero-length or DD-less slot is consumed exactly as the guest consumes it
+ * (status cleared, head advanced, RDT re-armed) but reports nothing. */
+static uint32_t nic_poll(uint8_t *out, uint32_t cap) {
+    uint32_t rdh = REG(E_RDH);
+    if (rdh == rx_last) return 0;
+    uint32_t idx = rx_last % NUM_RX_DESC;
+    uint32_t len = rx_ring[idx].length;
+    uint8_t  st  = rx_ring[idx].status;
+    if (len > PKT_BUF_SIZE) len = PKT_BUF_SIZE;
+    if (len > cap) len = cap;
+    if (len && (st & RXD_STAT_DD)) {
+        const uint8_t *src = rx_buf + (uint64_t)idx * PKT_BUF_SIZE;
+        for (uint32_t i = 0; i < len; i++) out[i] = src[i];
+    } else {
+        len = 0;
+    }
+    rx_ring[idx].status = 0;
+    rx_last = (rx_last + 1) % NUM_RX_DESC;
+    REG(E_RDT) = (rx_last + NUM_RX_DESC - 1) % NUM_RX_DESC;
+    return len;
+}
+
+/* Bounded receive: the emulator drains the TAP socket from devices_tick every
+ * 256 instructions, so the reply lands on a tick -- which only happens while
+ * the guest executes.  A spin budget, not a clock, keeps that deterministic. */
+#define RECV_SPINS 3000000u
+static uint32_t nic_recv(uint8_t *out, uint32_t cap) {
+    for (uint32_t t = 0; t < RECV_SPINS; t++) {
+        uint32_t n = nic_poll(out, cap);
+        if (n) return n;
+        __asm__ volatile("pause");
+    }
+    return 0;
+}
+
+/* ---- Ethernet / IP / UDP framing, as net.c:293 --------------------------- */
+static uint32_t eth_build(uint8_t *frame, const uint8_t dst[6],
+                          uint16_t ethertype, const uint8_t *payload,
+                          uint32_t plen) {
+    for (int i = 0; i < 6; i++) { frame[i] = dst[i]; frame[6 + i] = our_mac[i]; }
+    frame[12] = (uint8_t)(ethertype >> 8);
+    frame[13] = (uint8_t)ethertype;
+    for (uint32_t i = 0; i < plen; i++) frame[14 + i] = payload[i];
+    uint32_t total = 14 + plen;
+    while (total < 60) frame[total++] = 0;    /* the 60-byte minimum */
+    return total;
+}
+
+static void ip_build(uint8_t *p, uint8_t proto, uint32_t src, uint32_t dst,
+                     const uint8_t *body, uint32_t blen, uint16_t ident) {
+    p[0] = 0x45; p[1] = 0;
+    p[2] = (uint8_t)((20 + blen) >> 8); p[3] = (uint8_t)(20 + blen);
+    p[4] = (uint8_t)(ident >> 8);       p[5] = (uint8_t)ident;
+    p[6] = 0; p[7] = 0;
+    p[8] = 64; p[9] = proto; p[10] = 0; p[11] = 0;
+    put_be32(p + 12, src);
+    put_be32(p + 16, dst);
+    uint16_t cs = checksum(p, 20);
+    p[10] = (uint8_t)(cs >> 8); p[11] = (uint8_t)cs;
+    for (uint32_t i = 0; i < blen; i++) p[20 + i] = body[i];
+}
+
+/* ---- DHCP, as net.c:801 -------------------------------------------------- */
+#define DHCP_FIXED 236
+static uint32_t dhcp_build(uint8_t *buf, uint8_t msgtype, uint32_t xid,
+                           int with_request_opts, uint32_t req_ip,
+                           uint32_t srv_ip) {
+    for (uint32_t i = 0; i < DHCP_FIXED; i++) buf[i] = 0;
+    buf[0] = 1; buf[1] = 1; buf[2] = 6; buf[3] = 0;
+    put_be32(buf + 4, xid);
+    buf[10] = 0x80; buf[11] = 0;                 /* broadcast flag */
+    for (int i = 0; i < 6; i++) buf[28 + i] = our_mac[i];
+    put_be32(buf + 232, 0x63825363u);            /* magic cookie */
+
+    uint32_t o = DHCP_FIXED;
+    buf[o++] = 53; buf[o++] = 1; buf[o++] = msgtype;
+    if (!with_request_opts) {                    /* DISCOVER: parameter list */
+        buf[o++] = 55; buf[o++] = 3;
+        buf[o++] = 1; buf[o++] = 3; buf[o++] = 6;
+    } else {                                     /* REQUEST: 50 then 54 */
+        buf[o++] = 50; buf[o++] = 4; put_be32(buf + o, req_ip); o += 4;
+        buf[o++] = 54; buf[o++] = 4; put_be32(buf + o, srv_ip); o += 4;
+    }
+    buf[o++] = 255;
+    return o;
+}
+
+static const uint8_t *dhcp_find_option(const uint8_t *opts, int len, uint8_t code,
+                                       int *out_len) {
+    int i = 0;                                   /* net.c:777 verbatim */
+    while (i < len) {
+        uint8_t c = opts[i];
+        if (c == 255) break;
+        if (c == 0) { i++; continue; }
+        if (i + 1 >= len) break;
+        uint8_t l = opts[i + 1];
+        if (c == code) { if (out_len) *out_len = l; return opts + i + 2; }
+        i += 2 + l;
+    }
+    return 0;
+}
+
+static uint32_t dhcp_xid = 0x12345678u;          /* net.c:808 */
+
+static int dhcp_send(uint8_t msgtype, uint32_t req_ip, uint32_t srv_ip) {
+    uint8_t pkt[576], frame[700];
+    uint32_t dlen = dhcp_build(pkt, msgtype, dhcp_xid, msgtype == 3,
+                               req_ip, srv_ip);
+    uint32_t udp_len = 8 + dlen;
+    uint8_t *udp = frame + 14 + 20;
+    udp[0] = (uint8_t)(68 >> 8); udp[1] = (uint8_t)68;   /* src port 68 */
+    udp[2] = (uint8_t)(67 >> 8); udp[3] = (uint8_t)67;   /* dst port 67 */
+    udp[4] = (uint8_t)(udp_len >> 8); udp[5] = (uint8_t)udp_len;
+    udp[6] = 0; udp[7] = 0;                      /* no UDP checksum, as the guest */
+    for (uint32_t i = 0; i < dlen; i++) udp[8 + i] = pkt[i];
+    uint8_t bcast[6] = {0xFF,0xFF,0xFF,0xFF,0xFF,0xFF};
+    ip_build(frame + 14, 17, 0x00000000u, 0xFFFFFFFFu, udp, udp_len,
+             msgtype == 1 ? 0x1234 : 0x1235);
+    uint32_t total = 14 + 20 + udp_len;
+    while (total < 60) frame[total++] = 0;
+    for (int i = 0; i < 6; i++) { frame[i] = bcast[i]; frame[6 + i] = our_mac[i]; }
+    frame[12] = 0x08; frame[13] = 0x00;
+    return nic_send(frame, total);
+}
+
+/* Returns the message type accepted (2/5), or 0 on timeout. */
+static int dhcp_recv(uint32_t *yiaddr, uint32_t *server_id, uint32_t *mask,
+                     uint32_t *dns, uint32_t *router) {
+    uint8_t rbuf[2048];
+    uint32_t n = nic_recv(rbuf, sizeof rbuf);
+    if (!n) return 0;
+    if (n < 14 + 20 + 8 + DHCP_FIXED) return 0;
+    if (rbuf[12] != 0x08 || rbuf[13] != 0x00) return 0;
+    if (rbuf[14 + 9] != 17) return 0;
+    if (rbuf[34] != 0 || rbuf[35] != 67) return 0;      /* udp.src == 67 */
+    if (rbuf[36] != 0 || rbuf[37] != 68) return 0;      /* udp.dst == 68 */
+    const uint8_t *dhcp = rbuf + 42;
+    int opts_len = (int)n - (14 + 20 + 8 + DHCP_FIXED);
+    if (opts_len < 4) return 0;
+    if (dhcp[0] != 2) return 0;                          /* BOOTREPLY */
+    /* net.c:1058 -- the ACK path compares ntohl_(ack->xid) with the xid it
+     * sent; the OFFER path does not, but a responder that cannot echo an xid
+     * is not worth talking to, so this stand-in checks it in both. */
+    if (be32(dhcp + 4) != dhcp_xid) return 0;
+    const uint8_t *opts = dhcp + DHCP_FIXED;
+    int l;
+    const uint8_t *mt = dhcp_find_option(opts, opts_len, 53, &l);
+    if (!mt || l != 1) return 0;
+    *yiaddr = be32(dhcp + 16);                   /* net.c:927 ntohl_(yiaddr) */
+    const uint8_t *sid = dhcp_find_option(opts, opts_len, 54, &l);
+    if (sid && l == 4) *server_id = be32(sid);
+    const uint8_t *sm = dhcp_find_option(opts, opts_len, 1, &l);
+    if (sm && l == 4) *mask = be32(sm);
+    const uint8_t *dn = dhcp_find_option(opts, opts_len, 6, &l);
+    if (dn && l >= 4) *dns = be32(dn);
+    const uint8_t *rt = dhcp_find_option(opts, opts_len, 3, &l);
+    if (rt && l >= 4) *router = be32(rt);
+    return mt[0];
+}
+
+static int run_dhcp(void) {
+    puts_("[dhcp] starting DHCP discovery...\n");
+    uint32_t yiaddr = 0, sid = 0, mask = 0, dns = 0, router = 0;
+
+    if (dhcp_send(1, 0, 0) < 0) {
+        puts_("[dhcp] FAIL: DISCOVER transmit failed (link down or TX timeout)\n");
+        return -1;
+    }
+    puts_("[dhcp] DISCOVER sent (xid=0x"); hex(dhcp_xid, 8); puts_(")\n");
+
+    int mt = dhcp_recv(&yiaddr, &sid, &mask, &dns, &router);
+    if (mt != 2) { puts_("[dhcp] FAIL: no OFFER received\n"); return -1; }
+    puts_("[dhcp] OFFER: IP "); ipdots(yiaddr);
+    puts_(", server "); ipdots(sid); putc_('\n');
+
+    if (dhcp_send(3, yiaddr, sid) < 0) {
+        puts_("[dhcp] FAIL: REQUEST transmit failed (link down or TX timeout)\n");
+        return -1;
+    }
+    puts_("[dhcp] REQUEST sent (requesting "); ipdots(yiaddr); puts_(")\n");
+
+    uint32_t ayi = 0, asid = 0, amask = mask, adns = dns, arouter = 0;
+    mt = dhcp_recv(&ayi, &asid, &amask, &adns, &arouter);
+    if (mt != 5) { puts_("[dhcp] FAIL: no ACK received\n"); return -1; }
+    if (ayi) yiaddr = ayi;
+    if (arouter) router = arouter;
+    our_ip = yiaddr;
+    if (router) gw_ip = router;
+    if (mask) {
+        puts_("[dhcp] subnet mask: "); ipdots(mask); putc_('\n');
+    }
+    if (dns) {
+        puts_("[dhcp] DNS server: "); ipdots(dns); puts_(" (1 total)\n");
+    }
+    puts_("[dhcp] PASS: IP "); ipdots(our_ip);
+    puts_(", gateway "); ipdots(gw_ip); putc_('\n');
+    return 0;
+}
+
+/* ---- ARP, as net.c:356 --------------------------------------------------- */
+static int run_arp(void) {
+    uint8_t bcast[6] = {0xFF,0xFF,0xFF,0xFF,0xFF,0xFF};
+    uint8_t payload[28], frame[60];
+    payload[0] = 0; payload[1] = 1;               /* hw type 1 */
+    payload[2] = 0x08; payload[3] = 0x00;         /* proto 0x0800 */
+    payload[4] = 6; payload[5] = 4;
+    payload[6] = 0; payload[7] = 1;               /* opcode: request */
+    for (int i = 0; i < 6; i++) payload[8 + i] = our_mac[i];
+    put_be32(payload + 14, our_ip);
+    for (int i = 0; i < 6; i++) payload[14 + 6 + i] = 0;
+    put_be32(payload + 24, gw_ip);
+    uint32_t len = eth_build(frame, bcast, 0x0806, payload, 28);
+    if (nic_send(frame, len) < 0) {
+        puts_("[net] ARP request TX failed\n"); return -1;
+    }
+    puts_("[net] ARP request sent for "); ipdots(gw_ip); putc_('\n');
+
+    uint8_t rbuf[2048];
+    uint32_t n = nic_recv(rbuf, sizeof rbuf);
+    if (!n) { puts_("[net] ARP timeout\n"); return -1; }
+    if (n < 14 + 28) { puts_("[net] ARP reply too short\n"); return -1; }
+    if (rbuf[12] != 0x08 || rbuf[13] != 0x06) {
+        puts_("[net] ARP: unexpected ethertype\n"); return -1;
+    }
+    if (rbuf[20] != 0 || rbuf[21] != 2) {
+        puts_("[net] ARP: opcode is not a reply\n"); return -1;
+    }
+    for (int i = 0; i < 6; i++) gw_mac[i] = rbuf[22 + i];
+    puts_("[net] ARP reply: gateway is "); macdots(gw_mac); putc_('\n');
+    return 0;
+}
+
+/* ---- ICMP echo, as net.c:476 -------------------------------------------- */
+static int run_ping(void) {
+    uint8_t pkt[14 + 20 + 8 + 32];
+    uint8_t *icmp = pkt + 34;
+    for (int i = 0; i < 32; i++) icmp[8 + i] = (uint8_t)(i + 0x41);
+    icmp[0] = 8; icmp[1] = 0; icmp[2] = 0; icmp[3] = 0;
+    icmp[4] = 0x12; icmp[5] = 0x34;               /* ident 0x1234 */
+    icmp[6] = 0; icmp[7] = 1;                     /* seq 1 */
+    uint16_t cs = checksum(icmp, 40);
+    icmp[2] = (uint8_t)(cs >> 8); icmp[3] = (uint8_t)cs;
+    ip_build(pkt + 14, 1, our_ip, gw_ip, icmp, 40, 1);
+    for (int i = 0; i < 6; i++) { pkt[i] = gw_mac[i]; pkt[6 + i] = our_mac[i]; }
+    pkt[12] = 0x08; pkt[13] = 0x00;
+    if (nic_send(pkt, sizeof pkt) < 0) {
+        puts_("[net] ICMP echo request TX failed\n"); return -1;
+    }
+    puts_("[net] ICMP echo request sent to "); ipdots(gw_ip); putc_('\n');
+
+    uint8_t rbuf[2048];
+    uint32_t n = nic_recv(rbuf, sizeof rbuf);
+    if (!n) { puts_("[net] ICMP echo reply timeout\n"); return -1; }
+    if (n < 14 + 20 + 8) { puts_("[net] ICMP reply too short\n"); return -1; }
+    if (rbuf[12] != 0x08 || rbuf[13] != 0x00) {
+        puts_("[net] ICMP: unexpected ethertype\n"); return -1;
+    }
+    if (rbuf[14 + 9] != 1) { puts_("[net] ICMP: protocol is not 1\n"); return -1; }
+    if (rbuf[34] != 0) { puts_("[net] ICMP: type is not echo reply\n"); return -1; }
+    uint16_t seq = (uint16_t)((rbuf[40] << 8) | rbuf[41]);
+    puts_("[net] ICMP echo reply received from "); ipdots(gw_ip);
+    puts_(" (seq "); dec(seq); puts_(")\n");
+    /* The guest stops at `type == 0`; this payload goes the extra step the
+     * plan's "payload verified" wording asks for, and reports it separately. */
+    int same = 1;
+    for (int i = 0; i < 32; i++)
+        if (rbuf[42 + i] != (uint8_t)(i + 0x41)) same = 0;
+    uint16_t rid = (uint16_t)((rbuf[38] << 8) | rbuf[39]);
+    puts_("[net] ICMP payload ");
+    puts_(same && rid == 0x1234 && seq == 1 ? "verified (ident+seq+32 bytes)\n"
+                                            : "MISMATCH\n");
+    return same ? 0 : -1;
+}
+
+/* ---- entry --------------------------------------------------------------- */
+__attribute__((section(".text._start")))
+void _start(void) {
+    __asm__ volatile("cli");
+    nic_init();
+
+    int fail = 0;
+    if (run_dhcp() != 0) {
+        puts_("[net] FAIL: no DHCP lease\n");
+        fail = 1;
+    }
+    if (!fail && run_arp() != 0) {
+        puts_("[net] FAIL: gateway ARP unanswered\n");
+        fail = 1;
+    }
+    if (!fail && run_ping() != 0) {
+        puts_("[net] FAIL: no ICMP echo reply\n");
+        fail = 1;
+    }
+    if (!fail) {
+        puts_("[net] PASS: lease + ARP + echo reply (payload verified)\n");
+    }
+    puts_(fail ? "N2FAIL\n" : "N2OK\n");
+    for (;;) { __asm__ volatile("hlt"); }
+}
diff --git a/tests/nic_net.ld b/tests/nic_net.ld
new file mode 100644
index 0000000..0fc7277
--- /dev/null
+++ b/tests/nic_net.ld
@@ -0,0 +1,33 @@
+/* tests/nic_net.ld -- NET N2 wire payload link script.
+ *
+ * Same contract as tests/kload_fixture.ld, which is the K1 artifact: link at
+ * the real AuraLite VMA (KLOAD_KERNEL_VMA + 1 MiB) so kload_boot()'s
+ * segment-math path is exercised faithfully rather than around a friendlier
+ * address, and keep p_paddr == p_vaddr (the GNU ld ET_EXEC default) because
+ * kload_boot() validates exactly that.
+ *
+ * Why this transport and not the firmware one N1 used: the firmware's USB
+ * mass-storage loader reads ONE 512-byte block off LBA 0, and its long-mode
+ * map only covers 0x100000..0x1FFFFF of RAM (PD[0] = 0x19B is a 2 MiB page --
+ * measured in N1).  A DHCP + ARP + ICMP client with two descriptor rings does
+ * not fit in either budget.  kload_boot() gives a freestanding C payload a
+ * 4 GiB identity map plus the HHDM, entered in long mode with paging on.
+ */
+OUTPUT_FORMAT("elf64-x86-64")
+OUTPUT_ARCH(i386:x86-64)
+ENTRY(_start)
+
+SECTIONS
+{
+    . = 0xFFFFFFFF80100000;
+
+    .text : {
+        *(.text._start)   /* _start must lead: do not rely on traversal order */
+        *(.text*)
+    }
+    . = ALIGN(0x1000);
+    .rodata : { *(.rodata*) }
+    . = ALIGN(0x1000);
+    .data : { *(.data*) *(.got*) }
+    .bss : { *(.bss*) *(COMMON) }
+}
diff --git a/tests/test_tap_responder.py b/tests/test_tap_responder.py
new file mode 100755
index 0000000..884a4f3
--- /dev/null
+++ b/tests/test_tap_responder.py
@@ -0,0 +1,481 @@
+#!/usr/bin/env python3
+"""tests/test_tap_responder.py -- NET N2 protocol vectors for the responder.
+
+The wire lane (`tests/integration/n2_responder.sh`) proves the responder works
+against a real guest through the real socket, but it cannot say *why* a reply
+was accepted.  These vectors close that gap: they rebuild the guest's own
+request frames byte for byte from AuraLite-OS@0ed0d29 `kernel/net/net.c`, feed
+them to `tools/tap_responder.Responder`, and then accept or reject the reply
+using **the guest's filters ported verbatim** -- same comparisons, same order,
+same minimum lengths.  So a reply that passes here is a reply the frozen guest
+would consume, and the constants that matter (ports 67/68, options 1/3/6/53/54,
+`yiaddr`, `xid` echo, `opcode == 2`, `icmp.type == 0`) are each pinned by an
+assertion rather than implied by a working run.
+
+Also pinned: the RFC 1071 checksums (the guest computes them with
+`checksum()` at net.c:171 and a wrong one is exactly the class of bug that
+would pass a lenient peer), the 60-byte minimum frame pad the guest itself
+applies in `net_eth_send`, and the `--drop` lever the negative control uses.
+
+Run: python3 tests/test_tap_responder.py   (RC=0 = all passed)
+"""
+import os
+import struct
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)),
+                                "..", "tools"))
+import tap_responder as R  # noqa: E402
+
+FAILED = []
+
+
+def check(cond, label):
+    if cond:
+        print("ok   %s" % label)
+    else:
+        print("FAIL %s" % label)
+        FAILED.append(label)
+
+
+# ---------------------------------------------------------------------------
+# The guest's side, rebuilt from kernel/net/net.c (0ed0d29).
+# ---------------------------------------------------------------------------
+OUR_MAC = bytes([0x52, 0x54, 0x00, 0x12, 0x34, 0x56])   # RAL/RAH preload (N0)
+BCAST_MAC = b"\xff" * 6
+BCAST_IP = b"\xff\xff\xff\xff"
+
+
+def g_checksum(data: bytes) -> int:
+    """net.c:171 `checksum()`: 16-bit BE words, carries folded, complemented."""
+    total = 0
+    i = 0
+    n = len(data)
+    while i + 1 < n:
+        total += (data[i] << 8) | data[i + 1]
+        i += 2
+    if i < n:                       # odd tail: the guest's loop adds the byte
+        total += data[i]
+    while total >> 16:
+        total = (total & 0xFFFF) + (total >> 16)
+    return (~total) & 0xFFFF
+
+
+def g_eth(payload: bytes, ethertype: int, dst: bytes = BCAST_MAC) -> bytes:
+    """net.c:293 `net_eth_send`: src = our MAC, ethertype BE, pad to 60."""
+    frame = dst + OUR_MAC + struct.pack("!H", ethertype) + payload
+    if len(frame) < 60:
+        frame += b"\x00" * (60 - len(frame))
+    return frame
+
+
+def g_ipv4(proto: int, src: bytes, dst: bytes, body: bytes, ident: int) -> bytes:
+    """net.c's ipv4_hdr builder: v4/ihl5, tos 0, flags_frag 0, ttl 64."""
+    hdr = struct.pack("!BBHHHBBH", 0x45, 0, 20 + len(body), ident, 0, 64,
+                      proto, 0) + src + dst
+    return hdr[:10] + struct.pack("!H", g_checksum(hdr)) + hdr[12:] + body
+
+
+def g_dhcp_option(buf: bytearray, code: int, data: bytes) -> None:
+    """net.c:764 `dhcp_add_option` (END carries no length byte)."""
+    buf.append(code)
+    if code != 255:
+        buf.append(len(data))
+        buf += data
+
+
+def g_dhcp_frame(msgtype: int, xid: int, extra=()) -> bytes:
+    """net.c:801 net_dhcp's DISCOVER / REQUEST builder, byte for byte:
+    236-byte fixed part + options + END, over UDP 68->67 checksum 0, over IP
+    0.0.0.0 -> 255.255.255.255 ident 0x1234/0x1235, over a broadcast frame."""
+    body = bytearray(236)
+    body[0] = 1                                  # BOOTREQUEST
+    body[1] = 1                                  # htype = Ethernet
+    body[2] = 6                                  # hlen
+    struct.pack_into("!I", body, 4, xid)
+    struct.pack_into("!H", body, 10, 0x8000)     # flags: broadcast requested
+    body[28:34] = OUR_MAC                        # chaddr
+    struct.pack_into("!I", body, 232, 0x63825363)  # magic cookie
+
+    opts = bytearray()
+    g_dhcp_option(opts, 53, bytes([msgtype]))
+    if msgtype == 1:                             # DISCOVER: parameter list
+        g_dhcp_option(opts, 55, bytes([1, 3, 6]))
+    for code, data in extra:
+        g_dhcp_option(opts, code, data)
+    g_dhcp_option(opts, 255, b"")
+
+    udp_len = 8 + 236 + len(opts)
+    udp = struct.pack("!HHHH", 68, 67, udp_len, 0) + bytes(body) + bytes(opts)
+    ip = g_ipv4(17, b"\x00\x00\x00\x00", BCAST_IP, udp,
+                0x1234 if msgtype == 1 else 0x1235)
+    return g_eth(ip, 0x0800)
+
+
+def g_arp_frame(target_ip: bytes) -> bytes:
+    """net.c:415 net_arp_resolve's request: broadcast, sender = us."""
+    payload = struct.pack("!HHBBH", 1, 0x0800, 6, 4, 1)
+    payload += OUR_MAC + R.ip4(R.GUEST_IP) + b"\x00" * 6 + target_ip
+    return g_eth(payload, 0x0806)
+
+
+def g_icmp_frame(target_ip: bytes, dst_mac: bytes) -> bytes:
+    """net.c:476 net_ping: ident 0x1234, seq 1, payload 0x41..0x60 (32 B)."""
+    data = bytes((i + 0x41) & 0xFF for i in range(32))
+    icmp = struct.pack("!BBHHH", 8, 0, 0, 0x1234, 1) + data
+    icmp = icmp[:2] + struct.pack("!H", g_checksum(icmp)) + icmp[4:]
+    ip = g_ipv4(1, R.ip4(R.GUEST_IP), target_ip, icmp, 1)
+    return g_eth(ip, 0x0800, dst=dst_mac)
+
+
+# ---------------------------------------------------------------------------
+# The guest's accept filters, ported from net.c.  A reply passes only if the
+# frozen kernel's own comparisons would pass.
+# ---------------------------------------------------------------------------
+
+def guest_accepts_arp_reply(frame: bytes):
+    """net.c:441-465 (local-subnet path)."""
+    if len(frame) < 14 + 28:
+        return False, "too short (%d)" % len(frame)
+    if struct.unpack("!H", frame[12:14])[0] != 0x0806:
+        return False, "ethertype"
+    if struct.unpack("!H", frame[14 + 6:14 + 8])[0] != 2:      # opcode
+        return False, "opcode != ARP_REPLY"
+    return True, frame[22:28]                                   # sender_mac
+
+
+def guest_accepts_dhcp_reply(frame: bytes, want_msgtype: int, xid: int):
+    """net.c:902-935 (OFFER) and 1046-1075 (ACK).  Same gates, in order."""
+    if len(frame) < 14 + 20 + 8 + 236:
+        return False, "too short (%d)" % len(frame)
+    if struct.unpack("!H", frame[12:14])[0] != 0x0800:
+        return False, "ethertype"
+    if frame[14 + 9] != 17:
+        return False, "ip.protocol != UDP"
+    sport, dport = struct.unpack("!HH", frame[34:38])
+    if sport != 67:
+        return False, "udp.src != 67"
+    if dport != 68:
+        return False, "udp.dst != 68"
+    dhcp = frame[42:]
+    opts_len = len(frame) - (14 + 20 + 8 + 236)
+    if opts_len < 4:
+        return False, "opts_len < 4"
+    mt = R.dhcp_find_option(dhcp[236:], 53)
+    if not mt or len(mt) != 1:
+        return False, "option 53 missing/short"
+    if want_msgtype == 5 and struct.unpack("!I", dhcp[4:8])[0] != xid:
+        return False, "xid not echoed"          # the ACK path checks xid
+    if mt[0] != want_msgtype:
+        return False, "message type %d != %d" % (mt[0], want_msgtype)
+    return True, dhcp
+
+
+def guest_accepts_icmp_reply(frame: bytes):
+    """net.c:534-556."""
+    if len(frame) < 14 + 20 + 8:
+        return False, "too short (%d)" % len(frame)
+    if struct.unpack("!H", frame[12:14])[0] != 0x0800:
+        return False, "ethertype"
+    if frame[14 + 9] != 1:
+        return False, "ip.protocol != ICMP"
+    if frame[34] != 0:
+        return False, "icmp.type != ECHO_REPLY"
+    return True, frame
+
+
+# ---------------------------------------------------------------------------
+# Vectors
+# ---------------------------------------------------------------------------
+
+def test_frames_match_the_guest_builder():
+    """Sanity on the test's own side: the frames it feeds are what net.c
+    builds, including the pad and the header checksums.  Without this the
+    vectors below could be passing against a request no guest ever sends."""
+    d = g_dhcp_frame(1, 0x12345678)
+    # 14 eth + 20 ip + 8 udp + 236 dhcp fixed + options 53(3) 55(5) END(1)
+    check(len(d) == 14 + 20 + 8 + 236 + 3 + 5 + 1,
+          "DISCOVER frame length %d (236 fixed + 53/55/END)" % len(d))
+    ip = d[14:34]
+    check(g_checksum(ip) == 0, "DISCOVER IP header checksum verifies to 0")
+    check(struct.unpack("!H", d[40:42])[0] == 0,
+          "DISCOVER UDP checksum is 0 (what the guest sends)")
+    check(struct.unpack("!HH", d[34:38]) == (68, 67),
+          "DISCOVER is UDP 68 -> 67 (net.c:866)")
+    arp = g_arp_frame(R.ip4(R.GW_IP))
+    check(len(arp) == 60, "ARP request padded to the 60-byte minimum (%d)"
+          % len(arp))
+    ic = g_icmp_frame(R.ip4(R.GW_IP), bytes(6))
+    check(len(ic) == 14 + 20 + 8 + 32, "ICMP request is 74 bytes")
+    check(g_checksum(ic[34:34 + 40]) == 0,
+          "ICMP request checksum verifies to 0")
+    check(ic[42:74] == bytes((i + 0x41) for i in range(32)),
+          "ICMP request payload is 0x41..0x60 as net.c:481 builds it")
+
+
+def test_arp_reply():
+    r = R.Responder(R.mac(R.GW_MAC_DEFAULT), quiet=True)
+    reply = r.handle(g_arp_frame(R.ip4(R.GW_IP)))
+    check(reply is not None, "ARP request for the gateway gets a reply")
+    ok, why = guest_accepts_arp_reply(reply)
+    check(ok, "ARP reply passes the guest's filter (%s)" % why)
+    if ok:
+        check(why == R.mac(R.GW_MAC_DEFAULT),
+              "ARP reply sender_mac is the gateway MAC %s" % why)
+        check(reply[14 + 24:14 + 28] == R.ip4(R.GUEST_IP),
+              "ARP reply target_ip is the requester's address")
+        check(reply[0:6] == BCAST_MAC,
+              "ARP reply is broadcast (slirp's shape; the guest never checks)")
+        check(len(reply) == 60, "ARP reply padded to 60 bytes (%d)" % len(reply))
+    # An ARP request for something else is still answered (slirp answers for
+    # the addresses it owns); a non-request is not.
+    req_only = bytearray(g_arp_frame(R.ip4(R.GW_IP)))
+    struct.pack_into("!H", req_only, 14 + 6, 2)       # opcode = reply
+    check(r.handle(bytes(req_only)) is None,
+          "an ARP *reply* from the guest is not answered (no loop)")
+
+
+def test_dhcp_discover_offer():
+    r = R.Responder(R.mac(R.GW_MAC_DEFAULT), quiet=True)
+    frame = g_dhcp_frame(1, 0x12345678)
+    reply = r.handle(frame)
+    check(reply is not None, "DISCOVER gets an OFFER")
+    ok, why = guest_accepts_dhcp_reply(reply, 2, 0)
+    check(ok, "OFFER passes the guest's filter (%s)" % why)
+    if not ok:
+        return
+    dhcp = why
+    check(dhcp[0] == 2, "OFFER op = BOOTREPLY")
+    check(dhcp[28:34] == OUR_MAC, "OFFER echoes chaddr")
+    check(struct.unpack("!I", dhcp[4:8])[0] == 0x12345678,
+          "OFFER echoes xid 0x12345678")
+    yiaddr = dhcp[16:20]
+    check(yiaddr == R.ip4(R.GUEST_IP),
+          "OFFER yiaddr = %s (the receipt the guest's own integration test "
+          "asserts)" % R.ipstr(yiaddr))
+    opts = dhcp[236:]
+    check(opts[0] == 53, "option 53 (message type) leads the list, as in slirp")
+    sid = R.dhcp_find_option(opts, 54)
+    check(sid == R.ip4(R.GW_IP),
+          "option 54 server id = %s (net.c:929 reads it)" % R.ipstr(sid))
+    sm = R.dhcp_find_option(opts, 1)
+    check(sm == bytes([255, 255, 255, 0]),
+          "option 1 subnet mask = 255.255.255.0 (net.c:933 -> subnet_mask, "
+          "which is what makes the gateway on-link)")
+    rtr = R.dhcp_find_option(opts, 3)
+    check(rtr == R.ip4(R.GW_IP),
+          "option 3 router = %s" % R.ipstr(rtr))
+    dns = R.dhcp_find_option(opts, 6)
+    check(dns == R.ip4(R.DNS_IP),
+          "option 6 DNS = %s (net.c:938 -> dns_set_servers)" % R.ipstr(dns))
+    lease = R.dhcp_find_option(opts, 51)
+    check(lease is not None and len(lease) == 4,
+          "option 51 lease time present (%s s)"
+          % (struct.unpack("!I", lease)[0] if lease else "?"))
+    check(opts[-1] == 255, "the option list ends with END (255)")
+    # The reply is L2+L3 broadcast: the client holds no address yet, which is
+    # the exact failure net.c:1010's comment names.
+    check(reply[0:6] == BCAST_MAC and reply[30:34] == BCAST_IP,
+          "OFFER is broadcast at L2 and L3 (a unicast ACK to an unconfigured "
+          "address is the measured WHPX failure mode)")
+    ip = reply[14:34]
+    check(g_checksum(ip) == 0, "OFFER IP header checksum verifies to 0")
+    total = struct.unpack("!H", ip[2:4])[0]
+    check(total == len(reply) - 14,
+          "OFFER ip.total_length %d == the %d bytes behind the Ethernet header"
+          % (total, len(reply) - 14))
+    ulen = struct.unpack("!H", reply[38:40])[0]
+    check(ulen == total - 20, "OFFER udp.length %d == total_length - 20" % ulen)
+
+
+def test_dhcp_request_ack():
+    r = R.Responder(R.mac(R.GW_MAC_DEFAULT), quiet=True)
+    xid = 0x12345678
+    offer = r.handle(g_dhcp_frame(1, xid))
+    ok, dhcp = guest_accepts_dhcp_reply(offer, 2, 0)
+    check(ok, "OFFER accepted before the REQUEST is built")
+    # The guest's REQUEST carries option 50 (the offered address) and 54 (the
+    # server id it read), both big-endian on the wire.
+    req = g_dhcp_frame(3, xid, extra=((50, dhcp[16:20]),
+                                      (54, R.ip4(R.GW_IP))))
+    reply = r.handle(req)
+    check(reply is not None, "REQUEST gets an ACK")
+    ok, why = guest_accepts_dhcp_reply(reply, 5, xid)
+    check(ok, "ACK passes the guest's filter, xid included (%s)" % why)
+    if ok:
+        ack = why
+        check(ack[16:20] == R.ip4(R.GUEST_IP),
+              "ACK yiaddr = 10.0.2.15 -> our_ip")
+        rtr = R.dhcp_find_option(ack[236:], 3)
+        check(rtr == R.ip4(R.GW_IP),
+              "ACK option 3 = 10.0.2.2 -> gateway_ip (net.c:1073)")
+    # A mismatched xid must be ignored by the *guest*, and the responder must
+    # still answer the xid it was given (it echoes, never invents).
+    bad = r.handle(g_dhcp_frame(3, 0xDEADBEEF, extra=((50, dhcp[16:20]),)))
+    ok2, _ = guest_accepts_dhcp_reply(bad, 5, xid)
+    check(not ok2, "an ACK to a different xid is rejected by the guest filter")
+    ok3, _ = guest_accepts_dhcp_reply(bad, 5, 0xDEADBEEF)
+    check(ok3, "the responder echoes whatever xid it was given (no lease state)")
+
+
+def test_icmp_echo_reply():
+    gw_mac = R.mac(R.GW_MAC_DEFAULT)
+    r = R.Responder(gw_mac, quiet=True)
+    req = g_icmp_frame(R.ip4(R.GW_IP), gw_mac)
+    reply = r.handle(req)
+    check(reply is not None, "ICMP echo request gets a reply")
+    ok, why = guest_accepts_icmp_reply(reply)
+    check(ok, "echo reply passes the guest's filter (%s)" % why)
+    if not ok:
+        return
+    ricmp = reply[34:]
+    check(ricmp[0] == 0 and ricmp[1] == 0, "echo reply type 0 code 0")
+    check(struct.unpack("!H", ricmp[4:6])[0] == 0x1234,
+          "echo reply keeps ident 0x1234")
+    check(struct.unpack("!H", ricmp[6:8])[0] == 1, "echo reply keeps seq 1")
+    check(ricmp[8:40] == bytes((i + 0x41) for i in range(32)),
+          "echo reply returns the 32 payload bytes unchanged (0x41..0x60)")
+    check(g_checksum(ricmp[:40]) == 0,
+          "echo reply ICMP checksum verifies to 0")
+    rip = reply[14:34]
+    check(g_checksum(rip) == 0, "echo reply IP header checksum verifies to 0")
+    check(rip[12:16] == R.ip4(R.GW_IP) and rip[16:20] == R.ip4(R.GUEST_IP),
+          "echo reply swapped src/dst (10.0.2.2 -> 10.0.2.15)")
+    check(reply[6:12] == gw_mac and reply[0:6] == OUR_MAC,
+          "echo reply is unicast to us from the gateway MAC")
+    check(struct.unpack("!H", rip[4:6])[0] == 1,
+          "echo reply keeps the request's ip.ident (1)")
+
+
+def test_determinism_and_the_drop_lever():
+    a = R.Responder(R.mac(R.GW_MAC_DEFAULT), quiet=True)
+    b = R.Responder(R.mac(R.GW_MAC_DEFAULT), quiet=True)
+    frames = [g_arp_frame(R.ip4(R.GW_IP)),
+              g_dhcp_frame(1, 0x12345678),
+              g_dhcp_frame(3, 0x12345678, extra=((50, R.ip4(R.GUEST_IP)),)),
+              g_icmp_frame(R.ip4(R.GW_IP), R.mac(R.GW_MAC_DEFAULT))]
+    check(all(a.handle(f) == b.handle(f) for f in frames),
+          "two responder instances answer identically (no hidden state)")
+    check(all(a.handle(f) == a.handle(f) for f in frames),
+          "replaying the same frame answers identically (idempotent)")
+
+    silent = R.Responder(R.mac(R.GW_MAC_DEFAULT), quiet=True,
+                         drop="arp,icmp,dhcp")
+    check(all(silent.handle(f) is None for f in frames),
+          "--drop=arp,icmp,dhcp withholds every reply (the NC lever)")
+    only_arp = R.Responder(R.mac(R.GW_MAC_DEFAULT), quiet=True, drop="icmp,dhcp")
+    check(only_arp.handle(frames[0]) is not None and
+          only_arp.handle(frames[3]) is None,
+          "--drop is per-protocol, not all-or-nothing")
+
+
+def test_junk_does_not_answer():
+    r = R.Responder(R.mac(R.GW_MAC_DEFAULT), quiet=True)
+    junk = [b"", b"\x00" * 13, b"\xff" * 14,
+            g_eth(b"\x00" * 20, 0x86DD),                 # IPv6: not N2 scope
+            g_eth(struct.pack("!BBHHHBBH", 0x45, 0, 40, 0, 0, 64, 6, 0)
+                  + b"\x00" * 32, 0x0800),               # TCP: ignored
+            g_dhcp_frame(1, 1)[:60]]                     # truncated DHCP
+    check(all(r.handle(f) is None for f in junk),
+          "junk / out-of-scope frames get no reply (nothing invented)")
+
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+def test_reply_goes_to_the_peer_not_to_the_endpoint():
+    """Regression vector for the bug the first N2 wire run exposed.
+
+    The responder *binds* the endpoint the emulator *connects to* (see
+    src/devices.c: `--tap=` does a UDP connect).  So `sendto(reply,
+    (host, port))` sends the reply to the responder's own socket and the
+    emulator never sees it -- measured as a wire log full of correct OFFERs
+    next to a guest printing `[dhcp] FAIL: no OFFER received`.  The reply has
+    to go to the peer address `recvfrom` reported.
+
+    Protocol vectors above cannot see this (they call `Responder.handle`
+    directly), so it gets its own socket-level vector: run the real tool as a
+    subprocess, send one DISCOVER from a *connected* client socket, and assert
+    the OFFER arrives on that client -- and on nothing else.
+    """
+    import socket
+    import subprocess
+    import time
+
+    endpoint = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+    endpoint.bind(("127.0.0.1", 0))
+    port = endpoint.getsockname()[1]
+    endpoint.close()                       # freed for the responder to bind
+
+    sentinel = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+    sentinel.bind(("127.0.0.1", 0))        # must stay silent for the whole run
+    sentinel.settimeout(0.5)
+    sentinel_port = sentinel.getsockname()[1]
+
+    proc = subprocess.Popen(
+        [sys.executable, os.path.join(ROOT, "tools", "tap_responder.py"),
+         "--port", str(port), "--timeout", "5", "--quiet"],
+        stdout=subprocess.DEVNULL, stderr=subprocess.STDOUT)
+
+    client = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+    client.connect(("127.0.0.1", port))    # exactly what the emulator does
+    client.settimeout(4.0)
+    reply = b""
+    try:
+        deadline = time.monotonic() + 4.0
+        while time.monotonic() < deadline:
+            try:
+                sentinel.recvfrom(65536)
+            except socket.timeout:
+                pass
+            client.send(g_dhcp_frame(1, 0x12345678))
+            try:
+                reply = client.recv(65536)
+                break
+            except socket.timeout:
+                continue
+    finally:
+        client.close()
+        proc.terminate()
+        proc.wait(timeout=10)
+
+    check(bool(reply), "a connected client receives the OFFER (not only the "
+                       "responder's own socket)")
+    check(len(reply) > 42 and reply[14 + 20 + 8 + 0] == 2,
+          "what the client received is a BOOTREPLY (%d bytes)" % len(reply))
+    opts = reply[14 + 20 + 8 + 236:]          # DHCP fixed part ends here
+    check(len(opts) >= 3 and opts[0] == 53 and opts[2] == 2,
+          "the client's reply is an OFFER (option 53 = 2)")
+    silent = True
+    try:
+        sentinel.settimeout(0.2)
+        sentinel.recvfrom(65536)
+        silent = False
+    except socket.timeout:
+        pass
+    sentinel.close()
+    check(silent, "no reply leaked to any other socket on the host (port %d)"
+          % sentinel_port)
+
+
+def main():
+    for fn in (test_frames_match_the_guest_builder,
+               test_arp_reply,
+               test_dhcp_discover_offer,
+               test_dhcp_request_ack,
+               test_icmp_echo_reply,
+               test_reply_goes_to_the_peer_not_to_the_endpoint,
+               test_determinism_and_the_drop_lever,
+               test_junk_does_not_answer):
+        print("--- %s" % fn.__name__)
+        fn()
+    if FAILED:
+        print("test-tap-responder: %d FAILURE(S): %s"
+              % (len(FAILED), ", ".join(FAILED)))
+        return 1
+    print("test-tap-responder: all tests passed")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
